        function triggerVoiceInput() {

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

            if (!SpeechRecognition) {

                alert("La reconnaissance vocale n'est pas supportée par ce navigateur (essaie Google Chrome ou Microsoft Edge).");

                return;

            }



            if (isAudioRecording) {

                if (speechRecognizer) speechRecognizer.stop();

                return;

            }



            speechRecognizer = new SpeechRecognition();

            speechRecognizer.lang = 'fr-FR';

            speechRecognizer.continuous = false;

            speechRecognizer.interimResults = true;



            const micBtn = document.getElementById('mic-btn');

            const input = document.getElementById('user-input');



            speechRecognizer.onstart = () => {

                isAudioRecording = true;

                if (micBtn) micBtn.classList.add('text-rose-500', 'animate-pulse');

                if (input) input.placeholder = "🎙️ Parle maintenant... j'écoute...";

            };



            speechRecognizer.onresult = (event) => {

                const transcript = Array.from(event.results).map(r => r[0].transcript).join('');

                if (input) input.value = transcript;

            };



            speechRecognizer.onend = () => {

                isAudioRecording = false;

                if (micBtn) micBtn.classList.remove('text-rose-500', 'animate-pulse');

                if (input) {

                    input.placeholder = "Écrire un message à HoL AI...";

                    if (input.value.trim().length > 0) {

                        handleChatSubmit(null);

                    }

                }

            };



            speechRecognizer.onerror = (e) => {

                console.warn(e);

                isAudioRecording = false;

                if (micBtn) micBtn.classList.remove('text-rose-500', 'animate-pulse');

            };



            speechRecognizer.start();

        }




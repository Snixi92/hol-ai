        // =========================================================================

        // 6. DÉTECTEUR DE DOUBLE-CLAP DES MAINS (Règles strictes 06-guides d'Anthony)

        // =========================================================================

        let clapAudioCtx = null;

        let clapMediaStream = null;

        let clapAnalyserNode = null;

        let isClapActive = false;

        let firstClapTimestamp = 0;

        let detectedClapHits = 0;

        let applauseRejectionTimer = null;

        let clapCooldownActive = false;



        async function initClapDetector() {

            try {

                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {

                    console.log("Microphone non supporté sur ce navigateur.");

                    updateClapBadgeUI(false);

                    return;

                }



                clapMediaStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });

                clapAudioCtx = new (window.AudioContext || window.webkitAudioContext)();

                const source = clapAudioCtx.createMediaStreamSource(clapMediaStream);

                clapAnalyserNode = clapAudioCtx.createAnalyser();

                clapAnalyserNode.fftSize = 512;

                source.connect(clapAnalyserNode);



                isClapActive = true;

                updateClapBadgeUI(true);

                runClapDetectionLoop();

            } catch (err) {

                console.log("Accès microphone non accordé (activation manuelle par bouton) :", err);

                updateClapBadgeUI(false);

            }

        }



        function toggleClapListening() {


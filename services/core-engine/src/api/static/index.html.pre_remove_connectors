        // --- ENVOI DE MESSAGES & STREAMING ---

        async function handleChatSubmit(e) {

            if (e) e.preventDefault();

            const input = document.getElementById('user-input');

            const message = input.value.trim();

            if (!message && !pendingAttachmentData) return;



            input.value = '';

            const attachedImg = pendingAttachmentData;

            cancelAttachment();



            // 1. Ajouter le message utilisateur dans l'interface

            appendUserMessage(message, attachedImg);

            chatConversationHistory.push({ role: 'user', content: message });



            // 2. Afficher l'indicateur de réflexion avec statut dynamique (comme Gemini / Claude / ChatGPT)

            const typingId = showTypingIndicator(message);

            const progressiveTimer = startProgressiveThinking(typingId, message);



            let streamedSuccess = false;

            try {

                const response = await fetch('/api/chat/stream', {

                    method: 'POST',

                    headers: { 'Content-Type': 'application/json' },

                    body: JSON.stringify({

                        message: message,

                        session_id: currentSessionId,

                        user_id: 'user_main',
                        thinking_level: currentThinkingLevel

                    })

                });



                if (response.ok && response.body) {

                    const reader = response.body.getReader();

                    const decoder = new TextDecoder();

                    let buffer = '';



                    while (true) {

                        const { value, done } = await reader.read();

                        if (done) break;

                        buffer += decoder.decode(value, { stream: true });



                        const lines = buffer.split('\n');

                        buffer = lines.pop();



                        for (const line of lines) {

                            const trimmed = line.trim();

                            if (!trimmed.startsWith('data:')) continue;

                            const jsonStr = trimmed.slice(5).trim();

                            if (!jsonStr) continue;



                            try {

                                const event = JSON.parse(jsonStr);

                                if (event.type === 'status') {

                                    clearInterval(progressiveTimer);

                                    updateTypingIndicator(typingId, event.text || event.status, event.step);

                                } else if (event.type === 'complete') {

                                    clearInterval(progressiveTimer);

                                    removeTypingIndicator(typingId);

                                    streamedSuccess = true;



                                    if (event.session_id) {

                                        currentSessionId = event.session_id;

                                        localStorage.setItem('musex_session_id', currentSessionId);

                                    }



                                    // Affichage en streaming progressif mot par mot

                                    appendAssistantMessage(event.reply, event.cards || [], event.thoughts, event.thinking_level);

                                    chatConversationHistory.push({ role: 'assistant', content: event.reply });

                                    break;

                                }

                            } catch (e) {

                                console.warn("Erreur parsing SSE event:", e);

                            }

                        }

                        if (streamedSuccess) break;

                    }

                }

            } catch (streamErr) {

                console.warn("Échec streaming SSE, tentative fallback sur /api/chat :", streamErr);

            }



            // Fallback classique si le streaming SSE n'a pas répondu

            if (!streamedSuccess) {

                try {

                    const response = await fetch('/api/chat', {

                        method: 'POST',

                        headers: { 'Content-Type': 'application/json' },

                        body: JSON.stringify({

                            message: message,

                            session_id: currentSessionId,

                            user_id: 'user_main',
                        thinking_level: currentThinkingLevel

                        })

                    });



                    const data = await response.json();

                    clearInterval(progressiveTimer);

                    removeTypingIndicator(typingId);



                    if (data.session_id) {

                        currentSessionId = data.session_id;

                        localStorage.setItem('musex_session_id', currentSessionId);

                    }



                    // Affichage en streaming progressif mot par mot

                    appendAssistantMessage(data.reply, data.cards || [], data.thoughts, data.thinking_level);

                    chatConversationHistory.push({ role: 'assistant', content: data.reply });



                } catch (err) {

                    clearInterval(progressiveTimer);

                    removeTypingIndicator(typingId);

                    appendAssistantMessage("Désolée, une erreur réseau est survenue avec le serveur. Réessaie dans un instant.", []);

                }

            }

        }




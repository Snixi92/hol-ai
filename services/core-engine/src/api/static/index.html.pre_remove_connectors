            if (!banner || !textEl) return;

            banner.classList.remove('hidden', 'bg-emerald-500/20', 'border-emerald-500/40', 'text-emerald-300', 'bg-rose-500/20', 'border-rose-500/40', 'text-rose-300', 'bg-amber-500/20', 'border-amber-500/40', 'text-amber-300');
            
            if (isSuccess) {
                banner.classList.add('bg-emerald-500/20', 'border-emerald-500/40', 'text-emerald-300');

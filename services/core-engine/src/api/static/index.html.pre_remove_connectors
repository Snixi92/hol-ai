        };

        function setChatBackground(bgId, customUrl = '') {
            currentChatBackground = bgId;
            if (bgId === 'custom' && customUrl) {
                currentCustomBgUrl = customUrl;
                localStorage.setItem('hol_chat_background_custom', customUrl);
            }
            localStorage.setItem('hol_chat_background', bgId);
            applySavedChatBackground();
            updateChatBgSettingsUI();
        }

        function applyCustomChatBackground() {
            const input = document.getElementById('custom-bg-input');
            const val = input ? input.value.trim() : '';
            if (!val) return;
            setChatBackground('custom', val);
            const status = document.getElementById('custom-bg-status');
            if (status) {
                status.innerText = 'Appliqué ✓';
                status.className = 'text-[9px] text-emerald-400 font-mono';
                setTimeout(() => { status.innerText = ''; }, 2500);
            }
        }

        function applyPresetSampleBg(url) {
            const input = document.getElementById('custom-bg-input');
            if (input) input.value = url;
            setChatBackground('custom', url);
            const status = document.getElementById('custom-bg-status');
            if (status) {
                status.innerText = 'Appliqué ✓';
                status.className = 'text-[9px] text-emerald-400 font-mono';
                setTimeout(() => { status.innerText = ''; }, 2500);
            }
        }

        function onCustomBgInputChanged() {
            const input = document.getElementById('custom-bg-input');
            const val = input ? input.value.trim() : '';
            const status = document.getElementById('custom-bg-status');
            if (!val) {
                if (status) status.innerText = '';
                return;
            }
            if (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('data:image/')) {
                if (status) {
                    status.innerText = 'URL détectée';
                    status.className = 'text-[9px] text-sky-400 font-mono';
                }
            }
        }

        function applySavedChatBackground() {
            const layer = document.getElementById('conversation-bg-layer');
            if (!layer) return;

            const isDark = document.documentElement.classList.contains('dark');
            const themeParam = isDark ? 'dark' : 'light';

            // 1. Shaders 21st.dev interactifs (WebGL / Three.js / Canvas)
            if (TWENTY_FIRST_MAP[currentChatBackground]) {
                layer.className = 'absolute inset-0 pointer-events-none transition-all duration-700 ease-out z-0 overflow-hidden';
                layer.style.backgroundImage = '';
                layer.style.backgroundColor = isDark ? '#08080a' : '#f5f5f7';

                const targetFile = TWENTY_FIRST_MAP[currentChatBackground];
                const targetSrc = `/backgrounds/${targetFile}?theme=${themeParam}`;

                let frame = document.getElementById('chat-bg-canvas-frame');
                if (!frame) {
                    frame = document.createElement('iframe');
                    frame.id = 'chat-bg-canvas-frame';
                    frame.className = 'w-full h-full border-0 absolute inset-0 pointer-events-none z-0 transition-opacity duration-500';
                    layer.appendChild(frame);
                }

                if (!frame.src.endsWith(targetFile) && !frame.src.includes(targetFile)) {
                    frame.src = targetSrc;
                } else if (frame.contentWindow) {
                    try {
                        frame.contentWindow.postMessage({ type: 'setTheme', theme: themeParam }, '*');
                    } catch(e) {}
                }

                // Couche d'ombrage protectrice (Apple HIG Text Legibility Scrim)
                let overlay = document.getElementById('chat-bg-scrim-layer');
                if (!overlay) {
                    overlay = document.createElement('div');
                    overlay.id = 'chat-bg-scrim-layer';
                    overlay.className = 'absolute inset-0 pointer-events-none z-0 transition-opacity duration-500';
                    layer.appendChild(overlay);
                }
                overlay.style.background = isDark 
                    ? 'radial-gradient(ellipse at 50% 50%, rgba(8, 8, 10, 0.35) 0%, rgba(8, 8, 10, 0.60) 100%)' 
                    : 'radial-gradient(ellipse at 50% 50%, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0.45) 100%)';
                return;
            }

            // 2. Nettoyage et extinction de l'iframe si un fond CSS/image est sélectionné
            const oldFrame = document.getElementById('chat-bg-canvas-frame');
            if (oldFrame) {
                oldFrame.src = 'about:blank';
                oldFrame.remove();
            }
            const oldOverlay = document.getElementById('chat-bg-scrim-layer');
            if (oldOverlay) oldOverlay.remove();

            // 3. Image ou URL personnalisée
            if (currentChatBackground === 'custom' && currentCustomBgUrl) {
                layer.className = 'absolute inset-0 pointer-events-none transition-all duration-700 ease-out z-0 bg-cover bg-center';
                const overlay = isDark 
                    ? 'linear-gradient(rgba(8, 8, 10, 0.74), rgba(8, 8, 10, 0.85))' 
                    : 'linear-gradient(rgba(245, 245, 247, 0.82), rgba(245, 245, 247, 0.90))';
                layer.style.backgroundImage = `${overlay}, url("${currentCustomBgUrl}")`;
                layer.style.backgroundSize = 'cover';
                layer.style.backgroundPosition = 'center';
                layer.style.backgroundRepeat = 'no-repeat';
                return;
            }

            // 4. Presets CSS natifs
            layer.className = 'absolute inset-0 pointer-events-none transition-all duration-700 ease-out z-0 bg-cover bg-center';
            layer.style.backgroundImage = '';
            layer.style.backgroundColor = '';
            if (currentChatBackground && currentChatBackground !== 'default') {
                layer.classList.add(`bg-preset-${currentChatBackground}`);
            } else {
                layer.classList.add('bg-preset-default');
            }
        }

        // Relais fluide des mouvements de souris vers les shaders 21st.dev
        var bgIframeThrottle = 0;
        document.addEventListener('mousemove', function(e) {
            const now = Date.now();
            if (now - bgIframeThrottle < 25) return;
            bgIframeThrottle = now;
            const frame = document.getElementById('chat-bg-canvas-frame');
            if (frame && frame.contentWindow) {
                try {
                    frame.contentWindow.postMessage({
                        type: 'mousemove',
                        clientX: e.clientX,

                        clientY: e.clientY
                    }, '*');
                } catch(e) {}
            }
        });



        // =========================================================================

        // MOTEUR AUDIO JARVIS : MUSIQUE CINÉMATIQUE, DUCKING & SYNTHÈSE VOCALE

        // =========================================================================

        let jarvisAudioCtx = null;

        let jarvisMusicGain = null;

        let jarvisOscillators = [];

        let isJarvisSpeaking = false;

        let jarvisSpeechSynth = window.speechSynthesis;

        let jarvisCurrentUtterance = null;

        let jarvisClockInterval = null;

        let visualizerInterval = null;



        // 1. Musique d'Intro Cinématique Héroïque (Générée à la volée en Web Audio API)

        function playCinematicMusic() {

            try {

                if (!jarvisAudioCtx) {

                    jarvisAudioCtx = new (window.AudioContext || window.webkitAudioContext)();

                }

                if (jarvisAudioCtx.state === 'suspended') {

                    jarvisAudioCtx.resume();

                }



                // Arrêter la musique précédente si elle jouait

                stopCinematicMusic();



                const now = jarvisAudioCtx.currentTime;

                jarvisMusicGain = jarvisAudioCtx.createGain();

                jarvisMusicGain.gain.setValueAtTime(0.001, now);

                // Montée progressive du volume (Fade in majestueux)

                jarvisMusicGain.gain.exponentialRampToValueAtTime(0.22, now + 1.2);

                jarvisMusicGain.connect(jarvisAudioCtx.destination);



                // Accord Cinématique Spatial Dm9 (D3, F3, A3, C4, E4)

                const freqs = [146.83, 174.61, 220.00, 261.63, 329.63];

                jarvisOscillators = freqs.map((freq, idx) => {

                    const osc = jarvisAudioCtx.createOscillator();

                    const oscGain = jarvisAudioCtx.createGain();

                    const filter = jarvisAudioCtx.createBiquadFilter();



                    osc.type = idx % 2 === 0 ? 'sine' : 'triangle';

                    osc.frequency.setValueAtTime(freq, now);



                    // Balayage doux du filtre passe-bas pour un son chaud et immersif

                    filter.type = 'lowpass';

                    filter.frequency.setValueAtTime(450 + idx * 120, now);

                    filter.Q.setValueAtTime(1.5, now);



                    oscGain.gain.setValueAtTime(0.06, now);



                    osc.connect(filter);

                    filter.connect(oscGain);

                    oscGain.connect(jarvisMusicGain);

                    osc.start(now);

                    return osc;

                });

            } catch (err) {

                console.warn("Musique Web Audio non initialisée :", err);

            }

        }



        // 2. Audio Ducking Automatique (Le volume baisse quand Jarvis parle, remonte à la fin)

        function setMusicDucking(isDucking) {

            if (!jarvisMusicGain || !jarvisAudioCtx) return;

            try {

                const now = jarvisAudioCtx.currentTime;

                jarvisMusicGain.gain.cancelScheduledValues(now);

                if (isDucking) {

                    // Baisse le volume de la musique à 0.04 en 0.3s

                    jarvisMusicGain.gain.linearRampToValueAtTime(0.04, now + 0.3);

                } else {

                    // Remonte doucement à 0.20

                    jarvisMusicGain.gain.linearRampToValueAtTime(0.20, now + 0.8);

                    // Fondu de sortie progressif au bout de 4 secondes

                    jarvisMusicGain.gain.linearRampToValueAtTime(0.001, now + 5.0);

                    setTimeout(stopCinematicMusic, 5200);

                }

            } catch (e) {}

        }



        function stopCinematicMusic() {

            if (jarvisOscillators.length > 0) {

                jarvisOscillators.forEach(osc => {

                    try { osc.stop(); osc.disconnect(); } catch (e) {}

                });

                jarvisOscillators = [];

            }

        }



        // 3. Déclenchement du Mode Jarvis Plein Écran (Double Clap ou Clic ou Espace)


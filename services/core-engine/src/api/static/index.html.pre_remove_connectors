                                badge.innerText = c.status === 'READY_FOR_SETUP' ? 'Prêt (Simu)' : 'À configurer';
                            }
                        }
                    });
                }
            } catch (e) {
                console.error("Erreur télémétrie connecteurs:", e);
            }

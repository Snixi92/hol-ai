        function setupCarouselKeyboardListeners() {
            window.addEventListener('keydown', function(e) {
                const settingsModal = document.getElementById('settings-modal');
                const panoModal = document.getElementById('hero-carousel-panoramic-modal');

                const isSettingsOpen = settingsModal && !settingsModal.classList.contains('hidden');
                const isPanoOpen = panoModal && !panoModal.classList.contains('hidden');

                if (isPanoOpen && e.key === 'Escape') {
                    closeHeroCarouselPanoramic();
                    return;
                }

                if (isSettingsOpen || isPanoOpen) {
                    if (e.key === 'ArrowRight') {
                        heroCarouselNext(e);
                    } else if (e.key === 'ArrowLeft') {
                        heroCarouselPrev(e);
                    }
                }
            });
        }

        function setupCarouselDragListeners() {
            ['hero-carousel-track-wrapper', 'panoramic-track-wrapper'].forEach(id => {
                const wrapper = document.getElementById(id);
                if (!wrapper) return;
                let startX = 0;
                let isDragging = false;

                wrapper.addEventListener('mousedown', e => {
                    isDragging = true;
                    startX = e.clientX;
                });

                wrapper.addEventListener('mouseup', e => {
                    if (!isDragging) return;
                    isDragging = false;
                    const diff = e.clientX - startX;
                    if (diff < -40) heroCarouselNext();
                    else if (diff > 40) heroCarouselPrev();
                });

                wrapper.addEventListener('touchstart', e => {
                    if (e.touches.length > 0) {
                        startX = e.touches[0].clientX;
                    }
                }, { passive: true });

                wrapper.addEventListener('touchend', e => {
                    if (e.changedTouches.length > 0) {
                        const diff = e.changedTouches[0].clientX - startX;
                        if (diff < -30) heroCarouselNext();
                        else if (diff > 30) heroCarouselPrev();
                    }
                }, { passive: true });
            });
        }

async function fetchConnectorsStatus() {
            try {
                const res = await fetch('/api/connectors/status');
                const data = await res.json();
                if (data.success) {
                    const countEl = document.getElementById('tab-connectors-count');
                    const summaryEl = document.getElementById('connectors-health-summary');
                    const percentEl = document.getElementById('connectors-health-percent');
                    const barEl = document.getElementById('connectors-health-bar');
                    
                    if (countEl) countEl.innerText = `${data.active_connectors} / ${data.total_connectors}`;
                    if (summaryEl) summaryEl.innerText = `${data.active_connectors} sur ${data.total_connectors} Actifs`;
                    if (percentEl) percentEl.innerText = `${data.health_score_percent}% Opérationnel`;
                    if (barEl) barEl.style.width = `${data.health_score_percent}%`;

                    data.connectors.forEach(c => {
                        const badge = document.getElementById(`badge-${c.id}`);
                        if (badge) {
                            if (c.status === 'CONNECTED') {
                                badge.className = 'px-2 py-0.5 rounded-full text-[9px] font-mono bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 whitespace-nowrap';

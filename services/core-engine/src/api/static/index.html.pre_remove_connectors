                }

                isClapActive = false;

                updateClapBadgeUI(false);

            }

        }



        function updateClapBadgeUI(active) {

            const btnBadge = document.getElementById('clap-badge-btn');

            const hudToggleLabel = document.getElementById('hud-clap-label');

            const hudToggleDot = document.getElementById('hud-clap-dot');



            if (active) {

                if (btnBadge) {

                    btnBadge.innerText = '👏 Clap ON';

                    btnBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono font-bold';

                }

                if (hudToggleLabel) hudToggleLabel.innerText = '👂 Détecteur Clap : ACTIF';

                if (hudToggleDot) hudToggleDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-ping';

            } else {

                if (btnBadge) {

                    btnBadge.innerText = '👏 Clap OFF';

                    btnBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-slate-500/20 text-slate-400 font-mono';

                }

                if (hudToggleLabel) hudToggleLabel.innerText = '👂 Détecteur Clap : CLIQUEZ ICI';

                if (hudToggleDot) hudToggleDot.className = 'w-2 h-2 rounded-full bg-slate-400';

            }

        }



        function runClapDetectionLoop() {

            if (!isClapActive || !clapAnalyserNode) return;

            requestAnimationFrame(runClapDetectionLoop);



            // Règle d'or #1 d'Anthony : Sourd pendant qu'il parle !

            if (isJarvisSpeaking || clapCooldownActive) return;



            const freqData = new Uint8Array(clapAnalyserNode.frequencyBinCount);

            clapAnalyserNode.getByteFrequencyData(freqData);



            // Spectre de claquement sec : hautes fréquences (2 kHz - 8 kHz)

            let highFreqSum = 0;

            const startBin = 20;

            for (let i = startBin; i < freqData.length; i++) {

                highFreqSum += freqData[i];

            }

            const avgEnergy = highFreqSum / (freqData.length - startBin);



            // Seuil de détection du claquement de mains

            const ENERGY_SPIKE_THRESHOLD = 90;

            const now = Date.now();



            if (avgEnergy > ENERGY_SPIKE_THRESHOLD) {

                if (now - firstClapTimestamp < 120) return; // Anti-rebond millisecondes



                const timeSinceFirst = (now - firstClapTimestamp) / 1000;



                if (detectedClapHits === 0) {

                    // Premier clap détecté

                    detectedClapHits = 1;

                    firstClapTimestamp = now;



                    // Expiration si pas de deuxième clap dans les 0.75s

                    clearTimeout(applauseRejectionTimer);

                    applauseRejectionTimer = setTimeout(() => {

                        detectedClapHits = 0;

                    }, 750);

                } else if (detectedClapHits === 1) {

                    // Deuxième clap survenu entre 0.15s et 0.70s (Règle Anthony)

                    if (timeSinceFirst >= 0.14 && timeSinceFirst <= 0.72) {

                        detectedClapHits = 2;



                        // Règle d'or #2 d'Anthony : Rejet des applaudissements

                        // Si un 3e pic survient dans les 0.38s, ce sont des applaudissements -> on annule !

                        clearTimeout(applauseRejectionTimer);

                        applauseRejectionTimer = setTimeout(() => {

                            if (detectedClapHits === 2) {

                                // DOUBLE CLAP VALIDÉ !

                                console.log("👏 DOUBLE-CLAP DÉTECTÉ AVEC SUCCÈS !");

                                detectedClapHits = 0;

                                clapCooldownActive = true;

                                setTimeout(() => { clapCooldownActive = false; }, 2500); // 2.5s repos

                                triggerJarvisMode();

                            }

                        }, 380);

                    } else {

                        detectedClapHits = 0;

                    }

                } else {

                    // Plus de 2 claps -> applaudissements continus, rejeté !

                    detectedClapHits = 0;

                    clearTimeout(applauseRejectionTimer);

                }

            }

        }



        // 7. Écouteurs Clavier (Touche Espace pour réveiller Jarvis, Échap pour fermer)

        window.addEventListener('keydown', (e) => {


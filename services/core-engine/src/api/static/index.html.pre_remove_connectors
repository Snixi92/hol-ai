        function selectHeroCarouselSlide(index) {
            if (index < 0 || index >= HERO_CAROUSEL_ITEMS.length) return;
            heroCarouselCurrentIndex = index;
            const item = HERO_CAROUSEL_ITEMS[index];
            window.currentChatBackground = item.id;
            if (typeof setChatBackground === 'function') setChatBackground(item.id);
            updateHeroCarouselUI();
        }

        function heroCarouselNext(e) {
            if (e) e.stopPropagation();
            const nextIdx = (heroCarouselCurrentIndex + 1) % HERO_CAROUSEL_ITEMS.length;
            selectHeroCarouselSlide(nextIdx);
        }

        function heroCarouselPrev(e) {
            if (e) e.stopPropagation();
            const prevIdx = (heroCarouselCurrentIndex - 1 + HERO_CAROUSEL_ITEMS.length) % HERO_CAROUSEL_ITEMS.length;
            selectHeroCarouselSlide(prevIdx);
        }

        function updateHeroCarouselUI() {
            // Find active index
            const activeBg = window.currentChatBackground || localStorage.getItem('hol_chat_background') || 'default';
            const idx = HERO_CAROUSEL_ITEMS.findIndex(item => item.id === activeBg);
            if (idx !== -1) heroCarouselCurrentIndex = idx;
            const activeItem = HERO_CAROUSEL_ITEMS[heroCarouselCurrentIndex] || HERO_CAROUSEL_ITEMS[0];

            // 1. Update text elements in Settings Carousel
            const titleEl = document.getElementById('hero-carousel-title');
            if (titleEl) titleEl.innerText = activeItem.title;

            const authorEl = document.getElementById('hero-carousel-author');
            if (authorEl) authorEl.innerText = activeItem.author;

            const catEl = document.getElementById('hero-carousel-cat');
            if (catEl) catEl.innerText = activeItem.category;

            const tagsEl = document.getElementById('hero-carousel-tags');
            if (tagsEl) tagsEl.innerText = activeItem.tags.join(' • ');

            const counterEl = document.getElementById('hero-carousel-counter');
            if (counterEl) {
                const cur = String(heroCarouselCurrentIndex + 1).padStart(2, '0');
                const tot = String(HERO_CAROUSEL_ITEMS.length).padStart(2, '0');
                counterEl.innerText = `${cur} / ${tot}`;
            }

            const progressBar = document.getElementById('hero-carousel-progress-bar');
            if (progressBar) {
                const pctWidth = 100 / HERO_CAROUSEL_ITEMS.length;
                const pctLeft = (heroCarouselCurrentIndex / HERO_CAROUSEL_ITEMS.length) * 100;
                progressBar.style.width = `${pctWidth}%`;
                progressBar.style.left = `${pctLeft}%`;
                progressBar.style.backgroundColor = activeItem.accent;
            }

            // 2. Update Dynamic Backdrop Media
            const backdropMedia = document.getElementById('hero-carousel-backdrop-media');
            if (backdropMedia) {
                backdropMedia.innerHTML = activeItem.previewHtml;
            }

            // 3. Center and highlight slides in modal track
            const track = document.getElementById('hero-carousel-track');
            const trackWrapper = document.getElementById('hero-carousel-track-wrapper');
            if (track && trackWrapper) {
                const slides = track.querySelectorAll('.hero-carousel-slide');
                slides.forEach((s, i) => {
                    if (i === heroCarouselCurrentIndex) {
                        s.classList.remove('is-inactive');
                        s.classList.add('is-active', 'active-bg');
                        s.setAttribute('aria-current', 'true');
                    } else {
                        s.classList.remove('is-active', 'active-bg');
                        s.classList.add('is-inactive');
                        s.setAttribute('aria-current', 'false');
                    }
                });

                // Compute horizontal offset to center the active slide
                const wrapperWidth = trackWrapper.offsetWidth || 440;
                // Active slide width is 104px, inactive is 80px, gap is 10px
                let offsetBefore = 0;
                for (let i = 0; i < heroCarouselCurrentIndex; i++) {
                    offsetBefore += 80 + 10;
                }
                const activeCenter = offsetBefore + (104 / 2);
                const targetX = (wrapperWidth / 2) - activeCenter - 20; // 20px padding
                track.style.transform = `translateX(${Math.round(targetX)}px)`;
            }

            // 4. Update Panoramic Modal UI if present
            const panoTitle = document.getElementById('panoramic-title');
            if (panoTitle) panoTitle.innerText = activeItem.title;

            const panoAuthor = document.getElementById('panoramic-author');
            if (panoAuthor) panoAuthor.innerText = activeItem.author;

            const panoCat = document.getElementById('panoramic-cat-badge');
            if (panoCat) panoCat.innerText = activeItem.category;

            const panoTags = document.getElementById('panoramic-tags');
            if (panoTags) {
                panoTags.innerHTML = activeItem.tags.map(t => `<span class=\"px-2 py-0.5 rounded bg-white/10 border border-white/10\">${t}</span>`).join('');
            }

            const panoCounter = document.getElementById('panoramic-counter');
            if (panoCounter) {
                const cur = String(heroCarouselCurrentIndex + 1).padStart(2, '0');
                const tot = String(HERO_CAROUSEL_ITEMS.length).padStart(2, '0');
                panoCounter.innerText = `${cur} / ${tot}`;
            }

            const panoProgress = document.getElementById('panoramic-progress-bar');
            if (panoProgress) {
                const pctWidth = 100 / HERO_CAROUSEL_ITEMS.length;
                const pctLeft = (heroCarouselCurrentIndex / HERO_CAROUSEL_ITEMS.length) * 100;
                panoProgress.style.width = `${pctWidth}%`;
                panoProgress.style.left = `${pctLeft}%`;
                panoProgress.style.backgroundColor = activeItem.accent;
            }

            const panoMedia = document.getElementById('panoramic-bg-preview-media');
            if (panoMedia) {
                panoMedia.innerHTML = activeItem.previewHtml;
            }

            const panoTrack = document.getElementById('panoramic-carousel-track');
            const panoTrackWrapper = document.getElementById('panoramic-track-wrapper');
            if (panoTrack && panoTrackWrapper) {
                const panoSlides = panoTrack.querySelectorAll('.hero-panoramic-slide');
                panoSlides.forEach((s, i) => {
                    if (i === heroCarouselCurrentIndex) {
                        s.classList.remove('is-inactive');
                        s.classList.add('is-active', 'active-bg');
                    } else {
                        s.classList.remove('is-active', 'active-bg');
                        s.classList.add('is-inactive');
                    }
                });

                const panoWrapperWidth = panoTrackWrapper.offsetWidth || 1000;
                let panoOffset = 0;
                for (let i = 0; i < heroCarouselCurrentIndex; i++) {
                    panoOffset += 130 + 10;
                }
                const panoCenter = panoOffset + (180 / 2);
                const panoTargetX = (panoWrapperWidth / 2) - panoCenter - 20;
                panoTrack.style.transform = `translateX(${Math.round(panoTargetX)}px)`;
            }

            // Sync badge in settings
            const badge = document.getElementById('active-bg-badge');
            if (badge) {
                badge.innerText = activeItem.title.split(' ')[0];
            }
        }


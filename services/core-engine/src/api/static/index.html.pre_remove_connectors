        async function saveConnectorDrawerConfig(connectorId) {
            let payload = {};
            if (connectorId === 'gmail') {
                payload.user = document.getElementById('drawer-input-gmail-user')?.value || '';
                payload.password = document.getElementById('drawer-input-gmail-pwd')?.value || '';
            } else if (connectorId === 'telegram') {
                payload.bot_token = document.getElementById('drawer-input-tg-token')?.value || '';
                payload.chat_id = document.getElementById('drawer-input-tg-chat')?.value || '';
            } else if (connectorId === 'whatsapp') {
                payload.token = document.getElementById('drawer-input-wa-token')?.value || '';
                payload.phone_id = document.getElementById('drawer-input-wa-phone')?.value || '';
            } else if (connectorId === 'gemini') {
                payload.api_key = document.getElementById('drawer-input-gemini')?.value || '';
            } else if (connectorId === 'google_calendar') {
                payload.calendar_url = document.getElementById('drawer-input-calendar-url')?.value || '';
            } else if (connectorId === 'notion') {
                payload.api_key = document.getElementById('drawer-input-notion-key')?.value || '';
                payload.database_id = document.getElementById('drawer-input-notion-db')?.value || '';
            } else if (connectorId === 'sheets') {
                payload.spreadsheet_id = document.getElementById('drawer-input-sheets-id')?.value || '';
            } else if (connectorId === 'slack') {
                payload.webhook_url = document.getElementById('drawer-input-slack-webhook')?.value || '';
            } else if (connectorId === 'webhooks') {
                payload.url = document.getElementById('drawer-input-webhook-url')?.value || '';
            }

            try {
                const res = await fetch('/api/connectors/configure', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ connector_id: connectorId, payload })
                });
                const data = await res.json();
                if (data.success) {
                    showConnectorFeedback(data.message || `Connecteur ${connectorId} configuré avec succès !`, true);
                    const drawerFb = document.getElementById('drawer-feedback-box');
                    if (drawerFb) {
                        drawerFb.classList.remove('hidden', 'bg-rose-500/20', 'text-rose-300', 'border-rose-500/40');
                        drawerFb.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
                        drawerFb.innerText = `✓ ${data.message || "Enregistré avec succès dans .env"}`;
                    }
                    fetchConnectorsStatus();
                } else {
                    showConnectorFeedback(data.error || "Erreur lors de la configuration.", false);
                }
            } catch (e) {
                showConnectorFeedback(`Erreur réseau : ${e.message}`, false);
            }
        }


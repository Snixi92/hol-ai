            <!-- Viewport Canvas avec Screencast CDP & Curseur IA -->

            <div id="cu-viewport-container" class="relative flex-1 bg-black overflow-hidden flex items-center justify-center p-1 sm:p-2 min-h-[380px] sm:min-h-[500px]">

                <canvas id="cu-screencast-canvas" width="1280" height="800" class="w-full h-auto max-h-[75vh] object-contain rounded-xl border border-white/5 shadow-2xl select-none"></canvas>

                

                <!-- Loader d'initialisation & synchronisation vidéo -->

                <div id="cu-loading-overlay" class="absolute inset-0 bg-black/90 flex flex-col items-center justify-center space-y-4 p-6 z-10 transition-opacity duration-300">

                    <div class="relative w-16 h-16 flex items-center justify-center">

                        <div class="absolute inset-0 rounded-full border-4 border-white/15 animate-ping"></div>

                        <div class="w-12 h-12 rounded-full border-4 border-cyan-400 border-t-transparent animate-spin"></div>

                        <span class="absolute text-xl">🌐</span>

                    </div>

                    <div class="text-center space-y-1.5 max-w-sm">

                        <p id="cu-loader-title" class="text-white font-bold text-sm tracking-wide">Démarrage du navigateur virtuel Chromium...</p>

                        <p id="cu-loader-sub" class="text-neutral-200/80 font-mono text-xs">Synchronisation du flux direct CDP (Chrome DevTools)</p>

                        <p class="text-slate-500 text-[11px]">Le flux vidéo s'affiche dès que la page est chargée</p>

                    </div>

                </div>



                <!-- Curseur Virtuel IA Lumineux -->

                <div id="cu-virtual-cursor" class="pointer-events-none absolute w-5 h-5 rounded-full border-2 border-cyan-400 bg-cyan-400/30 shadow-lg shadow-cyan-400/80 -translate-x-1/2 -translate-y-1/2 transition-all duration-75 flex items-center justify-center hidden" style="top: 50%; left: 50%;">

                    <div class="w-1.5 h-1.5 rounded-full bg-cyan-200"></div>

                </div>

            </div>



            <!-- Footer / Status Bar -->

            <div class="p-2.5 bg-[#121216] border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-slate-400">

                <div class="flex items-center space-x-2 truncate">

                    <span id="cu-status-dot" class="text-amber-400 font-bold animate-pulse">● Connexion...</span>

                    <span id="cu-status-text" class="text-slate-300 truncate">Initialisation de la session</span>

                </div>

                <div class="flex items-center space-x-3 text-[10px] text-slate-500">

                    <span>CDP 30 FPS</span>

                    <span>1280x800</span>

                    <span class="text-neutral-200">HoL AI Virtual Engine</span>

                </div>

            </div>

        </div>

    </div>



    <!-- SCRIPT DE GESTION DU COMPUTER-USE ET WEBSOCKET STREAMING -->

    <script>

        let cuWebSocket = null;

        let cuIsTakeOver = false;

        const cuModal = document.getElementById('computer-use-modal');

        const cuCanvas = document.getElementById('cu-screencast-canvas');

        const cuCtx = cuCanvas ? cuCanvas.getContext('2d') : null;

        const cuCursor = document.getElementById('cu-virtual-cursor');

        const cuUrlInput = document.getElementById('cu-url-input');

        const cuModeBadge = document.getElementById('cu-mode-badge');

        const cuTakeOverBtn = document.getElementById('cu-takeover-btn');

        const cuStatusText = document.getElementById('cu-status-text');



        const cuStatusDot = document.getElementById('cu-status-dot');

        const cuLoadingOverlay = document.getElementById('cu-loading-overlay');

        const cuLoaderTitle = document.getElementById('cu-loader-title');



        function openComputerUseModal(initialUrl) {

            if (initialUrl && cuUrlInput) cuUrlInput.value = initialUrl;

            if (cuModal) cuModal.classList.remove('hidden');

            if (cuLoadingOverlay) cuLoadingOverlay.classList.remove('hidden');

            initComputerUseWebSocket();

        }



        function closeComputerUseModal() {

            if (cuModal) cuModal.classList.add('hidden');

        }



        function initComputerUseWebSocket() {

            if (cuWebSocket && cuWebSocket.readyState === WebSocket.OPEN) return;

            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';

            const wsUrl = `${protocol}//${window.location.host}/ws/browser-stream`;

            

            if (cuStatusDot) {

                cuStatusDot.innerText = "● Connexion...";

                cuStatusDot.className = "text-amber-400 font-bold animate-pulse";

            }



            cuWebSocket = new WebSocket(wsUrl);



            cuWebSocket.onopen = function() {

                if (cuStatusDot) {

                    cuStatusDot.innerText = "● Connecté";

                    cuStatusDot.className = "text-emerald-400 font-bold";

                }

            };



            cuWebSocket.onmessage = function(event) {

                try {

                    const data = JSON.parse(event.data);



                    if (data.type === 'status_update') {

                        if (data.status && cuStatusText) cuStatusText.innerText = data.status;

                        if (data.loading && cuLoadingOverlay) {

                            cuLoadingOverlay.classList.remove('hidden');

                            if (cuLoaderTitle && data.status) cuLoaderTitle.innerText = data.status;

                        } else if (!data.loading && cuLoadingOverlay) {

                            cuLoadingOverlay.classList.add('hidden');

                        }

                    }



                    if (data.type === 'screencast_frame' && data.frame) {

                        // Masquer immédiatement le loader dès réception d'une trame

                        if (cuLoadingOverlay) cuLoadingOverlay.classList.add('hidden');

                        if (cuCursor) cuCursor.classList.remove('hidden');

                        if (cuStatusDot) {

                            cuStatusDot.innerText = "● Connecté";

                            cuStatusDot.className = "text-emerald-400 font-bold";

                        }



                        const img = new Image();

                        img.onload = function() {

                            if (cuCtx) {

                                cuCtx.drawImage(img, 0, 0, cuCanvas.width, cuCanvas.height);

                            }

                        };

                        img.src = 'data:image/jpeg;base64,' + data.frame;



                        if (data.cursor && cuCursor && cuCanvas) {

                            const canvasRect = cuCanvas.getBoundingClientRect();

                            const containerRect = cuCanvas.parentElement.getBoundingClientRect();

                            const scaleX = canvasRect.width / cuCanvas.width;

                            const scaleY = canvasRect.height / cuCanvas.height;

                            const curLeft = (canvasRect.left - containerRect.left) + data.cursor.x * scaleX;

                            const curTop = (canvasRect.top - containerRect.top) + data.cursor.y * scaleY;

                            cuCursor.style.left = `${curLeft}px`;

                            cuCursor.style.top = `${curTop}px`;

                        }



                        if (data.url && cuUrlInput && document.activeElement !== cuUrlInput) {

                            cuUrlInput.value = data.url;

                        }

                        if (data.status && cuStatusText) {

                            cuStatusText.innerText = data.status;

                        }

                    }

                } catch(e) {

                    console.error("Erreur frame screencast:", e);

                }

            };



            cuWebSocket.onerror = function() {

                if (cuStatusDot) {

                    cuStatusDot.innerText = "✕ Erreur flux";

                    cuStatusDot.className = "text-rose-400 font-bold";

                }

            };



            cuWebSocket.onclose = function() {

                if (cuStatusDot) {

                    cuStatusDot.innerText = "● Déconnecté";

                    cuStatusDot.className = "text-amber-400 font-bold";

                }

                if (cuStatusText) cuStatusText.innerText = "Stream déconnecté. Reconnexion...";

                setTimeout(initComputerUseWebSocket, 3000);

            };

        }



        function toggleTakeOverMode() {

            cuIsTakeOver = !cuIsTakeOver;

            if (cuIsTakeOver) {

                cuModeBadge.className = "px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 font-mono text-[10px] font-bold border border-amber-500/30";

                cuModeBadge.innerText = "🎮 CONTRÔLE HUMAIN (TAKE OVER)";

                cuTakeOverBtn.className = "px-3.5 py-1.5 rounded-xl bg-white text-black hover:bg-neutral-200 text-white font-bold text-xs shadow-lg transition flex items-center space-x-1";

                cuTakeOverBtn.innerHTML = "<span>🤖</span><span>Rendre la main à l'IA</span>";

                cuCanvas.style.cursor = "pointer";

                sendCuAction({ type: "set_mode", mode: "human_takeover" });

            } else {

                cuModeBadge.className = "px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-neutral-300 font-mono text-[10px] font-bold border border-white/15";

                cuModeBadge.innerText = "MODE IA SPECTATEUR";

                cuTakeOverBtn.className = "px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-black font-bold text-xs shadow-lg shadow-amber-500/20 transition flex items-center space-x-1";

                cuTakeOverBtn.innerHTML = '<i data-lucide="gamepad-2" class="w-3.5 h-3.5 inline text-neutral-400"></i><span>Take Over (Prendre la main)</span>';

                cuCanvas.style.cursor = "default";

                sendCuAction({ type: "set_mode", mode: "ai_autonomous" });

            }

        }



        function sendCuAction(payload) {

            if (cuWebSocket && cuWebSocket.readyState === WebSocket.OPEN) {

                cuWebSocket.send(JSON.stringify(payload));

            }

        }



        function navigateComputerUse() {

            const url = cuUrlInput.value.trim();

            if (url) {

                sendCuAction({ type: "navigate", url: url });

            }

        }



        function emergencyStopComputerUse() {

            sendCuAction({ type: "emergency_stop" });

            if (cuStatusText) cuStatusText.innerText = "Arrêt d'urgence envoyé.";

        }



        if (cuCanvas) {

            cuCanvas.addEventListener('click', function(e) {

                if (!cuIsTakeOver) return;

                const rect = cuCanvas.getBoundingClientRect();

                const scaleX = cuCanvas.width / rect.width;

                const scaleY = cuCanvas.height / rect.height;

                const x = (e.clientX - rect.left) * scaleX;

                const y = (e.clientY - rect.top) * scaleY;

                sendCuAction({ type: "mouse_click", x: Math.round(x), y: Math.round(y), button: "left" });

            });



            cuCanvas.addEventListener('mousemove', function(e) {

                if (!cuIsTakeOver) return;

                const rect = cuCanvas.getBoundingClientRect();

                const scaleX = cuCanvas.width / rect.width;

                const scaleY = cuCanvas.height / rect.height;

                const x = (e.clientX - rect.left) * scaleX;

                const y = (e.clientY - rect.top) * scaleY;

                sendCuAction({ type: "mouse_move", x: Math.round(x), y: Math.round(y) });

            });



            cuCanvas.addEventListener('wheel', function(e) {

                if (!cuIsTakeOver) return;

                e.preventDefault();

                sendCuAction({ type: "scroll", dy: e.deltaY });

            }, { passive: false });



            window.addEventListener('keydown', function(e) {

                if (!cuIsTakeOver || cuModal.classList.contains('hidden')) return;

                if (document.activeElement === cuUrlInput) return;

                if (e.key.length === 1) {

                    sendCuAction({ type: "type_text", text: e.key });

                } else if (['Enter', 'Backspace', 'Tab', 'Escape', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {

                    sendCuAction({ type: "key_down", key: e.key });

                }

            });

        }

    </script>



    <script>

        function switchMetaMuseSpace(spaceName) {

            document.querySelectorAll('.space-tab-btn').forEach(btn => {

                btn.className = "space-tab-btn px-2.5 py-1 rounded-lg font-medium text-xs text-slate-400 hover:text-white hover:bg-white/5 flex items-center space-x-1 transition";

            });

            const activeBtn = document.getElementById(`space-${spaceName}-btn`);

            if (activeBtn) {

                activeBtn.className = "space-tab-btn px-2.5 py-1 rounded-lg font-bold text-xs bg-white/10 text-neutral-300 border border-white/15 flex items-center space-x-1 transition";

            }

            if (spaceName === 'goals') {

                const msgInput = document.getElementById('chat-input') || document.querySelector('input[type="text"]');

                if (msgInput) {

                    msgInput.value = "Affiche mes objectifs en cours et mon avancement";

                    if (typeof sendMessage === 'function') sendMessage();

                }

            } else if (spaceName === 'ideas') {

                const msgInput = document.getElementById('chat-input') || document.querySelector('input[type="text"]');

                if (msgInput) {

                    msgInput.value = "Donne-moi 3 idées proactives pour optimiser mes dépenses et ma journée";

                    if (typeof sendMessage === 'function') sendMessage();

                }

            } else if (spaceName === 'artifacts') {

                const msgInput = document.getElementById('chat-input') || document.querySelector('input[type="text"]');

                if (msgInput) {

                    msgInput.value = "Montre-moi la liste des artefacts générés";

                    if (typeof sendMessage === 'function') sendMessage();

                }

            }

        }

    </script>


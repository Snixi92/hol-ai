    <style>
                :root {
            --glass-blur: 28px;
            --glass-saturate: 190%;
            --glass-contrast: 105%;
            --spring-standard: cubic-bezier(0.22, 1, 0.36, 1);
            --spring-bounce: cubic-bezier(0.16, 1, 0.3, 1);
            --spring-snappy: cubic-bezier(0.2, 0, 0, 1);
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            --safe-left: env(safe-area-inset-left, 0px);
            --safe-right: env(safe-area-inset-right, 0px);
        }

        /* Mobile Safe-Area Insets for iOS 27 */
        header, #header-messaging, #header-perplexity, #header-chatgpt {
            padding-top: max(0.5rem, env(safe-area-inset-top, 0px)) !important;
        }
        .ios-dock-container {
            bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px)) !important;
            padding-bottom: env(safe-area-inset-bottom, 0px);
        }
        .ios-chat-scroll {
            padding-bottom: calc(11.5rem + env(safe-area-inset-bottom, 0px)) !important;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "SF Pro", "Plus Jakarta Sans", sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            -webkit-tap-highlight-color: transparent;
            transition: background-color 0.3s var(--spring-standard), color 0.3s var(--spring-standard);
        }

        /* Thème Sombre : Obsidian OLED profond avec lumière ambiante Apple */
        html.dark body {
            background-color: #08080a;
            color: #f4f4f6;
            background-image: 
                radial-gradient(at 15% 20%, rgba(255, 255, 255, 0.08) 0px, transparent 45%),
                radial-gradient(at 85% 75%, rgba(160, 180, 210, 0.05) 0px, transparent 50%),
                radial-gradient(at 50% 50%, rgba(255, 255, 255, 0.02) 0px, transparent 65%);
        }

        /* Thème Clair : Frosted Pure Slate avec brillance ambiante */
        html:not(.dark) body {
            background-color: #f5f5f7;
            color: #09090b;
            background-image: 
                radial-gradient(at 20% 20%, rgba(0, 0, 0, 0.035) 0px, transparent 60%),
                radial-gradient(at 80% 80%, rgba(0, 0, 0, 0.025) 0px, transparent 60%);
        }

        /* --- MOTEUR LIQUID GLASS APPLE iOS 27 (MASTER SPEC "REGULAR GLASS") --- */

        .liquid-glass, .liquid-glass-regular {
            position: relative;
            background: 
                linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.025) 35%, rgba(0, 0, 0, 0.06) 65%, rgba(255, 255, 255, 0.09) 100%),
                rgba(14, 14, 18, 0.52);
            backdrop-filter: blur(28px) saturate(220%) contrast(108%);
            -webkit-backdrop-filter: blur(28px) saturate(220%) contrast(108%);
            border: 1px solid rgba(255, 255, 255, 0.20);
            box-shadow: 
                /* Arête spéculaire supérieure ultra-fine rasoir */
                inset 0 1.6px 2px 0 rgba(255, 255, 255, 0.85),
                /* Réfraction d'ombre inférieure (effet d'épaisseur de lentille) */
                inset 0 -2px 3px 0 rgba(0, 0, 0, 0.50),
                /* Biseau latéral gauche */
                inset 2px 0 3px 0 rgba(255, 255, 255, 0.30),
                /* Biseau latéral droit */
                inset -2px 0 3px 0 rgba(255, 255, 255, 0.18),
                /* Micro-aberration chromatique périphérique */
                0 0 1px 0 rgba(255, 80, 80, 0.15),
                0 0 2px 0 rgba(80, 160, 255, 0.15),
                /* Ombre volumétrique douce et diffuse */
                0 28px 64px -10px rgba(0, 0, 0, 0.82);
            transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                        box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }

        /* Réfraction interactive au survol & toucher (Dynamisme optique de Fresnel) */
        .liquid-glass::before, .liquid-glass-regular::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: radial-gradient(
                circle 280px at var(--mouse-x, 50%) var(--mouse-y, 50%),
                rgba(255, 255, 255, 0.28) 0%,
                rgba(255, 255, 255, 0.05) 40%,
                transparent 70%
            );
            opacity: 0.92;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }

        /* Dock flottant : Master Capsule Fluide Apple Liquid Glass */
        .liquid-glass-dock {
            position: relative;
            background: 
                linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.02) 35%, rgba(0, 0, 0, 0.05) 65%, rgba(255, 255, 255, 0.10) 100%),
                rgba(14, 14, 18, 0.52);
            backdrop-filter: blur(32px) saturate(220%) contrast(108%);
            -webkit-backdrop-filter: blur(32px) saturate(220%) contrast(108%);
            border: 1px solid rgba(255, 255, 255, 0.22);
            box-shadow: 
                inset 0 1.8px 2.5px 0 rgba(255, 255, 255, 0.88),
                inset 0 -2.2px 3.5px 0 rgba(0, 0, 0, 0.55),
                inset 2.2px 0 3.5px 0 rgba(255, 255, 255, 0.35),
                inset -2.2px 0 3.5px 0 rgba(255, 255, 255, 0.20),
                0 0 1px 0 rgba(255, 80, 80, 0.16),
                0 0 2px 0 rgba(80, 160, 255, 0.16),
                0 32px 72px -12px rgba(0, 0, 0, 0.85);
        }

        .liquid-glass-dock::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: radial-gradient(
                circle 320px at var(--mouse-x, 50%) var(--mouse-y, 50%),
                rgba(255, 255, 255, 0.30) 0%,
                rgba(255, 255, 255, 0.06) 40%,
                transparent 70%
            );
            opacity: 0.95;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }

        /* Thème clair : Liquid Glass cristal pur poli */
        html:not(.dark) .liquid-glass, 
        html:not(.dark) .liquid-glass-regular,
        html:not(.dark) .liquid-glass-dock {
            background: 
                linear-gradient(135deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.36) 35%, rgba(240, 240, 248, 0.25) 65%, rgba(255, 255, 255, 0.55) 100%),
                rgba(255, 255, 255, 0.68);
            border: 1px solid rgba(255, 255, 255, 0.95);
            box-shadow: 
                inset 0 1.6px 2px 0 rgba(255, 255, 255, 0.98),
                inset 0 -1.6px 2px 0 rgba(0, 0, 0, 0.06),
                inset 1.6px 0 2px 0 rgba(255, 255, 255, 0.60),
                inset -1.6px 0 2px 0 rgba(255, 255, 255, 0.40),
                0 20px 48px -10px rgba(15, 23, 42, 0.14);
        }

        /* Contrôles et pills subtils en Liquid Glass */
        .liquid-glass-subtle {
            position: relative;
            background: 
                linear-gradient(135deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0.02) 50%, rgba(255, 255, 255, 0.06) 100%),
                rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(20px) saturate(190%);
            -webkit-backdrop-filter: blur(20px) saturate(190%);
            border: 1px solid rgba(255, 255, 255, 0.14);
            box-shadow: 
                inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.45),
                inset 0 -1px 1px 0 rgba(0, 0, 0, 0.25),
                0 10px 28px -6px rgba(0, 0, 0, 0.40);
        }

        html:not(.dark) .liquid-glass-subtle {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(20px) saturate(190%);
            -webkit-backdrop-filter: blur(20px) saturate(190%);
            border: 1px solid rgba(255, 255, 255, 0.92);
            box-shadow: 
                inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.95),
                0 8px 24px -6px rgba(15, 23, 42, 0.06);
        }

        /* Apple HIG Calque de Contenu Standard : lisibilité absolue sans verre parasite */
        .bubble-assistant {
            background: #111115 !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35) !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }

        html:not(.dark) .bubble-assistant {
            background: #ffffff !important;
            border: 1px solid rgba(0, 0, 0, 0.08) !important;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06) !important;
        }

        /* Boutons de suggestions rapides dans le calque de contenu */
        .suggestion-chip {
            background: #18181f;
            border: 1px solid rgba(255, 255, 255, 0.10);
            color: #e4e4e7;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
            transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .suggestion-chip:hover {
            background: #24242e;
            border-color: rgba(255, 255, 255, 0.22);
            color: #ffffff;
            transform: translateY(-1px) scale(1.02);
        }

        html:not(.dark) .suggestion-chip {
            background: #f0f0f4;
            border: 1px solid rgba(0, 0, 0, 0.08);
            color: #18181b;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        }

        html:not(.dark) .suggestion-chip:hover {
            background: #e4e4e9;
            border-color: rgba(0, 0, 0, 0.16);
        }

        /* Bulle Utilisateur : High-End Obsidian / Titanium */
        .bubble-user-glass {
            background: #1c1c22;
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 
                inset 0 1px 1px 0 rgba(255, 255, 255, 0.32),
                0 8px 22px -4px rgba(0, 0, 0, 0.45);
        }

        html:not(.dark) .bubble-user-glass {
            background: #18181b;
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 
                inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.45),
                0 8px 20px -4px rgba(0, 0, 0, 0.18);
        }

        /* Avatar Apple Frosted Sphere */
        .apple-avatar {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.08));
            border: 1px solid rgba(255, 255, 255, 0.30);
            box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.6), 0 4px 12px rgba(0, 0, 0, 0.30);
            color: #ffffff;
            font-weight: 700;
        }

        /* =========================================================================
           FONDS D'ÉCRAN DYNAMIQUES DE CONVERSATION (APPLE iOS 27 LIQUID CANVAS)
           ========================================================================= */
        #conversation-bg-layer {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            transition: background 0.5s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.5s ease;
        }

        .bg-preset-default {
            background: transparent !important;
        }

        .bg-preset-aurora {
            background: 
                radial-gradient(ellipse at 15% 10%, rgba(56, 189, 248, 0.24) 0%, transparent 55%),
                radial-gradient(ellipse at 85% 25%, rgba(168, 85, 247, 0.26) 0%, transparent 55%),
                radial-gradient(ellipse at 50% 85%, rgba(16, 185, 129, 0.20) 0%, transparent 65%),
                #08080d !important;
        }

        .bg-preset-cyber-grid {
            background-color: #060810 !important;
            background-image: 
                linear-gradient(to right, rgba(56, 189, 248, 0.12) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(168, 85, 247, 0.12) 1px, transparent 1px),
                radial-gradient(circle at 50% 30%, rgba(56, 189, 248, 0.20) 0%, transparent 70%) !important;
            background-size: 32px 32px, 32px 32px, 100% 100% !important;
        }

        .bg-preset-nebula {
            background-color: #04020a !important;
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(236, 72, 153, 0.24) 0%, transparent 50%),
                radial-gradient(circle at 80% 60%, rgba(99, 102, 241, 0.30) 0%, transparent 55%),
                radial-gradient(circle at 50% 10%, rgba(139, 92, 246, 0.25) 0%, transparent 60%),
                radial-gradient(circle at 85% 15%, rgba(255, 255, 255, 0.7) 1px, transparent 2px),
                radial-gradient(circle at 15% 75%, rgba(255, 255, 255, 0.6) 1px, transparent 2px),
                radial-gradient(circle at 45% 60%, rgba(255, 255, 255, 0.5) 1px, transparent 2px),
                radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.6) 1px, transparent 2px) !important;
            background-size: 100% 100%, 100% 100%, 100% 100%, 180px 180px, 220px 220px, 160px 160px, 200px 200px !important;
        }

        .bg-preset-frosted {
            background: 
                radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.09) 0%, transparent 70%),
                linear-gradient(180deg, #13151c 0%, #090a0d 100%) !important;
        }

        .bg-preset-sunset {
            background: 
                radial-gradient(circle at 85% 15%, rgba(244, 63, 94, 0.26) 0%, transparent 60%),
                radial-gradient(circle at 15% 55%, rgba(245, 158, 11, 0.20) 0%, transparent 60%),
                radial-gradient(circle at 50% 90%, rgba(139, 92, 246, 0.24) 0%, transparent 70%),
                #0c0612 !important;
        }

        /* Support du thème clair pour les presets */
        html:not(.dark) .bg-preset-aurora {
            background: 
                radial-gradient(ellipse at 15% 10%, rgba(56, 189, 248, 0.16) 0%, transparent 55%),
                radial-gradient(ellipse at 85% 25%, rgba(168, 85, 247, 0.16) 0%, transparent 55%),
                radial-gradient(ellipse at 50% 85%, rgba(16, 185, 129, 0.14) 0%, transparent 65%),
                #f0f4f8 !important;
        }
        html:not(.dark) .bg-preset-cyber-grid {
            background-color: #f1f5f9 !important;
            background-image: 
                linear-gradient(to right, rgba(56, 189, 248, 0.15) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(168, 85, 247, 0.15) 1px, transparent 1px),
                radial-gradient(circle at 50% 30%, rgba(56, 189, 248, 0.12) 0%, transparent 70%) !important;
            background-size: 32px 32px, 32px 32px, 100% 100% !important;
        }
        html:not(.dark) .bg-preset-nebula {
            background-color: #f3f0f7 !important;
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(236, 72, 153, 0.14) 0%, transparent 50%),
                radial-gradient(circle at 80% 60%, rgba(99, 102, 241, 0.16) 0%, transparent 55%),
                radial-gradient(circle at 50% 10%, rgba(139, 92, 246, 0.14) 0%, transparent 60%) !important;
        }
        html:not(.dark) .bg-preset-frosted {
            background: 
                radial-gradient(circle at 50% 0%, rgba(0, 0, 0, 0.05) 0%, transparent 70%),
                linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%) !important;
        }
        html:not(.dark) .bg-preset-sunset {
            background: 
                radial-gradient(circle at 85% 15%, rgba(244, 63, 94, 0.15) 0%, transparent 60%),
                radial-gradient(circle at 15% 55%, rgba(245, 158, 11, 0.13) 0%, transparent 60%),
                radial-gradient(circle at 50% 90%, rgba(139, 92, 246, 0.15) 0%, transparent 70%),
                #fdf2f4 !important;
        }

        .chat-bg-card {
            transition: all 0.22s cubic-bezier(0.22, 1, 0.36, 1);
            cursor: pointer;
        }
        .chat-bg-card:hover {
            transform: translateY(-2px) scale(1.02);
            background: rgba(255, 255, 255, 0.08);
        }
        .chat-bg-card.active-bg {
            border-color: #38bdf8 !important;
            background: rgba(56, 189, 248, 0.12) !important;
            box-shadow: 0 0 14px rgba(56, 189, 248, 0.30);
        }

        /* Apple HIG Scroll Edge Effect (Rule #6) */
        .ios-chat-scroll {
            mask-image: linear-gradient(to bottom, transparent 0%, black 20px, black calc(100% - 36px), transparent 100%);
            -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20px, black calc(100% - 36px), transparent 100%);
        }

        /* Apple HIG Accessibilité (Rule #5) */
        @media (prefers-reduced-transparency: reduce) {
            .liquid-glass, .liquid-glass-regular, .liquid-glass-dock, .liquid-glass-subtle {
                backdrop-filter: none !important;
                -webkit-backdrop-filter: none !important;
                background: #121216 !important;
                border: 1px solid rgba(255, 255, 255, 0.25) !important;
            }
            html:not(.dark) .liquid-glass,
            html:not(.dark) .liquid-glass-regular,
            html:not(.dark) .liquid-glass-dock,
            html:not(.dark) .liquid-glass-subtle {
                background: #ffffff !important;
                border: 1px solid rgba(0, 0, 0, 0.15) !important;
            }
        }

        @media (prefers-contrast: more) {
            .liquid-glass, .liquid-glass-regular, .liquid-glass-dock {
                border: 2px solid rgba(255, 255, 255, 0.45) !important;
            }
            html:not(.dark) .liquid-glass,
            html:not(.dark) .liquid-glass-regular,
            html:not(.dark) .liquid-glass-dock {
                border: 2px solid rgba(0, 0, 0, 0.40) !important;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .msg-animate, .tactile-btn, .liquid-glass, .liquid-glass-regular, .liquid-glass-dock {
                animation: none !important;
                transition: none !important;
            }
            .liquid-glass::before, .liquid-glass-regular::before, .liquid-glass-dock::before {
                display: none !important;
            }
        }

        /* Animations à Ressort (Apple Spring Physics) */
        @keyframes appleMessageSpring {
            0% {
                opacity: 0;
                transform: translateY(14px) scale(0.975);
            }
            65% {
                opacity: 0.98;
                transform: translateY(-1.5px) scale(1.005);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .msg-animate {
            animation: appleMessageSpring 0.38s var(--spring-standard) forwards;
        }

        /* Tactile buttons avec rebond élastique iOS 27 */
        .tactile-btn {
            transition: transform 0.22s var(--spring-standard), 
                        background-color 0.15s ease, 
                        border-color 0.15s ease, 
                        box-shadow 0.22s var(--spring-standard),
                        opacity 0.15s ease;
        }

        .tactile-btn:hover {
            transform: translateY(-1px) scale(1.018);
        }

        .tactile-btn:active {
            transform: scale(0.94) !important;
        }

        /* Smooth scrollbar ultra discrète */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.16); border-radius: 9999px; }
        html:not(.dark) ::-webkit-scrollbar-thumb { background: rgba(0, 0, 0, 0.16); }

        /* Styles spécifiques aux 3 modes */
        body.style-messaging #sidebar { display: none !important; }
        body.style-messaging #header-messaging { display: flex !important; }
        body.style-messaging #header-perplexity { display: none !important; }
        body.style-messaging #header-chatgpt { display: none !important; }
        body.style-messaging .bubble-user {
            background-color: #18181b;
            color: #ffffff;
            border-bottom-right-radius: 6px !important;
        }
        body.style-messaging .bubble-assistant {
            border-bottom-left-radius: 6px !important;
        }

        body.style-perplexity #sidebar { display: none !important; }
        body.style-perplexity #header-messaging { display: none !important; }
        body.style-perplexity #header-perplexity { display: flex !important; }
        body.style-perplexity #header-chatgpt { display: none !important; }
        body.style-perplexity .search-hub-banner { display: block !important; }

        body.style-chatgpt #sidebar { display: flex !important; }
        body.style-chatgpt #header-messaging { display: none !important; }
        body.style-chatgpt #header-perplexity { display: none !important; }
        body.style-chatgpt #header-chatgpt { display: flex !important; }

        /* Mode Sheet Mobile iOS 27 */
        @media (max-width: 640px) {
            .ios-sheet-modal {
                border-bottom-left-radius: 0 !important;
                border-bottom-right-radius: 0 !important;
                border-top-left-radius: 32px !important;
                border-top-right-radius: 32px !important;
                max-height: 90vh;
                margin-top: auto;
            }
        }
    
/* ======================================================== */
/* NIMBUS UI · LIQUID GLASS NAVBAR ("WATERLINE")            */
/* ======================================================== */
.nimbus-nav {
  --n-tint: rgba(255, 255, 255, 0.18);
  --n-fg: #0B132B;
  --n-fg-soft: rgba(11, 19, 43, 0.65);
  --n-rim: rgba(255, 255, 255, 0.75);
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  padding: 6px;
  border-radius: 999px;

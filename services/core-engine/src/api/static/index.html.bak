        }



        async function saveAllSettings() {

            const keyInput = document.getElementById('api-key-input').value.trim();

            if (keyInput) {

                await fetch('/api/settings/api-key', {

                    method: 'POST',

                    headers: { 'Content-Type': 'application/json' },

                    body: JSON.stringify({ api_key: keyInput })

                });

            }

            closeSettingsModal();

        }



        function scrollToBottom() {

            const container = document.getElementById('chat-messages');

            container.scrollTop = container.scrollHeight;

        }



        function escapeHtml(string) {

            const entityMap = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' };

            return String(string).replace(/[&<>"']/g, s => entityMap[s]);

        }



        // =========================================================================

        // MOTEUR AUDIO JARVIS : MUSIQUE CINÉMATIQUE, DUCKING & SYNTHÈSE VOCALE

        // =========================================================================

        let jarvisAudioCtx = null;

        let jarvisMusicGain = null;

        let jarvisOscillators = [];

        let isJarvisSpeaking = false;

        let jarvisSpeechSynth = window.speechSynthesis;

        let jarvisCurrentUtterance = null;

        let jarvisClockInterval = null;

        let visualizerInterval = null;



        // 1. Musique d'Intro Cinématique Héroïque (Générée à la volée en Web Audio API)

        function playCinematicMusic() {

            try {

                if (!jarvisAudioCtx) {

                    jarvisAudioCtx = new (window.AudioContext || window.webkitAudioContext)();

                }

                if (jarvisAudioCtx.state === 'suspended') {

                    jarvisAudioCtx.resume();

                }



                // Arrêter la musique précédente si elle jouait

                stopCinematicMusic();



                const now = jarvisAudioCtx.currentTime;

                jarvisMusicGain = jarvisAudioCtx.createGain();

                jarvisMusicGain.gain.setValueAtTime(0.001, now);

                // Montée progressive du volume (Fade in majestueux)

                jarvisMusicGain.gain.exponentialRampToValueAtTime(0.22, now + 1.2);

                jarvisMusicGain.connect(jarvisAudioCtx.destination);



                // Accord Cinématique Spatial Dm9 (D3, F3, A3, C4, E4)

                const freqs = [146.83, 174.61, 220.00, 261.63, 329.63];

                jarvisOscillators = freqs.map((freq, idx) => {

                    const osc = jarvisAudioCtx.createOscillator();

                    const oscGain = jarvisAudioCtx.createGain();

                    const filter = jarvisAudioCtx.createBiquadFilter();



                    osc.type = idx % 2 === 0 ? 'sine' : 'triangle';

                    osc.frequency.setValueAtTime(freq, now);



                    // Balayage doux du filtre passe-bas pour un son chaud et immersif

                    filter.type = 'lowpass';

                    filter.frequency.setValueAtTime(450 + idx * 120, now);

                    filter.Q.setValueAtTime(1.5, now);



                    oscGain.gain.setValueAtTime(0.06, now);



                    osc.connect(filter);

                    filter.connect(oscGain);

                    oscGain.connect(jarvisMusicGain);

                    osc.start(now);

                    return osc;

                });

            } catch (err) {

                console.warn("Musique Web Audio non initialisée :", err);

            }

        }



        // 2. Audio Ducking Automatique (Le volume baisse quand Jarvis parle, remonte à la fin)

        function setMusicDucking(isDucking) {

            if (!jarvisMusicGain || !jarvisAudioCtx) return;

            try {

                const now = jarvisAudioCtx.currentTime;

                jarvisMusicGain.gain.cancelScheduledValues(now);

                if (isDucking) {

                    // Baisse le volume de la musique à 0.04 en 0.3s

                    jarvisMusicGain.gain.linearRampToValueAtTime(0.04, now + 0.3);

                } else {

                    // Remonte doucement à 0.20

                    jarvisMusicGain.gain.linearRampToValueAtTime(0.20, now + 0.8);

                    // Fondu de sortie progressif au bout de 4 secondes

                    jarvisMusicGain.gain.linearRampToValueAtTime(0.001, now + 5.0);

                    setTimeout(stopCinematicMusic, 5200);

                }

            } catch (e) {}

        }



        function stopCinematicMusic() {

            if (jarvisOscillators.length > 0) {

                jarvisOscillators.forEach(osc => {

                    try { osc.stop(); osc.disconnect(); } catch (e) {}

                });

                jarvisOscillators = [];

            }

        }



        // 3. Déclenchement du Mode Jarvis Plein Écran (Double Clap ou Clic ou Espace)

        async function triggerJarvisMode() {

            const overlay = document.getElementById('jarvis-hud-overlay');

            if (!overlay) return;



            // Passer en plein écran dans le navigateur si supporté

            try {

                if (!document.fullscreenElement && document.documentElement.requestFullscreen) {

                    document.documentElement.requestFullscreen().catch(() => {});

                }

            } catch (e) {}



            overlay.classList.remove('hidden');

            overlay.classList.add('flex');



            // Démarrage immédiat de l'horloge et de la musique d'ambiance

            startJarvisClock();

            playCinematicMusic();



            const transcriptEl = document.getElementById('hud-live-transcript');

            const statusBadge = document.getElementById('jarvis-status-badge');

            const stateBadge = document.getElementById('speech-state-badge');



            if (transcriptEl) transcriptEl.innerHTML = `<em>Chargement des données en direct (Météo, E-mails, Agenda, Stripe, Colis)...</em>`;

            if (statusBadge) statusBadge.innerText = 'Synchronisation';

            if (stateBadge) stateBadge.innerText = '⚡ Analyse';



            // Appel de l'API de briefing

            try {

                const res = await fetch('/api/jarvis/briefing');

                const data = await res.json();



                // Mise à jour visuelle des tuiles holographiques

                updateHudTiles(data);



                // Lancement de la voix parlée

                const spokenText = data.spoken_script || "Bonjour ! Voici votre briefing quotidien complet.";

                speakJarvisScript(spokenText);

            } catch (err) {

                console.error("Erreur briefing Jarvis :", err);

                const fallbackScript = "Sbah lkhir khouya ! Allez debout, c'est l'heure de briller et de faire rentrer le cash ! Côté météo à Paris on a environ 19 degrés. Dans ta boîte mail, tu as deux e-mails urgents en attente. Côté business, Stripe affiche déjà 1 240 euros ce matin, soit plus 18 pour cent par rapport à hier. Ton colis UPS arrive vers 14 h 30. T'es paré pour tout déchirer aujourd'hui, alors au boulot !";

                speakJarvisScript(fallbackScript);

            }

        }



        // 4. Synthèse Vocale Native (100% Gratuite, ultra-rapide et locale)

        function speakJarvisScript(fullText) {

            if (!jarvisSpeechSynth) return;

            jarvisSpeechSynth.cancel();



            const sentences = fullText.match(/[^.!?]+[.!?]+/g) || [fullText];

            let currentIdx = 0;



            const transcriptEl = document.getElementById('hud-live-transcript');

            const statusBadge = document.getElementById('jarvis-status-badge');

            const stateBadge = document.getElementById('speech-state-badge');



            function speakNextSentence() {

                if (currentIdx >= sentences.length) {

                    // Fin du discours

                    isJarvisSpeaking = false;

                    setMusicDucking(false);

                    animateReactorVisualizer(false);

                    if (statusBadge) statusBadge.innerText = 'Terminé';

                    if (stateBadge) stateBadge.innerText = '✅ Prêt';

                    return;

                }



                const sentence = sentences[currentIdx].trim();

                currentIdx++;

                if (!sentence) {

                    speakNextSentence();

                    return;

                }



                if (transcriptEl) {

                    transcriptEl.innerHTML = `<span class="text-neutral-300 font-bold">❝</span> ${escapeHtml(sentence)} <span class="text-neutral-300 font-bold">❞</span>`;

                }



                const utterance = new SpeechSynthesisUtterance(sentence);

                utterance.lang = 'fr-FR';

                utterance.rate = 1.05;

                utterance.pitch = 1.02;



                // Sélection de la meilleure voix française disponible

                const voices = jarvisSpeechSynth.getVoices();

                const frVoice = voices.find(v => v.lang.startsWith('fr') && (v.name.includes('Google') || v.name.includes('Natural') || v.name.includes('Paul') || v.name.includes('Julie') || v.name.includes('Amélie') || v.name.includes('Thomas'))) 

                             || voices.find(v => v.lang.startsWith('fr'));

                if (frVoice) utterance.voice = frVoice;



                utterance.onstart = () => {

                    isJarvisSpeaking = true;

                    setMusicDucking(true);

                    animateReactorVisualizer(true);

                    if (statusBadge) statusBadge.innerText = 'En parole';

                    if (stateBadge) stateBadge.innerText = '🔊 Voix Active';

                };



                utterance.onend = () => {

                    speakNextSentence();

                };



                utterance.onerror = () => {

                    speakNextSentence();

                };



                jarvisCurrentUtterance = utterance;

                jarvisSpeechSynth.speak(utterance);

            }



            speakNextSentence();

        }



        function stopJarvisAudio() {

            if (jarvisSpeechSynth) jarvisSpeechSynth.cancel();

            isJarvisSpeaking = false;

            setMusicDucking(false);

            animateReactorVisualizer(false);

            stopCinematicMusic();



            const statusBadge = document.getElementById('jarvis-status-badge');

            const stateBadge = document.getElementById('speech-state-badge');

            if (statusBadge) statusBadge.innerText = 'Arrêté';

            if (stateBadge) stateBadge.innerText = '⏹️ Muet';

        }



        function closeJarvisHud() {

            stopJarvisAudio();

            const overlay = document.getElementById('jarvis-hud-overlay');

            if (overlay) {

                overlay.classList.add('hidden');

                overlay.classList.remove('flex');

            }

            if (document.fullscreenElement && document.exitFullscreen) {

                document.exitFullscreen().catch(() => {});

            }

            if (jarvisClockInterval) clearInterval(jarvisClockInterval);

        }



        // 5. Horloge & Animation du Réacteur

        function startJarvisClock() {

            if (jarvisClockInterval) clearInterval(jarvisClockInterval);

            const clockEl = document.getElementById('jarvis-hud-clock');

            const updateClock = () => {

                const now = new Date();

                if (clockEl) clockEl.innerText = now.toLocaleTimeString('fr-FR');

            };

            updateClock();

            jarvisClockInterval = setInterval(updateClock, 1000);

        }



        function animateReactorVisualizer(active) {

            const bars = document.querySelectorAll('#audio-wave-bars span');

            const core = document.getElementById('arc-core');

            if (!active) {

                if (visualizerInterval) clearInterval(visualizerInterval);

                bars.forEach(b => b.style.height = '6px');

                if (core) core.style.transform = 'scale(1)';

                return;

            }



            if (visualizerInterval) clearInterval(visualizerInterval);

            visualizerInterval = setInterval(() => {

                bars.forEach(b => {

                    const h = Math.floor(Math.random() * 20) + 4;

                    b.style.height = `${h}px`;

                });

                if (core) {

                    const scale = 1 + (Math.random() * 0.08);

                    core.style.transform = `scale(${scale})`;

                }

            }, 80);

        }



        function updateHudTiles(data) {

            const w = data.weather || {};

            const m = data.metrics || {};

            const emails = data.emails || [];

            const sched = data.schedule || [];



            const tempEl = document.getElementById('tile-weather-temp');

            const cityEl = document.getElementById('tile-weather-city');

            const descEl = document.getElementById('tile-weather-desc');

            if (tempEl) tempEl.innerText = `${w.temperature_c || 19}°C`;

            if (cityEl) cityEl.innerText = `${w.city || 'Paris'} • ${w.condition || 'Ensoleillé'}`;

            if (descEl) descEl.innerText = `Vent ${w.wind_kmh || 12} km/h • Ciel dégagé`;



            const revEl = document.getElementById('tile-stripe-rev');

            const ordersEl = document.getElementById('tile-stripe-orders');

            if (revEl) revEl.innerText = `${m.today_revenue_eur || 1240.50} €`;

            if (ordersEl) ordersEl.innerText = `${m.orders_count || 14} commandes • Taux ${m.conversion_rate || '3.8%'}`;



            const emailCountEl = document.getElementById('tile-emails-count');

            const emailSumEl = document.getElementById('tile-emails-summary');

            if (emailCountEl) emailCountEl.innerText = `${emails.length} en attente`;

            if (emailSumEl && emails.length > 0) emailSumEl.innerText = emails[0].subject || 'Emails prioritaires';



            const schedEl = document.getElementById('tile-schedule-next');

            if (schedEl && sched.length > 0) schedEl.innerText = `${sched[0].time} • ${sched[0].title}`;

        }



        // =========================================================================

        // 6. DÉTECTEUR DE DOUBLE-CLAP DES MAINS (Règles strictes 06-guides d'Anthony)

        // =========================================================================

        let clapAudioCtx = null;

        let clapMediaStream = null;

        let clapAnalyserNode = null;

        let isClapActive = false;

        let firstClapTimestamp = 0;

        let detectedClapHits = 0;

        let applauseRejectionTimer = null;

        let clapCooldownActive = false;



        async function initClapDetector() {

            try {

                if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {

                    console.log("Microphone non supporté sur ce navigateur.");

                    updateClapBadgeUI(false);

                    return;

                }



                clapMediaStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });

                clapAudioCtx = new (window.AudioContext || window.webkitAudioContext)();

                const source = clapAudioCtx.createMediaStreamSource(clapMediaStream);

                clapAnalyserNode = clapAudioCtx.createAnalyser();

                clapAnalyserNode.fftSize = 512;

                source.connect(clapAnalyserNode);



                isClapActive = true;

                updateClapBadgeUI(true);

                runClapDetectionLoop();

            } catch (err) {

                console.log("Accès microphone non accordé (activation manuelle par bouton) :", err);

                updateClapBadgeUI(false);

            }

        }



        function toggleClapListening() {

            if (!isClapActive) {

                initClapDetector();

            } else {

                if (clapMediaStream) {

                    clapMediaStream.getTracks().forEach(t => t.stop());

                }

                isClapActive = false;

                updateClapBadgeUI(false);

            }

        }



        function updateClapBadgeUI(active) {

            const btnBadge = document.getElementById('clap-badge-btn');

            const hudToggleLabel = document.getElementById('hud-clap-label');

            const hudToggleDot = document.getElementById('hud-clap-dot');



            if (active) {

                if (btnBadge) {

                    btnBadge.innerText = '👏 Clap ON';

                    btnBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 font-mono font-bold';

                }

                if (hudToggleLabel) hudToggleLabel.innerText = '👂 Détecteur Clap : ACTIF';

                if (hudToggleDot) hudToggleDot.className = 'w-2 h-2 rounded-full bg-emerald-400 animate-ping';

            } else {

                if (btnBadge) {

                    btnBadge.innerText = '👏 Clap OFF';

                    btnBadge.className = 'text-[9px] px-1.5 py-0.5 rounded bg-slate-500/20 text-slate-400 font-mono';

                }

                if (hudToggleLabel) hudToggleLabel.innerText = '👂 Détecteur Clap : CLIQUEZ ICI';

                if (hudToggleDot) hudToggleDot.className = 'w-2 h-2 rounded-full bg-slate-400';

            }

        }



        function runClapDetectionLoop() {

            if (!isClapActive || !clapAnalyserNode) return;

            requestAnimationFrame(runClapDetectionLoop);



            // Règle d'or #1 d'Anthony : Sourd pendant qu'il parle !

            if (isJarvisSpeaking || clapCooldownActive) return;



            const freqData = new Uint8Array(clapAnalyserNode.frequencyBinCount);

            clapAnalyserNode.getByteFrequencyData(freqData);



            // Spectre de claquement sec : hautes fréquences (2 kHz - 8 kHz)

            let highFreqSum = 0;

            const startBin = 20;

            for (let i = startBin; i < freqData.length; i++) {

                highFreqSum += freqData[i];

            }

            const avgEnergy = highFreqSum / (freqData.length - startBin);



            // Seuil de détection du claquement de mains

            const ENERGY_SPIKE_THRESHOLD = 90;

            const now = Date.now();



            if (avgEnergy > ENERGY_SPIKE_THRESHOLD) {

                if (now - firstClapTimestamp < 120) return; // Anti-rebond millisecondes



                const timeSinceFirst = (now - firstClapTimestamp) / 1000;



                if (detectedClapHits === 0) {

                    // Premier clap détecté

                    detectedClapHits = 1;

                    firstClapTimestamp = now;



                    // Expiration si pas de deuxième clap dans les 0.75s

                    clearTimeout(applauseRejectionTimer);

                    applauseRejectionTimer = setTimeout(() => {

                        detectedClapHits = 0;

                    }, 750);

                } else if (detectedClapHits === 1) {

                    // Deuxième clap survenu entre 0.15s et 0.70s (Règle Anthony)

                    if (timeSinceFirst >= 0.14 && timeSinceFirst <= 0.72) {

                        detectedClapHits = 2;



                        // Règle d'or #2 d'Anthony : Rejet des applaudissements

                        // Si un 3e pic survient dans les 0.38s, ce sont des applaudissements -> on annule !

                        clearTimeout(applauseRejectionTimer);

                        applauseRejectionTimer = setTimeout(() => {

                            if (detectedClapHits === 2) {

                                // DOUBLE CLAP VALIDÉ !

                                console.log("👏 DOUBLE-CLAP DÉTECTÉ AVEC SUCCÈS !");

                                detectedClapHits = 0;

                                clapCooldownActive = true;

                                setTimeout(() => { clapCooldownActive = false; }, 2500); // 2.5s repos

                                triggerJarvisMode();

                            }

                        }, 380);

                    } else {

                        detectedClapHits = 0;

                    }

                } else {

                    // Plus de 2 claps -> applaudissements continus, rejeté !

                    detectedClapHits = 0;

                    clearTimeout(applauseRejectionTimer);

                }

            }

        }



        // 7. Écouteurs Clavier (Touche Espace pour réveiller Jarvis, Échap pour fermer)

        window.addEventListener('keydown', (e) => {

            const activeTag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';

            const isTyping = (activeTag === 'input' || activeTag === 'textarea' || document.activeElement.isContentEditable);



            // Espace pour lancer Jarvis (si pas en train de taper un message)

            if (e.code === 'Space' && !isTyping) {

                const hudOverlay = document.getElementById('jarvis-hud-overlay');

                if (hudOverlay && hudOverlay.classList.contains('hidden')) {

                    e.preventDefault();

                    triggerJarvisMode();

                }

            }



            // Échap pour fermer le plein écran

            if (e.key === 'Escape') {

                closeJarvisHud();

            }

        });



        // Initialisation vocale

        if ('speechSynthesis' in window) {

            window.speechSynthesis.onvoiceschanged = () => {

                window.speechSynthesis.getVoices();

            };

        }



        // Tenter d'activer le détecteur de clap au démarrage

        window.addEventListener('DOMContentLoaded', () => {

            // Activer après premier clic utilisateur pour contourner les restrictions AudioContext

            document.addEventListener('click', function initAudioOnce() {

                initClapDetector();

                document.removeEventListener('click', initAudioOnce);

            }, { once: true });

        });



        // Initialisation

        applyCurrentTheme();
        updateThinkingModeUI(currentThinkingLevel);

        setChatStyle(currentStyle);

    

        // --- GESTION DU MODAL ACCÈS MOBILE (APPLE LIQUID GLASS) ---
        async function refreshNetworkInfo() {
            try {
                const res = await fetch('/api/system/network-info');
                if (res.ok) {
                    const data = await res.json();
                    if (data && data.url) {
                        const urlEl = document.getElementById('phone-lan-url');
                        if (urlEl) urlEl.innerText = data.url;
                        const qrImg = document.getElementById('phone-qr-img');
                        if (qrImg) qrImg.src = '/qr_phone.png?t=' + Date.now();
                    }
                }
            } catch (e) {
                console.warn('Network info fetch:', e);
            }
        }

        function togglePhoneConnectModal() {
            const modal = document.getElementById('phone-connect-modal');
            if (!modal) return;
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                if (window.lucide) lucide.createIcons();
                refreshNetworkInfo();
            } else {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        async function copyPhoneUrl() {
            const urlEl = document.getElementById('phone-lan-url');
            const url = urlEl ? urlEl.innerText.trim() : window.location.href;
            try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(url);
                } else {
                    throw new Error('Clipboard API non disponible');
                }
            } catch (e) {
                const textarea = document.createElement('textarea');
                textarea.value = url;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.select();
                try { document.execCommand('copy'); } catch (_) {}
                document.body.removeChild(textarea);
            }
            const copyBtn = document.getElementById('phone-copy-btn');
            if (copyBtn) {
                const origContent = copyBtn.innerHTML;
                copyBtn.innerHTML = '<i data-lucide="check" class="w-3.5 h-3.5 text-black"></i><span>Copié !</span>';
                if (window.lucide) lucide.createIcons();
                setTimeout(() => {
                    copyBtn.innerHTML = origContent;
                    if (window.lucide) lucide.createIcons();
                }, 2000);
            }
        }



    </script>



    <!-- MODAL ACCÈS SMARTPHONE (DESIGN APPLE LIQUID GLASS ÉPURÉ) -->
    <div id="phone-connect-modal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-xl hidden items-center justify-center p-4 transition-all duration-300" onclick="if(event.target === this) togglePhoneConnectModal()">
        <div class="w-full max-w-sm rounded-[28px] ios-sheet-modal liquid-glass border border-white/15 p-6 text-white text-center space-y-4 shadow-2xl relative select-none">
            <button onclick="togglePhoneConnectModal()" class="tactile-btn absolute top-4 right-4 w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-neutral-300 hover:text-white flex items-center justify-center transition" title="Fermer">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>

            <!-- Icône Smartphone Apple Liquid Glass -->
            <div class="w-12 h-12 rounded-2xl liquid-glass-subtle flex items-center justify-center mx-auto border border-white/15 text-white shadow-sm">
                <i data-lucide="smartphone" class="w-6 h-6 stroke-[1.75]"></i>
            </div>

            <div>
                <h3 class="text-base font-semibold text-white tracking-tight">Accès Mobile</h3>
                <p class="text-xs text-neutral-400 mt-1">Scannez le QR code avec votre smartphone</p>
            </div>

            <!-- Conteneur QR Code Liquid Glass avec QR Code monochrome Apple -->
            <div class="p-3.5 rounded-2xl liquid-glass border border-white/10 inline-block shadow-lg mx-auto bg-black/40">
                <img id="phone-qr-img" src="/qr_phone.png" alt="Scanner pour ouvrir sur smartphone" class="w-48 h-48 rounded-xl object-contain mx-auto transition-transform hover:scale-[1.02] duration-300">
            </div>

            <!-- Lien direct et bouton copier neutre Apple -->
            <div class="space-y-2 text-left">
                <div class="text-[11px] text-neutral-400 text-center font-medium">Ou ouvrez directement dans votre navigateur :</div>
                <div class="flex items-center justify-between liquid-glass-subtle px-3 py-2 rounded-xl border border-white/10 font-mono text-xs text-neutral-200">
                    <span id="phone-lan-url" class="truncate mr-2 select-all font-mono text-xs text-neutral-300">http://192.168.1.80:8000</span>
                    <button id="phone-copy-btn" onclick="copyPhoneUrl()" class="tactile-btn flex-shrink-0 px-3 py-1.5 rounded-lg bg-white text-black hover:bg-neutral-200 font-semibold text-[11px] transition flex items-center space-x-1.5 shadow-sm">
                        <i data-lucide="copy" class="w-3 h-3"></i>
                        <span>Copier</span>
                    </button>
                </div>
            </div>

            <div class="text-[11px] text-neutral-400 pt-1 border-t border-white/5 flex items-center justify-center space-x-2">
                <span>Réseau Wi-Fi local</span>
                <span>•</span>
                <span>iOS & Android</span>
            </div>
        </div>
    </div>



    <!-- MODAL COMPUTER-USE LIVE STREAM & TAKE OVER (META MUSE PARITY) -->

    <div id="computer-use-modal" class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md flex items-center justify-center p-2 sm:p-4 animate-in fade-in duration-200">

        <div class="relative w-full max-w-5xl liquid-glass rounded-3xl ios-sheet-modal border border-white/15 shadow-2xl overflow-hidden flex flex-col max-h-[95vh]">

            <!-- Header du Stream -->

            <div class="p-3.5 bg-white/5 border-b border-white/10 flex items-center justify-between flex-wrap gap-2.5">

                <div class="flex items-center space-x-2">

                    <span class="w-2.5 h-2.5 rounded-full bg-white animate-ping"></span>

                    <span class="font-bold text-white text-xs sm:text-sm flex items-center space-x-1.5">

                        <span>🌐</span>

                        <span>Computer-Use Live : Chromium CDP Stream</span>

                    </span>

                    <span id="cu-mode-badge" class="px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-neutral-300 font-mono text-[10px] font-bold border border-white/15">

                        🤖 MODE IA SPECTATEUR

                    </span>

                </div>

                <!-- Barre d'URL & Contrôles avec largeur garantie -->

                <div class="flex items-center space-x-2 flex-1 min-w-[220px] sm:min-w-[320px] max-w-lg mx-1 sm:mx-2">

                    <input id="cu-url-input" type="text" placeholder="https://..." class="w-full bg-black/60 px-3 py-1.5 rounded-xl border border-white/10 text-neutral-300 font-mono text-xs focus:outline-none focus:border-white/15" value="https://www.google.fr" onkeydown="if(event.key==='Enter') navigateComputerUse();">

                    <button onclick="navigateComputerUse()" class="px-3 py-1.5 rounded-xl bg-white text-black hover:bg-neutral-200 text-white text-xs font-bold transition shadow-sm">Aller</button>

                </div>

                <!-- Boutons d'Action Principaux -->

                <div class="flex items-center space-x-2">

                    <button id="cu-takeover-btn" onclick="toggleTakeOverMode()" class="px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-black font-bold text-xs shadow-lg shadow-amber-500/20 transition flex items-center space-x-1">

                        <i data-lucide="gamepad-2" class="w-3.5 h-3.5 inline text-neutral-400"></i>

                        <span>Take Over</span>

                    </button>

                    <button onclick="emergencyStopComputerUse()" class="px-3 py-1.5 rounded-xl bg-rose-600/30 hover:bg-rose-600 text-rose-300 hover:text-white font-bold text-xs border border-rose-500/40 transition">

                        🛑 Stop

                    </button>

                    <button onclick="closeComputerUseModal()" class="w-8 h-8 rounded-xl bg-white/5 hover:bg-white/10 text-slate-400 hover:text-white flex items-center justify-center font-bold text-sm transition">

                        ✕

                    </button>

                </div>

            </div>



            <!-- Viewport Canvas avec Screencast CDP & Curseur IA -->

            <div id="cu-viewport-container" class="relative flex-1 bg-black overflow-hidden flex items-center justify-center p-1 sm:p-2 min-h-[380px] sm:min-h-[500px]">

                <canvas id="cu-screencast-canvas" width="1280" height="800" class="w-full h-auto max-h-[75vh] object-contain rounded-xl border border-white/5 shadow-2xl select-none"></canvas>

                

                <!-- Loader d'initialisation & synchronisation vidéo -->

                <div id="cu-loading-overlay" class="absolute inset-0 bg-black/90 flex flex-col items-center justify-center space-y-4 p-6 z-10 transition-opacity duration-300">

                    <div class="relative w-16 h-16 flex items-center justify-center">

                        <div class="absolute inset-0 rounded-full border-4 border-white/15 animate-ping"></div>

                        <div class="w-12 h-12 rounded-full border-4 border-cyan-400 border-t-transparent animate-spin"></div>

                        <span class="absolute text-xl">🌐</span>

                    </div>

                    <div class="text-center space-y-1.5 max-w-sm">

                        <p id="cu-loader-title" class="text-white font-bold text-sm tracking-wide">Démarrage du navigateur virtuel Chromium...</p>

                        <p id="cu-loader-sub" class="text-neutral-200/80 font-mono text-xs">Synchronisation du flux direct CDP (Chrome DevTools)</p>

                        <p class="text-slate-500 text-[11px]">Le flux vidéo s'affiche dès que la page est chargée</p>

                    </div>

                </div>



                <!-- Curseur Virtuel IA Lumineux -->

                <div id="cu-virtual-cursor" class="pointer-events-none absolute w-5 h-5 rounded-full border-2 border-cyan-400 bg-cyan-400/30 shadow-lg shadow-cyan-400/80 -translate-x-1/2 -translate-y-1/2 transition-all duration-75 flex items-center justify-center hidden" style="top: 50%; left: 50%;">

                    <div class="w-1.5 h-1.5 rounded-full bg-cyan-200"></div>

                </div>

            </div>



            <!-- Footer / Status Bar -->

            <div class="p-2.5 bg-[#121216] border-t border-white/10 flex items-center justify-between text-[11px] font-mono text-slate-400">

                <div class="flex items-center space-x-2 truncate">

                    <span id="cu-status-dot" class="text-amber-400 font-bold animate-pulse">● Connexion...</span>

                    <span id="cu-status-text" class="text-slate-300 truncate">Initialisation de la session</span>

                </div>

                <div class="flex items-center space-x-3 text-[10px] text-slate-500">

                    <span>CDP 30 FPS</span>

                    <span>1280x800</span>

                    <span class="text-neutral-200">HoL AI Virtual Engine</span>

                </div>

            </div>

        </div>

    </div>



    <!-- SCRIPT DE GESTION DU COMPUTER-USE ET WEBSOCKET STREAMING -->

    <script>

        let cuWebSocket = null;

        let cuIsTakeOver = false;

        const cuModal = document.getElementById('computer-use-modal');

        const cuCanvas = document.getElementById('cu-screencast-canvas');

        const cuCtx = cuCanvas ? cuCanvas.getContext('2d') : null;

        const cuCursor = document.getElementById('cu-virtual-cursor');

        const cuUrlInput = document.getElementById('cu-url-input');

        const cuModeBadge = document.getElementById('cu-mode-badge');

        const cuTakeOverBtn = document.getElementById('cu-takeover-btn');

        const cuStatusText = document.getElementById('cu-status-text');



        const cuStatusDot = document.getElementById('cu-status-dot');

        const cuLoadingOverlay = document.getElementById('cu-loading-overlay');

        const cuLoaderTitle = document.getElementById('cu-loader-title');



        function openComputerUseModal(initialUrl) {

            if (initialUrl && cuUrlInput) cuUrlInput.value = initialUrl;

            if (cuModal) cuModal.classList.remove('hidden');

            if (cuLoadingOverlay) cuLoadingOverlay.classList.remove('hidden');

            initComputerUseWebSocket();

        }



        function closeComputerUseModal() {

            if (cuModal) cuModal.classList.add('hidden');

        }



        function initComputerUseWebSocket() {

            if (cuWebSocket && cuWebSocket.readyState === WebSocket.OPEN) return;

            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';

            const wsUrl = `${protocol}//${window.location.host}/ws/browser-stream`;

            

            if (cuStatusDot) {

                cuStatusDot.innerText = "● Connexion...";

                cuStatusDot.className = "text-amber-400 font-bold animate-pulse";

            }



            cuWebSocket = new WebSocket(wsUrl);



            cuWebSocket.onopen = function() {

                if (cuStatusDot) {

                    cuStatusDot.innerText = "● Connecté";

                    cuStatusDot.className = "text-emerald-400 font-bold";

                }

            };



            cuWebSocket.onmessage = function(event) {

                try {

                    const data = JSON.parse(event.data);



                    if (data.type === 'status_update') {

                        if (data.status && cuStatusText) cuStatusText.innerText = data.status;

                        if (data.loading && cuLoadingOverlay) {

                            cuLoadingOverlay.classList.remove('hidden');

                            if (cuLoaderTitle && data.status) cuLoaderTitle.innerText = data.status;

                        } else if (!data.loading && cuLoadingOverlay) {

                            cuLoadingOverlay.classList.add('hidden');

                        }

                    }



                    if (data.type === 'screencast_frame' && data.frame) {

                        // Masquer immédiatement le loader dès réception d'une trame

                        if (cuLoadingOverlay) cuLoadingOverlay.classList.add('hidden');

                        if (cuCursor) cuCursor.classList.remove('hidden');

                        if (cuStatusDot) {

                            cuStatusDot.innerText = "● Connecté";

                            cuStatusDot.className = "text-emerald-400 font-bold";

                        }



                        const img = new Image();

                        img.onload = function() {

                            if (cuCtx) {

                                cuCtx.drawImage(img, 0, 0, cuCanvas.width, cuCanvas.height);

                            }

                        };

                        img.src = 'data:image/jpeg;base64,' + data.frame;



                        if (data.cursor && cuCursor && cuCanvas) {

                            const canvasRect = cuCanvas.getBoundingClientRect();

                            const containerRect = cuCanvas.parentElement.getBoundingClientRect();

                            const scaleX = canvasRect.width / cuCanvas.width;

                            const scaleY = canvasRect.height / cuCanvas.height;

                            const curLeft = (canvasRect.left - containerRect.left) + data.cursor.x * scaleX;

                            const curTop = (canvasRect.top - containerRect.top) + data.cursor.y * scaleY;

                            cuCursor.style.left = `${curLeft}px`;

                            cuCursor.style.top = `${curTop}px`;

                        }



                        if (data.url && cuUrlInput && document.activeElement !== cuUrlInput) {

                            cuUrlInput.value = data.url;

                        }

                        if (data.status && cuStatusText) {

                            cuStatusText.innerText = data.status;

                        }

                    }

                } catch(e) {

                    console.error("Erreur frame screencast:", e);

                }

            };



            cuWebSocket.onerror = function() {

                if (cuStatusDot) {

                    cuStatusDot.innerText = "✕ Erreur flux";

                    cuStatusDot.className = "text-rose-400 font-bold";

                }

            };



            cuWebSocket.onclose = function() {

                if (cuStatusDot) {

                    cuStatusDot.innerText = "● Déconnecté";

                    cuStatusDot.className = "text-amber-400 font-bold";

                }

                if (cuStatusText) cuStatusText.innerText = "Stream déconnecté. Reconnexion...";

                setTimeout(initComputerUseWebSocket, 3000);

            };

        }



        function toggleTakeOverMode() {

            cuIsTakeOver = !cuIsTakeOver;

            if (cuIsTakeOver) {

                cuModeBadge.className = "px-2.5 py-0.5 rounded-full bg-amber-500/20 text-amber-300 font-mono text-[10px] font-bold border border-amber-500/30";

                cuModeBadge.innerText = "🎮 CONTRÔLE HUMAIN (TAKE OVER)";

                cuTakeOverBtn.className = "px-3.5 py-1.5 rounded-xl bg-white text-black hover:bg-neutral-200 text-white font-bold text-xs shadow-lg transition flex items-center space-x-1";

                cuTakeOverBtn.innerHTML = "<span>🤖</span><span>Rendre la main à l'IA</span>";

                cuCanvas.style.cursor = "pointer";

                sendCuAction({ type: "set_mode", mode: "human_takeover" });

            } else {

                cuModeBadge.className = "px-2.5 py-0.5 rounded-full bg-cyan-500/20 text-neutral-300 font-mono text-[10px] font-bold border border-white/15";

                cuModeBadge.innerText = "MODE IA SPECTATEUR";

                cuTakeOverBtn.className = "px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-black font-bold text-xs shadow-lg shadow-amber-500/20 transition flex items-center space-x-1";

                cuTakeOverBtn.innerHTML = '<i data-lucide="gamepad-2" class="w-3.5 h-3.5 inline text-neutral-400"></i><span>Take Over (Prendre la main)</span>';

                cuCanvas.style.cursor = "default";

                sendCuAction({ type: "set_mode", mode: "ai_autonomous" });

            }

        }



        function sendCuAction(payload) {

            if (cuWebSocket && cuWebSocket.readyState === WebSocket.OPEN) {

                cuWebSocket.send(JSON.stringify(payload));

            }

        }



        function navigateComputerUse() {

            const url = cuUrlInput.value.trim();

            if (url) {

                sendCuAction({ type: "navigate", url: url });

            }

        }



        function emergencyStopComputerUse() {

            sendCuAction({ type: "emergency_stop" });

            if (cuStatusText) cuStatusText.innerText = "Arrêt d'urgence envoyé.";

        }



        if (cuCanvas) {

            cuCanvas.addEventListener('click', function(e) {

                if (!cuIsTakeOver) return;

                const rect = cuCanvas.getBoundingClientRect();

                const scaleX = cuCanvas.width / rect.width;

                const scaleY = cuCanvas.height / rect.height;

                const x = (e.clientX - rect.left) * scaleX;

                const y = (e.clientY - rect.top) * scaleY;

                sendCuAction({ type: "mouse_click", x: Math.round(x), y: Math.round(y), button: "left" });

            });



            cuCanvas.addEventListener('mousemove', function(e) {

                if (!cuIsTakeOver) return;

                const rect = cuCanvas.getBoundingClientRect();

                const scaleX = cuCanvas.width / rect.width;

                const scaleY = cuCanvas.height / rect.height;

                const x = (e.clientX - rect.left) * scaleX;

                const y = (e.clientY - rect.top) * scaleY;

                sendCuAction({ type: "mouse_move", x: Math.round(x), y: Math.round(y) });

            });



            cuCanvas.addEventListener('wheel', function(e) {

                if (!cuIsTakeOver) return;

                e.preventDefault();

                sendCuAction({ type: "scroll", dy: e.deltaY });

            }, { passive: false });



            window.addEventListener('keydown', function(e) {

                if (!cuIsTakeOver || cuModal.classList.contains('hidden')) return;

                if (document.activeElement === cuUrlInput) return;

                if (e.key.length === 1) {

                    sendCuAction({ type: "type_text", text: e.key });

                } else if (['Enter', 'Backspace', 'Tab', 'Escape', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {

                    sendCuAction({ type: "key_down", key: e.key });

                }

            });

        }

    </script>



    <script>

        function switchMetaMuseSpace(spaceName) {

            document.querySelectorAll('.space-tab-btn').forEach(btn => {

                btn.className = "space-tab-btn px-2.5 py-1 rounded-lg font-medium text-xs text-slate-400 hover:text-white hover:bg-white/5 flex items-center space-x-1 transition";

            });

            const activeBtn = document.getElementById(`space-${spaceName}-btn`);

            if (activeBtn) {

                activeBtn.className = "space-tab-btn px-2.5 py-1 rounded-lg font-bold text-xs bg-white/10 text-neutral-300 border border-white/15 flex items-center space-x-1 transition";

            }

            if (spaceName === 'goals') {

                const msgInput = document.getElementById('chat-input') || document.querySelector('input[type="text"]');

                if (msgInput) {

                    msgInput.value = "Affiche mes objectifs en cours et mon avancement";

                    if (typeof sendMessage === 'function') sendMessage();

                }

            } else if (spaceName === 'ideas') {

                const msgInput = document.getElementById('chat-input') || document.querySelector('input[type="text"]');

                if (msgInput) {

                    msgInput.value = "Donne-moi 3 idées proactives pour optimiser mes dépenses et ma journée";

                    if (typeof sendMessage === 'function') sendMessage();

                }

            } else if (spaceName === 'artifacts') {

                const msgInput = document.getElementById('chat-input') || document.querySelector('input[type="text"]');

                if (msgInput) {

                    msgInput.value = "Montre-moi la liste des artefacts générés";

                    if (typeof sendMessage === 'function') sendMessage();

                }

            }

        }

    </script>

</body>

</html>


            'file-text': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>',
            'pen-tool': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="m12 19 7-7 3 3-7 7-3-3z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><circle cx="11" cy="11" r="2"/></svg>',
            'smartphone': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>',
            'shield': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.8 17 5 19 5a1 1 0 0 1 1 1z"/></svg>',
            'message-square': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
            'cloud-sun': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M12 2v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="M20 12h2"/><path d="m19.07 4.93-1.41 1.41"/><path d="M15.947 12.65a4 4 0 0 0-5.925-4.128"/><path d="M13 22H7a5 5 0 1 1 4.9-6H13a3 3 0 0 1 0 6Z"/></svg>',
            'credit-card': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>',
            'trending-up': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>',
            'mail': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>',
            'calendar': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/></svg>',
            'truck': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18.5" r="2.5"/><circle cx="7" cy="18.5" r="2.5"/></svg>',
            'target': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>',
            'check': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M20 6 9 17l-5-5"/></svg>',
            'refresh-cw': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>',
            'tag': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>',
            'star': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
            'shield-check': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.8 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>',
            'external-link': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>',
            'gamepad-2': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline w-full h-full"><line x1="6" x2="10" y1="12" y2="12"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="15" x2="15.01" y1="13" y2="13"/><line x1="18" x2="18.01" y1="11" y2="11"/><rect width="20" height="12" x="2" y="6" rx="2"/></svg>'
        };

        function lucideSafeRender(container = document) {
            if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') {
                try {
                    lucide.createIcons();
                } catch (e) {
                    console.warn("Lucide render error:", e);
                }
            } else if (window.lucide && typeof window.lucide.createIcons === 'function') {
                try {
                    window.lucide.createIcons({ root: container });
                } catch (e) {
                    console.warn("Window lucide render error:", e);
                }
            }
            // SVG fallback for offline or unpkg load delay
            const targets = container.querySelectorAll ? container.querySelectorAll('i[data-lucide]') : [];
            targets.forEach(el => {
                const iconName = el.getAttribute('data-lucide');
                if (FALLBACK_SVGS[iconName] && el.children.length === 0) {
                    const wrap = document.createElement('span');
                    wrap.className = el.className + ' inline-flex items-center justify-center';
                    wrap.innerHTML = FALLBACK_SVGS[iconName];
                    el.replaceWith(wrap);
                }
            });
        }

        window.addEventListener('DOMContentLoaded', () => {
            lucideSafeRender();
            if (typeof updateThinkingModeUI === 'function') {
                updateThinkingModeUI(currentThinkingLevel);
            }
        });

        
        // --- DYNAMIQUE OPTIQUE DE FRESNEL (Interactive Cursor/Touch Tracking) ---
        function updateGlassCoords(clientX, clientY) {
            const glassElements = document.querySelectorAll('.liquid-glass, .liquid-glass-regular, .liquid-glass-dock, .liquid-glass-subtle');
            glassElements.forEach(el => {
                const rect = el.getBoundingClientRect();
                if (clientX >= rect.left - 50 && clientX <= rect.right + 50 &&
                    clientY >= rect.top - 50 && clientY <= rect.bottom + 50) {
                    const x = clientX - rect.left;
                    const y = clientY - rect.top;
                    el.style.setProperty('--mouse-x', `${x}px`);
                    el.style.setProperty('--mouse-y', `${y}px`);
                }
            });
        }

        document.addEventListener('mousemove', (e) => {
            updateGlassCoords(e.clientX, e.clientY);
        }, { passive: true });

        document.addEventListener('touchstart', (e) => {
            if (e.touches && e.touches[0]) {
                updateGlassCoords(e.touches[0].clientX, e.touches[0].clientY);
            }
        }, { passive: true });

        document.addEventListener('touchmove', (e) => {
            if (e.touches && e.touches[0]) {
                updateGlassCoords(e.touches[0].clientX, e.touches[0].clientY);
            }
        }, { passive: true });

        // État de session

        
        // --- GESTION DU MODE DE RÉFLEXION / REASONING (FLASH, STANDARD, DEEP, ULTRA) ---
        let currentThinkingLevel = localStorage.getItem('hol_thinking_level') || 'standard';

        function toggleThinkingMenu(e) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const menu = document.getElementById('thinking-menu-dropdown');
            if (menu) menu.classList.toggle('hidden');
        }

        document.addEventListener('click', function(e) {
            const menu = document.getElementById('thinking-menu-dropdown');
            const btn = document.getElementById('thinking-mode-btn');
            if (menu && !menu.classList.contains('hidden')) {
                if (!menu.contains(e.target) && !btn.contains(e.target)) {
                    menu.classList.add('hidden');
                }
            }
        });

        function selectThinkingLevel(level) {
            currentThinkingLevel = level;
            localStorage.setItem('hol_thinking_level', level);
            updateThinkingModeUI(level);
            const menu = document.getElementById('thinking-menu-dropdown');
            if (menu) menu.classList.add('hidden');
        }

        function updateThinkingModeUI(level) {
            const iconEl = document.getElementById('thinking-mode-icon');
            const labelEl = document.getElementById('thinking-mode-label');
            const hintEl = document.getElementById('thinking-hint-text');

            const config = {
                'fast': { icon: 'zap', color: 'text-amber-400', label: 'Flash / Rapide', hint: 'Flash (Vitesse maximale)' },
                'standard': { icon: 'brain', color: 'text-neutral-200', label: 'Mode Standard', hint: 'Standard (Équilibré)' },
                'deep': { icon: 'microscope', color: 'text-neutral-200', label: 'Deep Thinking', hint: 'Deep Thinking (Raisonnement poussé)' },
                'ultra': { icon: 'telescope', color: 'text-neutral-200', label: 'Ultra Research', hint: 'Ultra Research (Audit multi-sources)' }
            };

            const cfg = config[level] || config['standard'];
            if (iconEl) {
                iconEl.innerHTML = `<i data-lucide="${cfg.icon}" class="w-3.5 h-3.5 ${cfg.color}"></i>`;
            }
            if (labelEl) labelEl.textContent = cfg.label;
            if (hintEl) hintEl.textContent = cfg.hint;

            document.querySelectorAll('.thinking-opt-btn').forEach(btn => {
                const btnLevel = btn.getAttribute('data-level');
                if (btnLevel === level) {
                    btn.classList.add('bg-white/15', 'border', 'border-white/25');
                } else {
                    btn.classList.remove('bg-white/15', 'border', 'border-white/25');
                }
            });
            lucideSafeRender();
        }

        let currentSessionId = localStorage.getItem('musex_session_id') || ('sess_' + Math.random().toString(36).substring(2, 10));

        let chatConversationHistory = [];

        let pendingAttachmentData = null;

        let isAudioRecording = false;

        let speechRecognizer = null;



        // Styles & Thèmes

        let currentStyle = localStorage.getItem('musex_ui_style') || 'messaging';

        let currentTheme = localStorage.getItem('musex_ui_theme') || 'dark';



        function applyCurrentTheme() {
            const html = document.documentElement;
            const iconTop = document.getElementById('theme-icon-top');
            const btnDark = document.getElementById('theme-btn-dark');
            const btnLight = document.getElementById('theme-btn-light');

            if (currentTheme === 'light') {
                html.classList.remove('dark');
                if (iconTop) iconTop.innerHTML = '<i data-lucide="sun" class="w-4 h-4 text-amber-500"></i>';
                if (btnLight) { btnLight.classList.add('bg-white', 'text-black', 'border-white'); }
                if (btnDark) { btnDark.classList.remove('bg-white', 'text-black', 'border-white'); }
            } else {
                html.classList.add('dark');
                if (iconTop) iconTop.innerHTML = '<i data-lucide="moon" class="w-4 h-4 text-neutral-200"></i>';
                if (btnDark) { btnDark.classList.add('bg-white', 'text-black', 'border-white'); }
                if (btnLight) { btnLight.classList.remove('bg-white', 'text-black', 'border-white'); }
            }
            lucideSafeRender();
        }



        function toggleTheme() {

            currentTheme = currentTheme === 'dark' ? 'light' : 'dark';

            localStorage.setItem('musex_ui_theme', currentTheme);

            applyCurrentTheme();
        updateThinkingModeUI(currentThinkingLevel);

        }



        function setTheme(t) {

            currentTheme = t;

            localStorage.setItem('musex_ui_theme', currentTheme);

            applyCurrentTheme();
        updateThinkingModeUI(currentThinkingLevel);

        }



        function setChatStyle(styleName) {

            currentStyle = styleName;

            localStorage.setItem('musex_ui_style', currentStyle);

            

            document.body.classList.remove('style-messaging', 'style-perplexity', 'style-chatgpt');

            document.body.classList.add(`style-${styleName}`);



            // Mise à jour des boutons dans les paramètres

            const opts = ['messaging', 'perplexity', 'chatgpt'];

            opts.forEach(opt => {

                const b = document.getElementById(`style-opt-${opt}`);

                if (!b) return;

                if (opt === styleName) {

                    b.classList.add('bg-white', 'text-black', 'border-white');

                    b.classList.remove('border-slate-300', 'dark:border-white/10');

                } else {

                    b.classList.remove('bg-white', 'text-black', 'border-white');

                    b.classList.add('border-slate-300', 'dark:border-white/10');

                }

            });



            const input = document.getElementById('user-input');

            if (input) {

                if (styleName === 'perplexity') {

                    input.placeholder = "Poser une question ou rechercher un produit sur le web...";

                } else if (styleName === 'chatgpt') {

                    input.placeholder = "Envoyer un message à HoL AI...";

                } else {

                    input.placeholder = "Écrire un message à HoL AI...";

                }

            }

        }



        // --- ENVOI DE MESSAGES & STREAMING ---

        async function handleChatSubmit(e) {

            if (e) e.preventDefault();

            const input = document.getElementById('user-input');

            const message = input.value.trim();

            if (!message && !pendingAttachmentData) return;



            input.value = '';

            const attachedImg = pendingAttachmentData;

            cancelAttachment();



            // 1. Ajouter le message utilisateur dans l'interface

            appendUserMessage(message, attachedImg);

            chatConversationHistory.push({ role: 'user', content: message });



            // 2. Afficher l'indicateur de réflexion avec statut dynamique (comme Gemini / Claude / ChatGPT)

            const typingId = showTypingIndicator(message);

            const progressiveTimer = startProgressiveThinking(typingId, message);



            let streamedSuccess = false;

            try {

                const response = await fetch('/api/chat/stream', {

                    method: 'POST',

                    headers: { 'Content-Type': 'application/json' },

                    body: JSON.stringify({

                        message: message,

                        session_id: currentSessionId,

                        user_id: 'user_main',
                        thinking_level: currentThinkingLevel

                    })

                });



                if (response.ok && response.body) {

                    const reader = response.body.getReader();

                    const decoder = new TextDecoder();

                    let buffer = '';



                    while (true) {

                        const { value, done } = await reader.read();

                        if (done) break;

                        buffer += decoder.decode(value, { stream: true });



                        const lines = buffer.split('\n');

                        buffer = lines.pop();



                        for (const line of lines) {

                            const trimmed = line.trim();

                            if (!trimmed.startsWith('data:')) continue;

                            const jsonStr = trimmed.slice(5).trim();

                            if (!jsonStr) continue;



                            try {

                                const event = JSON.parse(jsonStr);

                                if (event.type === 'status') {

                                    clearInterval(progressiveTimer);

                                    updateTypingIndicator(typingId, event.text || event.status, event.step);

                                } else if (event.type === 'complete') {

                                    clearInterval(progressiveTimer);

                                    removeTypingIndicator(typingId);

                                    streamedSuccess = true;



                                    if (event.session_id) {

                                        currentSessionId = event.session_id;

                                        localStorage.setItem('musex_session_id', currentSessionId);

                                    }



                                    // Affichage en streaming progressif mot par mot

                                    appendAssistantMessage(event.reply, event.cards || [], event.thoughts, event.thinking_level);

                                    chatConversationHistory.push({ role: 'assistant', content: event.reply });

                                    break;

                                }

                            } catch (e) {

                                console.warn("Erreur parsing SSE event:", e);

                            }

                        }

                        if (streamedSuccess) break;

                    }

                }

            } catch (streamErr) {

                console.warn("Échec streaming SSE, tentative fallback sur /api/chat :", streamErr);

            }



            // Fallback classique si le streaming SSE n'a pas répondu

            if (!streamedSuccess) {

                try {

                    const response = await fetch('/api/chat', {

                        method: 'POST',

                        headers: { 'Content-Type': 'application/json' },

                        body: JSON.stringify({

                            message: message,

                            session_id: currentSessionId,

                            user_id: 'user_main',
                        thinking_level: currentThinkingLevel

                        })

                    });



                    const data = await response.json();

                    clearInterval(progressiveTimer);

                    removeTypingIndicator(typingId);



                    if (data.session_id) {

                        currentSessionId = data.session_id;

                        localStorage.setItem('musex_session_id', currentSessionId);

                    }



                    // Affichage en streaming progressif mot par mot

                    appendAssistantMessage(data.reply, data.cards || [], data.thoughts, data.thinking_level);

                    chatConversationHistory.push({ role: 'assistant', content: data.reply });



                } catch (err) {

                    clearInterval(progressiveTimer);

                    removeTypingIndicator(typingId);

                    appendAssistantMessage("Désolée, une erreur réseau est survenue avec le serveur. Réessaie dans un instant.", []);

                }

            }

        }



        function appendUserMessage(text, attachment = null) {

            const container = document.getElementById('chat-messages');

            const el = document.createElement('div');

            el.className = 'flex justify-end msg-animate';

            const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });



            let attachHtml = '';

            if (attachment) {

                attachHtml = `<div class="mb-2 rounded-xl overflow-hidden max-w-[220px] border border-white/20"><img src="${attachment}" class="w-full h-auto object-cover" /></div>`;

            }



            el.innerHTML = `

                <div class="bubble-user-glass max-w-[85%] sm:max-w-[75%] px-4 py-3 rounded-2xl rounded-tr-sm text-sm leading-relaxed">
                    ${attachHtml}
                    <div class="text-[13.5px] leading-relaxed font-normal">${escapeHtml(text)}</div>
                    <div class="text-[10px] text-neutral-400 text-right mt-1.5 font-mono tracking-tight flex items-center justify-end space-x-1">
                        <span>${timeStr}</span>
                        <span class="text-neutral-400 flex items-center"><i data-lucide="check-check" class="w-3.5 h-3.5"></i></span>
                    </div>
                </div>
            `;

            container.appendChild(el);
            lucideSafeRender(el);
            scrollToBottom();
            lucideSafeRender(el);

        }



        // --- GESTIONNAIRE D'INDICATEUR DE RÉFLEXION TYPE GEMINI / CLAUDE / CHATGPT ---

        const activeTypingTimers = new Map();



        function showTypingIndicator(initialUserMessage = '') {
            const container = document.getElementById('chat-messages');
            const id = 'typing-' + Date.now();
            const el = document.createElement('div');
            el.id = id;
            el.className = 'flex items-center space-x-3 msg-animate';

            el.innerHTML = `
                <div class="w-8 h-8 rounded-full apple-avatar flex-shrink-0 flex items-center justify-center text-xs font-bold text-white shadow-md animate-pulse">H</div>
                <div class="typing-bubble liquid-glass-subtle py-2.5 px-4 rounded-2xl rounded-tl-sm flex items-center space-x-2.5 text-sm transition-all duration-300">
                    <div class="flex items-center space-x-1.5 flex-shrink-0">
                        <span class="w-2 h-2 rounded-full bg-neutral-400 dark:bg-neutral-200 animate-bounce"></span>
                        <span class="w-2 h-2 rounded-full bg-neutral-400 dark:bg-neutral-200 animate-bounce" style="animation-delay: 0.15s"></span>
                        <span class="w-2 h-2 rounded-full bg-neutral-400 dark:bg-neutral-200 animate-bounce" style="animation-delay: 0.3s"></span>
                    </div>
                    <div class="h-3.5 w-px bg-white/10 mx-0.5"></div>
                    <div class="flex items-center space-x-1.5 min-w-0">
                        <span id="${id}-icon" class="flex items-center flex-shrink-0 transition-transform duration-200"><i data-lucide="brain" class="w-3.5 h-3.5 text-neutral-400 animate-pulse"></i></span>
                        <span id="${id}-text" class="text-xs font-medium text-neutral-600 dark:text-neutral-300 truncate max-w-[260px] sm:max-w-[420px] transition-all duration-200">Réfléchit...</span>
                    </div>
                </div>
            `;
            container.appendChild(el);
            lucideSafeRender(el);
            scrollToBottom();
            return id;
        }



        function updateTypingIndicator(id, statusText, stepType = '') {
            const textEl = document.getElementById(`${id}-text`);
            const iconEl = document.getElementById(`${id}-icon`);
            if (!textEl) return;

            let cleanText = statusText || 'Réfléchit...';
            // Strip any leading emoji from backend status
            cleanText = cleanText.replace(/^[^\w\s\u00C0-\u017F]+/u, '').trim();

            const map = {
                'search': 'globe',
                'browse': 'globe',
                'reading': 'file-text',
                'shopping': 'tag',
                'app': 'zap',
                'code': 'laptop',
                'briefing': 'target',
                'finance': 'credit-card',
                'writing': 'pen-tool',
                'thinking': 'brain'
            };
            const iconName = map[stepType] || (cleanText.toLowerCase().includes('recherche') ? 'globe' : cleanText.toLowerCase().includes('rédact') ? 'pen-tool' : 'brain');

            if (iconEl) {
                iconEl.innerHTML = `<i data-lucide="${iconName}" class="w-3.5 h-3.5 text-neutral-300"></i>`;
                lucideSafeRender(iconEl);
            }

            textEl.style.opacity = '0.3';
            setTimeout(() => {
                textEl.textContent = cleanText || 'Réfléchit...';
                textEl.style.opacity = '1';
                scrollToBottom();
            }, 100);
        }



        function startProgressiveThinking(id, userMessage) {
            const msg = (userMessage || "").toLowerCase();
            const steps = [];

            if (currentThinkingLevel === 'fast') {
                steps.push({ delay: 0, text: "Réflexion rapide (Mode Flash)...", step: "thinking" });
                steps.push({ delay: 600, text: "Rédaction de la réponse...", step: "writing" });
            } else if (currentThinkingLevel === 'deep') {
                steps.push({ delay: 0, text: "Deep Thinking : Décomposition logique du problème...", step: "thinking" });
                steps.push({ delay: 900, text: "Exploration analytique et multi-angles...", step: "search" });
                steps.push({ delay: 2800, text: "Évaluation des sources et vérification croisée...", step: "reading" });
                steps.push({ delay: 5000, text: "Rédaction de la synthèse détaillée...", step: "writing" });
            } else if (currentThinkingLevel === 'ultra') {
                steps.push({ delay: 0, text: "Ultra Research : Déploiement de l'audit multi-sources...", step: "thinking" });
                steps.push({ delay: 1000, text: "Scan approfondi sur le web et les comparateurs...", step: "search" });
                steps.push({ delay: 2900, text: "Lecture minutieuse des articles et fiches techniques...", step: "reading" });
                steps.push({ delay: 4800, text: "Recoupement des données et audit critique...", step: "reading" });
                steps.push({ delay: 6800, text: "Rédaction du rapport complet vérifié...", step: "writing" });
            } else {

            if (msg.includes("gta") || msg.includes("sortie") || msg.includes("date") || msg.includes("c quand") || msg.includes("pesera") || msg.includes("poids") || msg.includes("taille") || msg.includes("combien de go") || msg.includes("qui a")) {
                let subject = "informations";
                if (msg.includes("gta")) subject = "GTA 6";
                else if (msg.includes("cdm") || msg.includes("coupe du monde")) subject = "Coupe du Monde";
                else if (msg.includes("ballon d'or") || msg.includes("ballon dor")) subject = "Ballon d'Or";

                steps.push({ delay: 0, text: "Réfléchit...", step: "thinking" });
                steps.push({ delay: 700, text: `🌐 Recherche sur le web : "${subject}"...`, step: "search" });
                steps.push({ delay: 2400, text: "Analyse et vérification des sources...", step: "reading" });
                steps.push({ delay: 4400, text: "Rédaction de la réponse...", step: "writing" });
            } else if (msg.includes("iphone") || msg.includes("ps5") || msg.includes("prix") || msg.includes("aliexpress") || msg.includes("amazon") || msg.includes("acheter") || msg.includes("souris") || msg.includes("centella") || msg.includes("panoxyl")) {
                steps.push({ delay: 0, text: "🧠 Analyse du produit...", step: "thinking" });
                steps.push({ delay: 700, text: "🛍️ Recherche et comparaison des offres en direct...", step: "shopping" });
                steps.push({ delay: 2600, text: "🏷️ Vérification des stocks et des tarifs...", step: "shopping" });
                steps.push({ delay: 4600, text: "✍️ Préparation des meilleures offres...", step: "writing" });
            } else if (msg.includes("ouvre") || msg.includes("lance") || msg.includes("ferme") || msg.includes("spotify") || msg.includes("discord") || msg.includes("chrome") || msg.includes("vantage")) {
                steps.push({ delay: 0, text: "🧠 Analyse de la commande système...", step: "thinking" });
                steps.push({ delay: 600, text: "⚡ Préparation du contrôle PC...", step: "app" });
                steps.push({ delay: 1800, text: "🚀 Exécution de l'action sur ton écran...", step: "app" });
            } else if (msg.includes("code") || msg.includes("morpion") || msg.includes("crée un jeu") || msg.includes("html")) {
                steps.push({ delay: 0, text: "🧠 Conception de l'architecture...", step: "thinking" });
                steps.push({ delay: 800, text: "💻 Génération du code source HTML / CSS / JS...", step: "code" });
                steps.push({ delay: 3000, text: "✨ Finalisation de l'application...", step: "code" });
            } else {
                steps.push({ delay: 0, text: "Réfléchit...", step: "thinking" });
                steps.push({ delay: 1800, text: "✨ Exploration des connaissances...", step: "thinking" });
                steps.push({ delay: 3800, text: "Rédaction de la réponse...", step: "writing" });
            }
            }

            const timerIds = [];
            steps.forEach(s => {
                const tid = setTimeout(() => {
                    updateTypingIndicator(id, s.text, s.step);
                }, s.delay);
                timerIds.push(tid);
            });

            activeTypingTimers.set(id, timerIds);

            return id;

        }



        function removeTypingIndicator(id) {

            if (activeTypingTimers.has(id)) {

                activeTypingTimers.get(id).forEach(tid => clearTimeout(tid));

                activeTypingTimers.delete(id);

            }

            const el = document.getElementById(id);

            if (el) el.remove();

        }



        function appendAssistantMessage(text, cards, thoughts = null, level = null) {
            text = (text != null ? String(text) : '');
            const container = document.getElementById('chat-messages');
            const el = document.createElement('div');
            el.className = 'flex items-start space-x-3 msg-animate';
            const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            let cardsHtml = '';
            if (cards && cards.length > 0) {
                cardsHtml = cards.map(c => renderChatCard(c.type, c.data)).join('');
            }

            let thoughtHtml = '';
            if (thoughts && String(thoughts).trim()) {
                const effectiveLevel = level || currentThinkingLevel;
                const levelNames = {
                    'fast': 'Flash',
                    'standard': 'Standard',
                    'deep': 'Deep Thinking',
                    'ultra': 'Ultra Research'
                };
                const lvlName = levelNames[effectiveLevel] || 'Raisonnement';
                thoughtHtml = `
                    <details class="thought-process-card mb-3 rounded-xl liquid-glass-subtle border border-white/10 overflow-hidden group">
                        <summary class="py-2 px-3.5 cursor-pointer text-xs font-semibold text-neutral-700 dark:text-neutral-300 flex items-center space-x-2 select-none hover:bg-white/5 transition">
                            <i data-lucide="lightbulb" class="w-3.5 h-3.5 text-neutral-400"></i>
                            <span>Raisonnement (${lvlName})</span>
                            <span class="text-neutral-400 ml-auto group-open:rotate-180 transition-transform duration-200"><i data-lucide="chevron-down" class="w-3.5 h-3.5"></i></span>
                        </summary>
                        <div class="p-3.5 border-t border-white/10 text-[11px] font-mono leading-relaxed text-neutral-600 dark:text-neutral-300 whitespace-pre-wrap max-h-56 overflow-y-auto bg-black/20">
                            ${escapeHtml(String(thoughts))}
                        </div>
                    </details>
                `;
            }
            el.innerHTML = `
                <div class="w-8 h-8 rounded-full apple-avatar flex-shrink-0 flex items-center justify-center text-xs font-bold text-white shadow-md">H</div>
                <div class="space-y-2.5 max-w-[88%] sm:max-w-[82%]">
                    <div class="bubble-assistant p-4 rounded-2xl rounded-tl-sm text-sm text-neutral-900 dark:text-neutral-100 leading-relaxed shadow-sm">
                        ${thoughtHtml}
                        <span class="message-text"></span><span class="cursor-typing inline-block w-1.5 h-3.5 ml-0.5 bg-neutral-400 dark:bg-neutral-200 animate-pulse align-middle"></span>
                        <div class="text-[10px] text-neutral-400 dark:text-neutral-500 text-right mt-2 font-mono">${timeStr}</div>
                    </div>
                    <div class="cards-container space-y-2.5 hidden">${cardsHtml}</div>
                </div>
            `;

            container.appendChild(el);
            lucideSafeRender(el);
            scrollToBottom();



            const textSpan = el.querySelector('.message-text');

            const cursor = el.querySelector('.cursor-typing');

            const cardsDiv = el.querySelector('.cards-container');



            // Streaming mot par mot (Machine à écrire fluide)

            const words = text.split(/(\s+)/);

            let idx = 0;

            let currentText = '';



            const timer = setInterval(() => {

                if (idx < words.length) {

                    currentText += words[idx];

                    textSpan.innerHTML = formatMarkdown(currentText);

                    idx++;

                    scrollToBottom();

                } else {

                    clearInterval(timer);

                    if (cursor) cursor.remove();
                    if (cardsHtml) {
                        cardsDiv.classList.remove('hidden');
                        cardsDiv.classList.add('msg-animate');
                    }
                    lucideSafeRender(el);
                    scrollToBottom();

                }

            }, 12);

        }



        // Formatage Markdown simple

        function formatMarkdown(text) {

            return escapeHtml(text)

                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')

                .replace(/\*(.*?)\*/g, '<em>$1</em>')

                .replace(/\n\n/g, '<br><br>')

                .replace(/\n/g, '<br>');

        }



        // --- RENDU DES CARTES D'ACTION INTERACTIVES ---

        function renderChatCard(type, data) {

            if (type === 'second_hand_deals') {

                const prod = data.product || 'Article';

                const deals = data.best_deals || [];

                const liveOffers = data.live_scraped_offers || [];

                const minPrice = data.current_drop_price_eur || 65;

                const proPrice = data.pro_reconditioned_price_eur || 135;



                return `

                    <div class="second-hand-deal-card p-4 rounded-2xl bg-white dark:bg-[#121216] border border-amber-500/30 shadow-xl space-y-3.5 text-xs">

                        <!-- En-tête Comparateur Réel -->

                        <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-white/10">

                            <div>

                                <div class="flex items-center space-x-1.5 font-bold text-slate-900 dark:text-white text-xs">

                                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5 inline text-neutral-400"></i>

                                    <span>Marché Occasion & Reconditionné : ${escapeHtml(prod)}</span>

                                </div>

                                <div class="text-[10px] text-slate-500 dark:text-slate-400 mt-0.5">Vrais prix constatés en direct sur les plateformes</div>

                            </div>

                            <span class="px-2.5 py-1 rounded-xl bg-amber-500/20 text-amber-500 dark:text-amber-400 font-mono text-[11px] font-bold">Dès ${minPrice} €</span>

                        </div>



                        <!-- Grille des offres réelles par plateforme -->

                        <div class="space-y-2">

                            ${deals.map(d => `

                                <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-[#08080a]/70 border border-slate-200 dark:border-white/5 space-y-1.5 transition hover:border-amber-500/40">

                                    <div class="flex items-center justify-between">

                                        <div class="flex items-center space-x-2">

                                            <span>${d.icon || '🏷️'}</span>

                                            <div>

                                                <div class="font-bold text-slate-900 dark:text-white text-[11px]">${escapeHtml(d.platform)}</div>

                                                <div class="text-[9px] text-slate-500">${escapeHtml(d.badge || '')}</div>

                                            </div>

                                        </div>

                                        <div class="text-right">

                                            <div class="text-xs font-bold text-slate-900 dark:text-white font-mono">${escapeHtml(d.price_range_str || '')}</div>

                                            <div class="text-[9px] text-emerald-500 font-medium">${d.is_cheapest ? '<span class="flex items-center space-x-1"><i data-lucide="star" class="w-3 h-3 text-amber-400 fill-amber-400 inline"></i><span>Le moins cher</span></span>' : (d.is_best_value ? '<span class="flex items-center space-x-1"><i data-lucide="shield-check" class="w-3 h-3 text-neutral-300 inline"></i><span>Recommandé</span></span>' : '')}</div>

                                        </div>

                                    </div>

                                    <div class="flex items-center justify-between pt-1 border-t border-slate-200 dark:border-white/5 text-[10px] text-slate-500 dark:text-slate-400">

                                        <span>Garantie : <strong class="text-slate-700 dark:text-slate-300">${escapeHtml(d.warranty || 'Standard')}</strong></span>

                                        <a href="${escapeHtml(d.url)}" target="_blank" class="px-3 py-1.5 rounded-xl bg-white text-black hover:bg-neutral-200 font-bold transition flex items-center space-x-1 shadow-sm tactile-btn">

                                            <span>Voir les offres</span>

                                            <i data-lucide="external-link" class="w-3.5 h-3.5 inline"></i>

                                        </a>

                                    </div>

                                </div>

                            `).join('')}

                        </div>



                        <!-- Conseil d'Achat Big Sis -->

                        <div class="p-2.5 rounded-xl bg-gradient-to-r bg-white/5 border border-white/10 border border-white/10 text-[11px] space-y-1">

                            <div class="font-bold text-neutral-900 dark:text-neutral-200 flex items-center space-x-1">

                                <i data-lucide="lightbulb" class="w-3.5 h-3.5 inline text-neutral-400"></i>

                                <span>Conseil de ta grande sœur :</span>

                            </div>

                            <div class="text-slate-700 dark:text-slate-300 leading-relaxed text-[10.5px]">

                                • <strong>Pour le zéro risque :</strong> Prends <strong>Back Market (dès ${proPrice}€)</strong> : t'as 1 an de garantie complète et le droit de retour gratuit.<br>

                                • <strong>Pour le prix le plus bas :</strong> Prends <strong>Leboncoin (dès ${minPrice}€)</strong>, mais exige TOUJOURS une capture de la santé de la batterie (minimum 85%) et vérifie que le compte iCloud est bien déconnecté avant de payer !

                            </div>

                        </div>



                        ${liveOffers.length > 0 ? `

                            <!-- Annonces spécifiques extraites en direct -->

                            <div class="space-y-1.5 pt-1 border-t border-slate-200 dark:border-white/5">

                                <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">⚡ Annonces spécifiques repérées en direct :</div>

                                <div class="space-y-1">

                                    ${liveOffers.map(o => `

                                        <a href="${escapeHtml(o.url)}" target="_blank" class="p-1.5 rounded-lg bg-slate-100 dark:bg-[#18181e] hover:bg-slate-200 dark:hover:bg-[#202026] flex items-center justify-between text-[11px] text-slate-700 dark:text-slate-300 transition">

                                            <span class="truncate flex-1 pr-2">• <strong>${escapeHtml(o.platform || '')}</strong> : ${escapeHtml(o.title)}</span>

                                            ${o.estimated_price ? `<span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-mono text-[10px] font-bold">${escapeHtml(o.estimated_price)}</span>` : ''}

                                        </a>

                                    `).join('')}

                                </div>

                            </div>

                        ` : ''}

                    </div>

                `;

            } else if (type === 'deal') {

                const isCdiscount = (data.platform || '').toLowerCase().includes('cdiscount');

                const badgeBorder = isCdiscount ? 'border-white/15' : 'border-emerald-500/30';

                const badgeBg = isCdiscount ? 'bg-white/10 text-neutral-200' : 'bg-emerald-500/20 text-emerald-400';

                const btnBg = isCdiscount ? 'bg-white text-black hover:bg-neutral-200 shadow-md' : 'bg-emerald-600 hover:bg-emerald-500 shadow-emerald-600/30';



                let specsHtml = '';

                if (data.specs && data.specs.length > 0) {

                    specsHtml = `

                        <div class="p-2 rounded-xl bg-slate-100 dark:bg-[#08080a]/80 border border-slate-200 dark:border-white/5 space-y-1 my-1.5">

                            <div class="text-[10px] uppercase font-bold text-slate-500 dark:text-slate-400">Fiche Technique :</div>

                            ${data.specs.map(s => `<div class="text-[11px] text-slate-700 dark:text-slate-300 flex items-center space-x-1.5"><span class="w-1.5 h-1.5 rounded-full bg-white"></span><span>${s}</span></div>`).join('')}

                        </div>

                    `;

                }



                const productUrlBtn = data.product_url ? `

                    <a href="${escapeHtml(data.product_url)}" target="_blank" class="tactile-btn px-3 py-2.5 rounded-xl bg-slate-100 dark:bg-[#18181e] hover:bg-slate-200 dark:hover:bg-[#202026] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-white/10 text-xs font-semibold flex items-center justify-center space-x-1">

                        <span>Voir sur ${escapeHtml(data.platform || 'le site')}</span>

                        <i data-lucide="external-link" class="w-3.5 h-3.5 inline"></i>

                    </a>

                ` : '';



                return `

                    <div class="p-3.5 rounded-2xl bg-white dark:bg-[#121216] border ${badgeBorder} shadow-lg space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-slate-200 dark:border-white/5">

                            <span class="flex items-center space-x-1.5 font-bold text-slate-900 dark:text-white">

                                <span>🎯</span>

                                <span>${escapeHtml(data.product || 'Offre')}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-md ${badgeBg} font-mono font-bold">-${data.savings_percent || 15}%</span>

                        </div>

                        <div class="flex items-center justify-between">

                            <div>

                                <span class="text-slate-500 dark:text-slate-400 text-[11px]">Plateforme : <strong class="text-slate-800 dark:text-white">${escapeHtml(data.platform || 'Amazon.fr')}</strong></span>

                                <div class="text-lg font-bold text-slate-900 dark:text-white font-mono mt-0.5">${data.current_drop_price_eur || ''} € ${data.historical_average_eur ? `<span class="text-xs line-through text-slate-400">${data.historical_average_eur} €</span>` : ''}</div>

                            </div>

                            <span class="px-2 py-1 rounded bg-slate-100 dark:bg-[#18181e] text-[10px] text-amber-500 font-mono">⚡ ${escapeHtml(data.deal_urgency || 'Meilleur Prix')}</span>

                        </div>

                        ${specsHtml}

                        <div class="flex items-center space-x-2 pt-1">

                            <button onclick="executeApprovedAction(this, '${data.approval_action_id || 'act_deal'}', 'ONE_CLICK_PURCHASE', {product: '${escapeHtml(data.product || '')}', price: ${data.current_drop_price_eur || 0}})" class="tactile-btn flex-1 py-2.5 rounded-xl ${btnBg} text-white font-bold text-xs shadow-md transition flex items-center justify-center space-x-1.5">

                                <span>Acheter en 1 clic (${data.current_drop_price_eur || ''}€)</span>

                                <span>🛒</span>

                            </button>

                            ${productUrlBtn}

                        </div>

                    </div>

                `;

            } else if (type === 'interactive_clarification') {

                const title = data.title || "🎯 Précisions pour cibler les meilleures offres sur tout le Web";

                const questions = data.questions || [];

                const chips = data.quick_chips || [];



                return `

                    <div class="p-3.5 rounded-2xl bg-gradient-to-br bg-white/5 border border-white/10 border border-white/15 shadow-lg space-y-3 text-xs">

                        <div class="flex items-center space-x-2 font-bold text-neutral-900 dark:text-neutral-200">

                            <span>✨</span>

                            <span>${escapeHtml(title)}</span>

                        </div>

                        ${questions.length > 0 ? `

                            <div class="space-y-1.5 p-2.5 rounded-xl bg-slate-100 dark:bg-[#08080a]/70 border border-slate-200 dark:border-white/5 text-[11px] text-slate-700 dark:text-slate-300">

                                ${questions.map(q => `<div class="flex items-start space-x-1.5"><span class="text-neutral-300 font-bold">•</span><span>${escapeHtml(q)}</span></div>`).join('')}

                            </div>

                        ` : ''}

                        ${chips.length > 0 ? `

                            <div class="space-y-1">

                                <div class="text-[10px] font-bold uppercase text-slate-500 dark:text-slate-400">💡 Réponse rapide en 1 clic :</div>

                                <div class="flex flex-wrap gap-1.5 pt-1">

                                    ${chips.map(c => `

                                        <button onclick="sendInteractiveAnswer('${escapeHtml(c.query || c.label)}')" class="tactile-btn px-2.5 py-1.5 rounded-xl bg-white/10 hover:bg-white text-black text-indigo-700 dark:text-neutral-200 hover:text-white border border-white/15 text-[11px] font-semibold transition cursor-pointer flex items-center space-x-1 shadow-sm">

                                            <span>${escapeHtml(c.label)}</span>

                                        </button>

                                    `).join('')}

                                </div>

                            </div>

                        ` : ''}

                    </div>

                `;

            } else if (type === 'omni_deal') {

                const prod = data.product || 'Article';

                const retail = data.retail_platforms || [];

                const occasion = data.occasion_platforms || [];

                const liveOffers = data.live_web_offers || [];



                return `

                    <div class="p-3.5 rounded-2xl bg-white dark:bg-[#121216] border border-white/15 shadow-lg space-y-3 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-slate-200 dark:border-white/5">

                            <span class="flex items-center space-x-1.5 font-bold text-slate-900 dark:text-white">

                                <span>🌐</span>

                                <span>Scan Universel Web & Occasion : ${escapeHtml(prod)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-md bg-white/10 text-neutral-300 font-mono text-[10px] font-bold">Illimité</span>

                        </div>



                        <!-- Section Occasion & Seconde Main (Leboncoin, Vinted, Back Market...) -->

                        <div class="space-y-1.5">

                            <div class="text-[10px] font-bold uppercase tracking-wider text-amber-500 flex items-center space-x-1">

                                <i data-lucide="refresh-cw" class="w-3.5 h-3.5 inline text-neutral-400"></i>

                                <span>Occasion, Reconditionné & Petits Prix :</span>

                            </div>

                            <div class="grid grid-cols-2 gap-1.5">

                                ${occasion.map(p => `

                                    <a href="${escapeHtml(p.url)}" target="_blank" class="p-2 rounded-xl bg-slate-100 dark:bg-[#18181e] hover:bg-slate-200 dark:hover:bg-[#202026] border border-slate-200 dark:border-white/5 flex items-center justify-between transition">

                                        <div class="flex items-center space-x-1.5 truncate">

                                            <span>${p.icon || '🏷️'}</span>

                                            <div class="truncate">

                                                <div class="font-bold text-[11px] text-slate-900 dark:text-white truncate">${escapeHtml(p.platform)}</div>

                                                <div class="text-[9px] text-slate-500 truncate">${escapeHtml(p.badge || '')}</div>

                                            </div>

                                        </div>

                                        <span class="text-slate-400 text-xs">↗</span>

                                    </a>

                                `).join('')}

                            </div>

                        </div>



                        <!-- Section Neuf & Boutiques Spécialisées (Sephora, Amazon, Fnac...) -->

                        <div class="space-y-1.5 pt-1">

                            <div class="text-[10px] font-bold uppercase tracking-wider text-emerald-500 flex items-center space-x-1">

                                <span>🛍️</span>

                                <span>Neuf & Boutiques Spécialisées Officielles :</span>

                            </div>

                            <div class="grid grid-cols-2 gap-1.5">

                                ${retail.map(p => `

                                    <a href="${escapeHtml(p.url)}" target="_blank" class="p-2 rounded-xl bg-slate-100 dark:bg-[#18181e] hover:bg-slate-200 dark:hover:bg-[#202026] border border-slate-200 dark:border-white/5 flex items-center justify-between transition">

                                        <div class="flex items-center space-x-1.5 truncate">

                                            <span>${p.icon || '📦'}</span>

                                            <div class="truncate">

                                                <div class="font-bold text-[11px] text-slate-900 dark:text-white truncate">${escapeHtml(p.platform)}</div>

                                                <div class="text-[9px] text-slate-500 truncate">${escapeHtml(p.badge || '')}</div>

                                            </div>

                                        </div>

                                        <span class="text-slate-400 text-xs">↗</span>

                                    </a>

                                `).join('')}

                            </div>

                        </div>



                        ${liveOffers.length > 0 ? `

                            <div class="space-y-1.5 pt-1 border-t border-slate-200 dark:border-white/5">

                                <div class="text-[10px] font-bold uppercase tracking-wider text-neutral-300">⚡ Offres extraites en direct sur le Web :</div>

                                <div class="space-y-1">

                                    ${liveOffers.map(o => `

                                        <a href="${escapeHtml(o.url)}" target="_blank" class="p-1.5 rounded-lg bg-slate-50 dark:bg-[#08080a]/60 hover:bg-slate-100 dark:hover:bg-[#18181e] flex items-center justify-between text-[11px] text-slate-700 dark:text-slate-300 transition">

                                            <span class="truncate flex-1 pr-2">• <strong class="text-slate-900 dark:text-white">${escapeHtml(o.domain || 'Boutique')}</strong> : ${escapeHtml(o.title)}</span>

                                            ${o.estimated_price ? `<span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-mono text-[10px] font-bold">${escapeHtml(o.estimated_price)}</span>` : ''}

                                        </a>

                                    `).join('')}

                                </div>

                            </div>

                        ` : ''}

                    </div>

                `;

            } else if (type === 'search_hub') {

                const plat = data.platform || 'Boutique';

                const prod = data.product || 'Article';

                const url = data.product_url || '#';

                const insight = data.market_insight || `Scan en direct des références disponibles sur ${plat}.`;



                return `

                    <div class="p-3.5 rounded-2xl bg-white dark:bg-[#121216] border border-white/15 shadow-lg space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-slate-200 dark:border-white/5">

                            <span class="flex items-center space-x-1.5 font-bold text-neutral-900 dark:text-neutral-200">

                                <span>🔍</span>

                                <span>Recherche en Direct : ${escapeHtml(prod)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-md bg-white/10 text-neutral-300 font-mono text-[10px] font-bold">Catalogue Live</span>

                        </div>

                        <div class="text-[11px] text-slate-600 dark:text-slate-300 leading-relaxed">

                            ${escapeHtml(insight)}

                        </div>

                        <div class="pt-1">

                            <a href="${escapeHtml(url)}" target="_blank" class="tactile-btn w-full py-2.5 rounded-xl bg-white text-black hover:bg-neutral-200 text-white font-bold text-xs shadow-md transition flex items-center justify-center space-x-1.5">

                                <span>Explorer toutes les offres sur ${escapeHtml(plat)}</span>

                                <i data-lucide="external-link" class="w-3.5 h-3.5 inline"></i>

                            </a>

                        </div>

                    </div>

                `;

            } else if (type === 'logistics') {

                return `

                    <div class="p-3.5 rounded-2xl bg-white dark:bg-[#121216] border border-amber-500/30 shadow-lg space-y-2 text-xs">

                        <div class="flex items-center justify-between">

                            <span class="font-bold text-amber-500">📦 Colis ${escapeHtml(data.carrier || 'UPS')} (${escapeHtml(data.tracking_number || '')})</span>

                            <span class="text-[10px] font-mono text-emerald-500">En transit</span>

                        </div>

                        <div class="w-full bg-slate-100 dark:bg-[#08080a] rounded-full h-1.5 overflow-hidden">

                            <div class="bg-gradient-to-r from-amber-500 to-emerald-400 h-full rounded-full" style="width: 75%"></div>

                        </div>

                        <div class="text-[11px] text-slate-600 dark:text-slate-300 flex items-center justify-between">

                            <span>📍 ${escapeHtml(data.current_location || 'Centre de tri')}</span>

                            <span class="text-slate-400">${escapeHtml(data.estimated_delivery || 'Sous 48h')}</span>

                        </div>

                    </div>

                `;

            } else if (type === 'jarvis_briefing') {

                const weather = data.weather || {};

                const schedule = data.schedule || [];

                const emails = data.emails || [];

                const tasks = data.tasks || [];

                const metrics = data.metrics || {};

                const packages = data.packages || [];

                const dateStr = data.date || "Aujourd'hui";



                return `

                    <div class="p-4 rounded-2xl bg-white dark:bg-[#121216] border border-white/15 shadow-xl space-y-3.5 text-xs">

                        <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-white/10">

                            <div class="flex items-center space-x-2">

                                <span class="text-base">⚡</span>

                                <div>

                                    <div class="font-bold text-slate-900 dark:text-white text-xs">Briefing Quotidien Jarvis</div>

                                    <div class="text-[10px] text-slate-500 dark:text-slate-400 font-mono">${escapeHtml(dateStr)}</div>

                                </div>

                            </div>

                            <div class="px-2.5 py-1 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-500 dark:text-amber-400 font-bold text-[11px] flex items-center space-x-1">

                                <span>${escapeHtml(weather.condition || '☀️')}</span>

                                <span class="font-mono">${escapeHtml(String(weather.temperature_c || 19))}°C</span>

                            </div>

                        </div>



                        <!-- Ligne CA Stripe & Métriques -->

                        ${metrics.today_revenue_eur ? `

                            <div class="p-2.5 rounded-xl bg-gradient-to-r from-emerald-500/10 via-emerald-500/5 to-transparent border border-emerald-500/20 flex items-center justify-between">

                                <div class="flex items-center space-x-2">

                                    <span class="text-emerald-500 font-bold">💳 Stripe / E-com</span>

                                    <span class="font-mono font-bold text-slate-900 dark:text-white">${metrics.today_revenue_eur} €</span>

                                    <span class="text-[10px] text-slate-500">(${metrics.orders_count || 0} commandes)</span>

                                </div>

                                <span class="text-[10px] font-mono font-bold text-emerald-400">${escapeHtml(metrics.trend || '+18%')}</span>

                            </div>

                        ` : ''}



                        <!-- Agenda du Jour -->

                        ${schedule.length > 0 ? `

                            <div class="space-y-1.5">

                                <div class="text-[10px] uppercase font-bold text-neutral-300 flex items-center space-x-1">

                                    <span>📅</span>

                                    <span>Agenda & Rendez-vous clés :</span>

                                </div>

                                <div class="space-y-1">

                                    ${schedule.map(s => `

                                        <div class="p-1.5 rounded-lg bg-slate-100 dark:bg-[#08080a]/60 border border-slate-200 dark:border-white/5 flex items-center justify-between text-[11px]">

                                            <span class="text-slate-700 dark:text-slate-300">• <strong class="text-slate-900 dark:text-white">${escapeHtml(s.time)}</strong> - ${escapeHtml(s.title)}</span>

                                            <span class="text-[10px] text-slate-400 font-mono">${escapeHtml(s.duration || '')}</span>

                                        </div>

                                    `).join('')}

                                </div>

                            </div>

                        ` : ''}



                        <!-- Mails Prioritaires (Lecture Seule) -->

                        ${emails.length > 0 ? `

                            <div class="space-y-1.5">

                                <div class="text-[10px] uppercase font-bold text-rose-400 flex items-center space-x-1">

                                    <span>✉️</span>

                                    <span>Mails Urgents (Action Requise) :</span>

                                </div>

                                <div class="space-y-1">

                                    ${emails.map(e => `

                                        <div class="p-1.5 rounded-lg bg-slate-100 dark:bg-[#08080a]/60 border border-slate-200 dark:border-white/5 flex items-center justify-between text-[11px]">

                                            <div class="truncate pr-2">

                                                <div class="font-bold text-slate-900 dark:text-white truncate">${escapeHtml(e.from)}: ${escapeHtml(e.subject)}</div>

                                                <div class="text-[10px] text-slate-500 truncate">${escapeHtml(e.preview || '')}</div>

                                            </div>

                                            <span class="px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-400 font-bold text-[9px] flex-shrink-0">${escapeHtml(e.urgency || 'Urgent')}</span>

                                        </div>

                                    `).join('')}

                                </div>

                            </div>

                        ` : ''}



                        <!-- Colis en Transit -->

                        ${packages.length > 0 ? `

                            <div class="space-y-1.5">

                                <div class="text-[10px] uppercase font-bold text-amber-400 flex items-center space-x-1">

                                    <span>📦</span>

                                    <span>Colis attendus aujourd'hui :</span>

                                </div>

                                <div class="space-y-1">

                                    ${packages.map(p => `

                                        <div class="p-1.5 rounded-lg bg-slate-100 dark:bg-[#08080a]/60 border border-slate-200 dark:border-white/5 flex items-center justify-between text-[11px]">

                                            <span class="text-slate-700 dark:text-slate-300 truncate pr-2">• <strong>${escapeHtml(p.carrier)}</strong> : ${escapeHtml(p.item)}</span>

                                            <span class="text-[10px] text-emerald-400 font-mono font-bold flex-shrink-0">${escapeHtml(p.status)}</span>

                                        </div>

                                    `).join('')}

                                </div>

                            </div>

                        ` : ''}

                    </div>

                `;

            } else if (type === 'app_launcher') {

                const appName = data.display_name || data.app || 'Application';

                const isClose = data.action === 'close';

                const screen = data.screen_description || data.screen || "l'écran principal";

                const status = isClose ? (data.status === 'closed' ? 'FERMÉE' : 'ARRÊTÉE') : (data.status === 'launched' ? 'LANCÉE' : 'PRÊTE');

                const badgeClass = isClose ? 'bg-rose-500/20 text-rose-400' : 'bg-emerald-500/20 text-emerald-400';

                const borderClass = isClose ? 'border-rose-500/30' : 'border-white/15';

                const icon = isClose ? '🛑' : '🚀';

                const desc = isClose 

                    ? (data.verbal_reply || `${escapeHtml(appName)} a été fermé, monsieur.`)

                    : `Lancé avec succès sur <strong class="text-sky-400">${escapeHtml(screen)}</strong>, monsieur.`;

                const url = data.url;



                return `

                    <div class="p-3.5 rounded-2xl bg-white dark:bg-[#121216] border ${borderClass} shadow-lg space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-slate-200 dark:border-white/5">

                            <span class="flex items-center space-x-2 font-bold text-slate-900 dark:text-white">

                                <span class="text-base">${icon}</span>

                                <span>Contrôle Système : ${escapeHtml(appName)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full ${badgeClass} font-mono text-[10px] font-bold">● ${status}</span>

                        </div>

                        <div class="text-[11px] text-slate-600 dark:text-slate-300">

                            ${desc}

                        </div>

                        ${!isClose ? `

                            <div class="flex items-center space-x-2 pt-1">

                                ${url ? `

                                    <a href="${escapeHtml(url)}" target="_blank" class="tactile-btn flex-1 py-2 px-3 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs flex items-center justify-center space-x-1.5 transition">

                                        <span>Accéder directement</span>

                                        <i data-lucide="external-link" class="w-3.5 h-3.5 inline"></i>

                                    </a>

                                ` : `

                                    <div class="p-1.5 text-[10px] text-slate-400 font-mono">Processus Windows actif en arrière-plan</div>

                                `}

                            </div>

                        ` : ''}

                    </div>

                `;

            } else if (type === 'code_app') {

                const appName = data.app_name || 'Application';

                const desc = data.description || 'Mini-application web interactive';

                const previewUrl = data.preview_url || `/apps/${appName}/index.html`;



                return `

                    <div class="p-3.5 rounded-2xl bg-gradient-to-br bg-white/5 border border-white/10 border border-white/20 shadow-xl space-y-3 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-slate-200 dark:border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-300">

                                <span class="text-base">⚡</span>

                                <span>Code Studio : ${escapeHtml(appName.toUpperCase())}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-white/10 text-neutral-200 font-mono text-[10px] font-bold">HTML5 / JS</span>

                        </div>

                        <div class="text-[11px] text-slate-300">${escapeHtml(desc)}</div>

                        <div class="p-2 rounded-xl bg-[#08080a]/80 border border-white/5 space-y-1 font-mono text-[10px] text-slate-400">

                            <div>📁 Dossier : <strong>/static/apps/${escapeHtml(appName)}/</strong></div>

                            <div class="text-emerald-400">✓ index.html • style.css • script.js</div>

                        </div>

                        <div class="flex items-center space-x-2 pt-1">

                            <a href="${escapeHtml(previewUrl)}" target="_blank" class="tactile-btn flex-1 py-2 px-3 rounded-xl bg-gradient-to-r bg-neutral-800 hover:from-indigo-500 hover:to-purple-500 text-white font-bold text-xs flex items-center justify-center space-x-1.5 shadow-lg shadow-white/5 transition">

                                <span>Ouvrir dans Chrome</span>

                                <i data-lucide="gamepad-2" class="w-3.5 h-3.5 inline text-neutral-400"></i>

                            </a>

                            <button onclick="toggleAppPreviewFrame(this, '${escapeHtml(previewUrl)}')" class="tactile-btn py-2 px-3 rounded-xl bg-white/10 hover:bg-white/15 text-slate-300 font-semibold text-xs border border-white/10 transition">

                                <span>Aperçu HUD</span>

                            </button>

                        </div>

                        <div class="app-frame-container hidden mt-2 rounded-xl overflow-hidden border border-white/15"></div>

                    </div>

                `;

            } else if (type === 'chart') {

                const title = data.title || 'Visualisation de Données';

                const svg = data.visual_svg || '';



                return `

                    <div class="p-3.5 rounded-2xl bg-white dark:bg-[#121216] border border-white/15 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-slate-200 dark:border-white/5">

                            <span class="flex items-center space-x-2 font-bold text-slate-900 dark:text-white">

                                <span class="text-neutral-200">📊</span>

                                <span>${escapeHtml(title)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded bg-cyan-500/20 text-neutral-200 font-mono text-[10px] font-bold">HUD LIVE</span>

                        </div>

                        <div class="overflow-x-auto py-1 flex justify-center">

                            ${svg}

                        </div>

                    </div>

                `;

            } else if (type === 'social_post') {

                const platform = data.platform || 'LinkedIn';

                const content = data.content || '';

                const scheduled = data.scheduled_time;

                const status = data.status || 'DRAFT';

                const img = data.image_url;



                return `

                    <div class="p-3.5 rounded-2xl bg-white dark:bg-[#121216] border border-white/15 shadow-xl space-y-3 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-slate-200 dark:border-white/5">

                            <div class="flex items-center space-x-2">

                                <span class="w-6 h-6 rounded bg-[#0077b5] text-white flex items-center justify-center font-bold text-xs">in</span>

                                <span class="font-bold text-slate-900 dark:text-white">Post ${escapeHtml(platform)}</span>

                            </div>

                            <span class="px-2 py-0.5 rounded bg-white/10 text-neutral-200 font-mono text-[10px] font-bold">${escapeHtml(status)}</span>

                        </div>

                        <div class="p-3 rounded-xl bg-slate-50 dark:bg-[#08080a]/70 border border-slate-200 dark:border-white/5 text-[11px] leading-relaxed text-slate-800 dark:text-slate-200 whitespace-pre-line font-sans">

                            ${escapeHtml(content)}

                        </div>

                        ${img ? `

                            <div class="rounded-xl overflow-hidden border border-slate-200 dark:border-white/10 max-h-40">

                                <img src="${escapeHtml(img)}" alt="Illustration" class="w-full h-full object-cover">

                            </div>

                        ` : ''}

                        <div class="flex items-center justify-between pt-1">

                            <div class="text-[10px] text-slate-400">

                                ${scheduled ? `📅 Programmé : <strong class="text-neutral-200">${escapeHtml(scheduled)}</strong>` : '⚡ Prêt à publier'}

                            </div>

                            <button onclick="publishPostDirectly(this, '${escapeHtml(data.post_id || '')}')" class="tactile-btn py-1.5 px-3 rounded-lg bg-white text-black hover:bg-neutral-200 hover:bg-blue-500 text-white font-bold text-xs transition">

                                <span>Publier maintenant</span>

                            </button>

                        </div>

                    </div>

                `;

            } else if (type === 'media_asset') {

                const title = data.title || 'Image';

                const url = data.image_url || '';



                return `

                    <div class="p-3 rounded-2xl bg-white dark:bg-[#121216] border border-white/15 shadow-lg space-y-2 text-xs">

                        <div class="flex items-center justify-between pb-1 border-b border-white/5">

                            <span class="font-bold text-slate-900 dark:text-white truncate">🖼️ ${escapeHtml(title)}</span>

                            <span class="text-[10px] text-neutral-300 font-mono">1080p</span>

                        </div>

                        <div class="rounded-xl overflow-hidden border border-white/10">

                            <img src="${escapeHtml(url)}" alt="${escapeHtml(title)}" class="w-full max-h-48 object-cover">

                        </div>

                    </div>

                `;

            } else if (type === 'code_viewer') {

                const path = data.path || 'Fichier';

                const totalLines = data.total_lines || 0;

                const linesReturned = data.lines_returned || 0;

                const content = data.content || '';

                const ext = data.extension || '';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-emerald-500/30 shadow-xl space-y-2.5 text-xs font-mono">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-emerald-400">

                                <span>📄</span>

                                <span class="truncate max-w-[220px]">${escapeHtml(path)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-[10px] font-bold">

                                ${linesReturned}/${totalLines} LIGNES

                            </span>

                        </div>

                        <div class="max-h-56 overflow-y-auto p-2.5 rounded-xl bg-[#08080a]/90 border border-white/5 text-[11px] text-slate-300 font-mono leading-relaxed whitespace-pre-wrap select-text">

${escapeHtml(content)}

                        </div>

                        <div class="flex items-center justify-between text-[10px] text-slate-400">

                            <span>Format : <strong class="text-emerald-400">${escapeHtml(ext.toUpperCase() || 'TEXT')}</strong></span>

                            <button onclick="navigator.clipboard.writeText(this.closest('.p-3\\.5').querySelector('.whitespace-pre-wrap').innerText); this.innerText='Copié !'; setTimeout(() => this.innerText='Copier le code', 1500);" class="px-2.5 py-1 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 transition">

                                Copier le code

                            </button>

                        </div>

                    </div>

                `;

            } else if (type === 'code_editor') {

                const path = data.path || 'Fichier';

                const bytes = data.bytes_written || 0;

                const lines = data.lines_count || 0;

                const reply = data.verbal_reply || 'Fichier enregistré avec succès.';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/15 shadow-xl space-y-2 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-sky-400">

                                <span>✍️</span>

                                <span class="truncate max-w-[220px]">${escapeHtml(path)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-sky-500/20 text-sky-300 font-mono text-[10px] font-bold">

                                ● ENREGISTRÉ

                            </span>

                        </div>

                        <div class="text-[11px] text-slate-300">${escapeHtml(reply)}</div>

                        <div class="p-2 rounded-xl bg-[#08080a]/80 border border-white/5 flex items-center justify-between text-[10px] font-mono text-slate-400">

                            <span>Taille : <strong class="text-sky-300">${bytes} octets</strong></span>

                            <span>Lignes : <strong class="text-sky-300">${lines}</strong></span>

                        </div>

                    </div>

                `;

            } else if (type === 'code_diff') {

                const path = data.path || 'Fichier';

                const reply = data.verbal_reply || 'Modification chirurgicale effectuée.';

                const target = data.target || '';

                const replacement = data.replacement || '';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-amber-500/30 shadow-xl space-y-2 text-xs font-mono">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-amber-400">

                                <span>✂️</span>

                                <span class="truncate max-w-[220px]">DIFF: ${escapeHtml(path)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 text-[10px] font-bold">

                                APPLIQUÉ

                            </span>

                        </div>

                        <div class="text-[11px] text-slate-300 font-sans">${escapeHtml(reply)}</div>

                        <div class="space-y-1 text-[10px]">

                            <div class="p-1.5 rounded-lg bg-rose-950/40 border border-rose-500/20 text-rose-300 line-through truncate">

                                - ${escapeHtml(target.substring(0, 100))}${target.length > 100 ? '...' : ''}

                            </div>

                            <div class="p-1.5 rounded-lg bg-emerald-950/40 border border-emerald-500/20 text-emerald-300 truncate">

                                + ${escapeHtml(replacement.substring(0, 100))}${replacement.length > 100 ? '...' : ''}

                            </div>

                        </div>

                    </div>

                `;

            } else if (type === 'directory_tree') {

                const path = data.path || '.';

                const totalItems = data.total_items || 0;

                const tree = data.tree || [];

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/15 shadow-xl space-y-2 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-300">

                                <span>📂</span>

                                <span class="truncate max-w-[220px]">Arborescence : ${escapeHtml(path)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-white/10 text-neutral-200 font-mono text-[10px] font-bold">

                                ${totalItems} ÉLÉMENTS

                            </span>

                        </div>

                        <div class="max-h-48 overflow-y-auto p-2 rounded-xl bg-[#08080a]/80 border border-white/5 space-y-1 font-mono text-[10px] text-slate-300">

                            ${tree.slice(0, 30).map(item => `

                                <div class="flex items-center justify-between hover:bg-white/5 px-1 py-0.5 rounded">

                                    <span class="truncate ${item.is_dir ? 'text-neutral-200 font-bold' : 'text-slate-300'}">

                                        ${item.is_dir ? '📁' : '📄'} ${escapeHtml(item.path)}

                                    </span>

                                    <span class="text-slate-500 flex-shrink-0 ml-2">${item.is_dir ? 'dir' : item.size + ' B'}</span>

                                </div>

                            `).join('')}

                            ${tree.length > 30 ? `<div class="text-slate-500 italic text-center py-1">... et ${tree.length - 30} autres éléments</div>` : ''}

                        </div>

                    </div>

                `;

            } else if (type === 'terminal_exec') {

                const cmd = data.command || '';

                const code = data.returncode ?? 0;

                const stdout = data.stdout || '';

                const stderr = data.stderr || '';

                const duration = data.duration_ms || 0;

                const isSuccess = code === 0;

                const badgeColor = isSuccess ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border ${isSuccess ? 'border-emerald-500/30' : 'border-rose-500/30'} shadow-xl space-y-2 text-xs font-mono">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-slate-200">

                                <span class="text-neutral-200">💻</span>

                                <span>Terminal Execution</span>

                            </span>

                            <div class="flex items-center space-x-1.5">

                                <span class="text-[10px] text-slate-500">${duration}ms</span>

                                <span class="px-2 py-0.5 rounded-full ${badgeColor} text-[10px] font-bold">

                                    RC ${code}

                                </span>

                            </div>

                        </div>

                        <div class="p-2 rounded-lg bg-black/60 border border-white/5 text-[11px] text-neutral-300">

                            $ ${escapeHtml(cmd)}

                        </div>

                        <div class="max-h-48 overflow-y-auto p-2.5 rounded-xl bg-[#08080a]/90 border border-white/5 text-[10px] ${isSuccess ? 'text-slate-300' : 'text-rose-300'} whitespace-pre-wrap select-text">

${escapeHtml(stdout || stderr || '(Aucune sortie terminal)')}

                        </div>

                    </div>

                `;

            } else if (type === 'web_research') {

                const query = data.query || '';

                const results = data.results || [];

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/15 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-200">

                                <span>🌐</span>

                                <span class="truncate max-w-[220px]">Recherche : "${escapeHtml(query)}"</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-cyan-500/20 text-neutral-300 font-mono text-[10px] font-bold">

                                ${results.length} SOURCES

                            </span>

                        </div>

                        <div class="space-y-2 max-h-56 overflow-y-auto pr-1">

                            ${results.map(r => `

                                <div class="p-2.5 rounded-xl bg-[#08080a]/70 border border-white/5 hover:border-white/15 transition space-y-1">

                                    <div class="flex items-center justify-between">

                                        <a href="${escapeHtml(r.url)}" target="_blank" class="font-bold text-neutral-300 hover:text-cyan-200 text-[11px] truncate flex-1 pr-2">

                                            ${escapeHtml(r.title)} ↗

                                        </a>

                                    </div>

                                    <p class="text-[10px] text-slate-400 line-clamp-2">${escapeHtml(r.snippet)}</p>

                                </div>

                            `).join('')}

                        </div>

                    </div>

                `;

            } else if (type === 'web_reader') {

                const url = data.url || '';

                const title = data.title || 'Page Web';

                const chars = data.character_count || 0;

                const content = data.content || '';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-teal-500/30 shadow-xl space-y-2 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-200">

                                <span>📖</span>

                                <span class="truncate max-w-[220px]">${escapeHtml(title)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-teal-500/20 text-teal-300 font-mono text-[10px] font-bold">

                                ${chars} CARACTÈRES

                            </span>

                        </div>

                        <div class="max-h-48 overflow-y-auto p-2.5 rounded-xl bg-[#08080a]/80 border border-white/5 text-[11px] text-slate-300 leading-relaxed whitespace-pre-wrap">

${escapeHtml(content.substring(0, 1000))}${content.length > 1000 ? '...\n(Contenu tronqué pour affichage)' : ''}

                        </div>

                        <a href="${escapeHtml(url)}" target="_blank" class="text-[10px] text-neutral-200 hover:underline block truncate">

                            Source : ${escapeHtml(url)}

                        </a>

                    </div>

                `;

            } else if (type === 'subagent_task') {

                const role = data.role || 'Agent Spécialiste';

                const prompt = data.task_prompt || '';

                const result = data.result || '';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/20 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-300">

                                <span>🤖</span>

                                <span>Sous-Agent : ${escapeHtml(role)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-white/10 text-neutral-200 font-mono text-[10px] font-bold">

                                ISOLÉ / PARALLÈLE

                            </span>

                        </div>

                        <div class="p-2 rounded-xl bg-[#08080a]/70 border border-white/5 text-[10px] text-slate-400">

                            <span class="text-neutral-200 font-semibold">Mission :</span> ${escapeHtml(prompt)}

                        </div>

                        <div class="p-2.5 rounded-xl bg-white/5 border border-white/10 text-[11px] text-slate-200 leading-relaxed whitespace-pre-wrap max-h-48 overflow-y-auto">

${escapeHtml(result)}

                        </div>

                    </div>

                `;

            } else if (type === 'artifact_view') {

                const title = data.title || 'Artefact';

                const artType = data.artifact_type || 'markdown';

                const path = data.path || '';

                const content = data.content || '';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/15 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-200">

                                <span>📦</span>

                                <span class="truncate max-w-[220px]">Artefact : ${escapeHtml(title)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-fuchsia-500/20 text-fuchsia-300 font-mono text-[10px] font-bold">

                                ${escapeHtml(artType.toUpperCase())}

                            </span>

                        </div>

                        <div class="p-2 rounded-xl bg-[#08080a]/80 border border-white/5 text-[10px] font-mono text-slate-400 truncate">

                            💾 ${escapeHtml(path)}

                        </div>

                        <div class="max-h-52 overflow-y-auto p-2.5 rounded-xl bg-[#08080a]/90 border border-white/5 text-[11px] text-slate-200 whitespace-pre-wrap select-text font-mono">

${escapeHtml(content.substring(0, 1500))}${content.length > 1500 ? '...\n(Voir fichier pour version intégrale)' : ''}

                        </div>

                    </div>

                `;

            } else if (type === 'debugger_report') {

                const errType = data.error_type || 'Erreur';

                const hypo = data.hypothesis || '';

                const fix = data.fix_suggestion || '';

                const test = data.reproduction_test_hint || '';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-rose-500/40 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-rose-400">

                                <span>🔍</span>

                                <span>Diagnostic Debugger : ${escapeHtml(errType)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-rose-500/20 text-rose-300 font-mono text-[10px] font-bold">

                                ROOT CAUSE

                            </span>

                        </div>

                        <div class="p-2 rounded-xl bg-[#08080a]/80 border border-white/5 text-[11px] text-slate-300 space-y-1">

                            <div><strong class="text-rose-400">Hypothèse :</strong> ${escapeHtml(hypo)}</div>

                            <div><strong class="text-emerald-400">Solution :</strong> ${escapeHtml(fix)}</div>

                        </div>

                        ${test ? `

                            <div class="p-2 rounded-xl bg-black/50 border border-white/5 font-mono text-[10px] text-slate-400">

                                🧪 Test : <span class="text-neutral-300">${escapeHtml(test)}</span>

                            </div>

                        ` : ''}

                    </div>

                `;

            } else if (type === 'architect_plan') {

                const title = data.title || 'Plan d\'Architecture';

                const planContent = data.plan_content || '';

                const phases = data.phases_count || 1;

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/15 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-200">

                                <span>🏛️</span>

                                <span class="truncate max-w-[220px]">${escapeHtml(title)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-white/10 text-blue-300 font-mono text-[10px] font-bold">

                                ${phases} PHASES

                            </span>

                        </div>

                        <div class="max-h-56 overflow-y-auto p-2.5 rounded-xl bg-[#08080a]/90 border border-white/5 text-[11px] text-slate-300 whitespace-pre-wrap leading-relaxed select-text font-mono">

${escapeHtml(planContent)}

                        </div>

                    </div>

                `;

            } else if (type === 'subscription_audit') {

                const subs = data.subscriptions || [];

                const monthly = data.total_monthly_eur || 0;

                const annual = data.total_annual_eur || 0;

                const savings = data.potential_annual_savings_eur || 0;

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-amber-500/40 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-amber-400">

                                <span>📊</span>

                                <span>Audit des Abonnements & Prélèvements</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-mono text-[10px] font-bold">

                                +${savings}€ / an d'économies

                            </span>

                        </div>

                        <div class="grid grid-cols-2 gap-2 text-[11px] font-mono">

                            <div class="p-2 rounded-xl bg-[#08080a]/80 border border-white/5">

                                <span class="text-slate-400 text-[10px] block">Total Mensuel</span>

                                <strong class="text-amber-300 text-sm">${monthly} €/mois</strong>

                            </div>

                            <div class="p-2 rounded-xl bg-[#08080a]/80 border border-white/5">

                                <span class="text-slate-400 text-[10px] block">Total Annuel</span>

                                <strong class="text-rose-300 text-sm">${annual} €/an</strong>

                            </div>

                        </div>

                        <div class="space-y-1.5 max-h-48 overflow-y-auto pr-1">

                            ${subs.map(s => `

                                <div class="p-2 rounded-xl bg-[#08080a]/60 border border-white/5 flex items-center justify-between">

                                    <div class="truncate mr-2">

                                        <div class="font-bold text-slate-200">${escapeHtml(s.name)}</div>

                                        <span class="text-[10px] text-slate-400">${escapeHtml(s.category)} • ${s.annual_cost_eur}€/an</span>

                                    </div>

                                    <div class="flex items-center space-x-1.5 flex-shrink-0">

                                        <span class="font-mono font-bold text-amber-300">${s.monthly_price_eur}€</span>

                                        <button onclick="navigator.clipboard.writeText('Objet: Résiliation ${escapeHtml(s.name)}\n\nJe vous notifie par la présente la résiliation immédiate de mon abonnement ${escapeHtml(s.name)} conformément à la loi Hamon.'); this.innerText='Copié !'; setTimeout(() => this.innerText='Résilier', 1500);" class="px-2 py-1 rounded bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 text-[10px] border border-rose-500/30 font-bold transition">

                                            Résilier

                                        </button>

                                    </div>

                                </div>

                            `).join('')}

                        </div>

                    </div>

                `;

            } else if (type === 'nutrition_card') {

                const totalKcal = data.total_calories_kcal || 0;

                const macros = data.macronutrients || {};

                const score = data.nutri_score || 'A';

                const advice = data.health_advice || '';

                const items = data.items || [];

                const scoreColor = score === 'A' ? 'bg-emerald-500 text-black' : (score === 'B' ? 'bg-lime-500 text-black' : 'bg-amber-500 text-black');

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-emerald-500/40 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-emerald-400">

                                <span>🥗</span>

                                <span>Scanner Nutritionnel & Calories</span>

                            </span>

                            <div class="flex items-center space-x-2">

                                <span class="font-mono font-bold text-white text-sm">${totalKcal} kcal</span>

                                <span class="px-2 py-0.5 rounded-full ${scoreColor} font-bold text-[10px]">Score ${score}</span>

                            </div>

                        </div>

                        <div class="grid grid-cols-4 gap-1.5 text-center font-mono text-[10px]">

                            <div class="p-1.5 rounded-lg bg-[#08080a]/80 border border-white/5">

                                <div class="text-neutral-200 font-bold">${macros.protein_g || 0}g</div>

                                <div class="text-slate-500 text-[9px]">Protéines</div>

                            </div>

                            <div class="p-1.5 rounded-lg bg-[#08080a]/80 border border-white/5">

                                <div class="text-amber-400 font-bold">${macros.carbs_g || 0}g</div>

                                <div class="text-slate-500 text-[9px]">Glucides</div>

                            </div>

                            <div class="p-1.5 rounded-lg bg-[#08080a]/80 border border-white/5">

                                <div class="text-rose-400 font-bold">${macros.fat_g || 0}g</div>

                                <div class="text-slate-500 text-[9px]">Lipides</div>

                            </div>

                            <div class="p-1.5 rounded-lg bg-[#08080a]/80 border border-white/5">

                                <div class="text-emerald-400 font-bold">${macros.fiber_g || 0}g</div>

                                <div class="text-slate-500 text-[9px]">Fibres</div>

                            </div>

                        </div>

                        <div class="p-2 rounded-xl bg-[#08080a]/60 border border-white/5 text-[11px] text-slate-300">

                            💡 ${escapeHtml(advice)}

                        </div>

                    </div>

                `;

            } else if (type === 'goals_tracker') {

                const goals = data.goals || [];

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/20 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-300">

                                <span>🎯</span>

                                <span>Objectifs & Projets de Vie (Goals)</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-white/10 text-neutral-200 font-mono text-[10px] font-bold">

                                ${goals.length} ACTIFS

                            </span>

                        </div>

                        <div class="space-y-2 max-h-52 overflow-y-auto pr-1">

                            ${goals.map(g => `

                                <div class="p-2.5 rounded-xl bg-[#08080a]/70 border border-white/5 space-y-1.5">

                                    <div class="flex items-center justify-between text-[11px]">

                                        <strong class="text-slate-200 truncate pr-2">${escapeHtml(g.title)}</strong>

                                        <span class="font-mono font-bold text-neutral-300 text-[10px] flex-shrink-0">${g.progress_percent}%</span>

                                    </div>

                                    <div class="w-full bg-white/5 rounded-full h-1.5 overflow-hidden">

                                        <div class="bg-white h-1.5 rounded-full" style="width: ${g.progress_percent}%"></div>

                                    </div>

                                    <div class="flex items-center justify-between text-[9px] text-slate-500 font-mono">

                                        <span>Catégorie : ${escapeHtml(g.category || 'Général')}</span>

                                        <span>Échéance : ${escapeHtml(g.deadline || 'Flexible')}</span>

                                    </div>

                                </div>

                            `).join('')}

                        </div>

                    </div>

                `;

            } else if (type === 'proactive_ideas') {

                const ideas = data.ideas || [];

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/20 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-300">

                                <i data-lucide="lightbulb" class="w-3.5 h-3.5 inline text-neutral-400"></i>

                                <span>Idées Proactives Personnalisées</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-white/10 text-neutral-200 font-mono text-[10px] font-bold">

                                IA BOT MODE

                            </span>

                        </div>

                        <div class="space-y-1.5">

                            ${ideas.map(id => `

                                <div class="p-2 rounded-xl bg-[#08080a]/60 border border-white/5 hover:border-white/15 transition space-y-1">

                                    <div class="flex items-center justify-between">

                                        <strong class="text-neutral-200 text-[11px]">${escapeHtml(id.title)}</strong>

                                        <span class="text-[9px] font-mono text-emerald-400">${escapeHtml(id.impact)}</span>

                                    </div>

                                    <p class="text-[10px] text-slate-400 leading-tight">${escapeHtml(id.description)}</p>

                                </div>

                            `).join('')}

                        </div>

                    </div>

                `;

            } else if (type === 'whatsapp_status') {

                const recipient = data.recipient || '';

                const preview = data.message_preview || '';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-emerald-500/40 shadow-xl space-y-2 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-emerald-400">

                                <span>💬</span>

                                <span>Passerelle WhatsApp 1:1</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 font-mono text-[10px] font-bold">

                                ENVOYÉ

                            </span>

                        </div>

                        <div class="text-[11px] text-slate-300">

                            Destinataire : <strong class="text-emerald-300 font-mono">${escapeHtml(recipient)}</strong>

                        </div>

                        <div class="p-2 rounded-xl bg-[#08080a]/80 border border-white/5 font-sans text-[11px] text-slate-200">

                            ${escapeHtml(preview)}

                        </div>

                    </div>

                `;

            } else if (type === 'instagram_recipe') {

                const title = data.recipe_title || 'Recette Instagram';

                const ings = data.ingredients || [];

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/15 shadow-xl space-y-2.5 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-200">

                                <span>🍳</span>

                                <span class="truncate max-w-[220px]">${escapeHtml(title)}</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-fuchsia-500/20 text-fuchsia-300 font-mono text-[10px] font-bold">

                                REEL ➔ COURSES

                            </span>

                        </div>

                        <div class="space-y-1 max-h-44 overflow-y-auto pr-1">

                            ${ings.map(i => `

                                <div class="p-1.5 rounded-lg bg-[#08080a]/60 border border-white/5 flex items-center justify-between text-[11px]">

                                    <span class="text-slate-300">• ${escapeHtml(i.item)}</span>

                                    <span class="text-fuchsia-300 font-mono font-bold text-[10px]">${escapeHtml(i.quantity)}</span>

                                </div>

                            `).join('')}

                        </div>

                    </div>

                `;

            } else if (type === 'dynamic_tool_registered') {

                const name = data.tool_name || '';

                const funcs = data.functions_exported || [];

                const desc = data.description || '';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/15 shadow-xl space-y-2 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-200">

                                <span>⚡</span>

                                <span>Outil Dynamique Synthétisé à Chaud</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-cyan-500/20 text-neutral-300 font-mono text-[10px] font-bold">

                                RE-ACT ACTIF

                            </span>

                        </div>

                        <div class="text-[11px] text-slate-300">

                            Nom : <strong class="text-neutral-300 font-mono">${escapeHtml(name)}</strong>

                        </div>

                        <div class="p-2 rounded-xl bg-[#08080a]/80 border border-white/5 font-mono text-[10px] text-slate-400">

                            <div>Fonctions : <span class="text-emerald-400">${escapeHtml(funcs.join(', '))}</span></div>

                            <div class="truncate text-slate-500">${escapeHtml(desc)}</div>

                        </div>

                    </div>

                `;

            } else if (type === 'avatar_hud') {

                const mood = data.mood || 'idle';

                const color = data.glow_color || '#00f0ff';

                const visemesCount = data.visemes_count || 0;

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/15 shadow-xl space-y-2 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-200">

                                <span>👤</span>

                                <span>Avatar 3D Realtime (Lip-Sync)</span>

                            </span>

                            <div class="flex items-center space-x-1.5">

                                <span class="w-2.5 h-2.5 rounded-full animate-pulse" style="background-color: ${color}"></span>

                                <span class="font-mono text-[10px] font-bold text-teal-300 uppercase">${escapeHtml(mood)}</span>

                            </div>

                        </div>

                        <div class="p-2 rounded-xl bg-[#08080a]/80 border border-white/5 flex items-center justify-between text-[10px] font-mono text-slate-400">

                            <span>Visèmes synchronisés : <strong class="text-teal-300">${visemesCount}</strong></span>

                            <span>Expression faciale : <strong class="text-teal-300">${escapeHtml(data.expression || 'calm')}</strong></span>

                        </div>

                    </div>

                `;

            } else if (type === 'virtual_card') {

                const pan = data.masked_pan || '4242 •••• •••• 8912';

                const exp = data.expiration_date || '12/28';

                const cvv = data.cvv || '***';

                const limit = data.spending_limit_eur || 0;

                const merchant = data.merchant_locked || 'Marchand';

                return `

                    <div class="p-4 rounded-2xl bg-gradient-to-br liquid-glass bg-gradient-to-br from-neutral-900 via-[#121216] to-[#08080a] border border-white/20 shadow-2xl space-y-3 text-xs font-mono">

                        <div class="flex items-center justify-between pb-1 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-300">

                                <span>💳</span>

                                <span>Carte Virtuelle Éphémère (Stripe Link)</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 text-[10px] font-bold">

                                15 MIN ACTIVE

                            </span>

                        </div>

                        <div class="p-3 rounded-xl bg-black/40 border border-white/10 space-y-2">

                            <div class="text-slate-400 text-[10px]">Plafond strict : <strong class="text-emerald-400">${limit} €</strong> pour <strong>${escapeHtml(merchant)}</strong></div>

                            <div class="text-lg tracking-widest text-white font-bold text-center py-1 select-all">${pan}</div>

                            <div class="flex items-center justify-between text-[11px] text-slate-300">

                                <span>EXP: <strong>${exp}</strong></span>

                                <span>CVV: <strong class="text-amber-400">${cvv}</strong></span>

                                <span class="text-[9px] text-slate-500">USAGE UNIQUE</span>

                            </div>

                        </div>

                    </div>

                `;

            } else if (type === 'sentinel_verdict') {

                const verdict = data.verdict || 'APPROVED';

                const threat = data.threat_level || 'SAFE';

                const reason = data.reason || '';

                const vColor = verdict === 'APPROVED' ? 'border-emerald-500/40 text-emerald-400 bg-emerald-500/10' : (

                    verdict === 'BLOCKED' ? 'border-rose-500/40 text-rose-400 bg-rose-500/10' : 'border-amber-500/40 text-amber-400 bg-amber-500/10'

                );

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border ${vColor.split(' ')[0]} shadow-xl space-y-2 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-slate-200">

                                <span>🛡️</span>

                                <span>Garde-Fou Sentinel (Gatekeeper)</span>

                            </span>

                            <span class="px-2 py-0.5 rounded-full font-mono text-[10px] font-bold ${vColor}">

                                ${verdict}

                            </span>

                        </div>

                        <div class="text-[11px] text-slate-300">

                            Niveau de menace : <strong class="font-mono">${escapeHtml(threat)}</strong>

                        </div>

                        <div class="p-2 rounded-xl bg-[#08080a]/80 border border-white/5 text-[10px] text-slate-400">

                            ${escapeHtml(reason)}

                        </div>

                    </div>

                `;

            } else if (type === 'computer_use_stream') {

                const url = data.current_url || data.url || 'https://www.google.fr';

                return `

                    <div class="p-3.5 rounded-2xl bg-[#121216] border border-white/15 shadow-2xl space-y-3 text-xs">

                        <div class="flex items-center justify-between pb-1.5 border-b border-white/10">

                            <span class="flex items-center space-x-2 font-bold text-neutral-200">

                                <span>🌐</span>

                                <span>Computer-Use : Navigateur Distant en Direct</span>

                            </span>

                            <div class="flex items-center space-x-2">

                                <span class="px-2 py-0.5 rounded-full bg-cyan-500/20 text-neutral-300 font-mono text-[10px] font-bold">

                                    CDP SCREENCAST 30 FPS

                                </span>

                            </div>

                        </div>

                        <div class="p-1.5 rounded-xl bg-black/60 border border-white/10 flex items-center space-x-2 text-[10px] font-mono text-slate-400">

                            <span>URL :</span>

                            <span class="text-neutral-300 truncate flex-1">${escapeHtml(url)}</span>

                            <button onclick="openComputerUseModal('${escapeHtml(url)}')" class="px-2.5 py-1 rounded bg-white text-black hover:bg-neutral-200 text-white font-bold transition">

                                <i data-lucide="gamepad-2" class="w-3.5 h-3.5 inline mr-1 text-neutral-400"></i>Ouvrir / Take Over

                            </button>

                        </div>

                    </div>

                `;

            }

            return '';

        }



        // Action 1-Click Purchase Human-in-the-Loop

        async function executeApprovedAction(btn, actionId, actionType, payload = {}) {

            const originalHtml = btn.innerHTML;

            btn.disabled = true;

            btn.innerHTML = `<span class="inline-block animate-spin mr-1">⏳</span><span>Signature Enclave VM...</span>`;

            

            try {

                const res = await fetch('/api/actions/execute', {

                    method: 'POST',

                    headers: {'Content-Type': 'application/json'},

                    body: JSON.stringify({ action_id: actionId, action_type: actionType, payload: payload })

                });

                const d = await res.json();

                btn.className = "tactile-btn flex-1 py-2.5 rounded-xl bg-emerald-600/25 border border-emerald-500/40 text-emerald-500 font-bold text-xs flex items-center justify-center space-x-1.5 transition";

                btn.innerHTML = `<span>✓ Validé & Signé (${d.tx_hash.slice(0, 8)}...)</span>`;

            } catch (e) {

                btn.disabled = false;

                btn.innerHTML = originalHtml;

                alert("Erreur lors de la validation : " + e.message);

            }

        }



        // --- ENTRÉE VOCALE (MICROPHONE) ---

        // Contrôle interactif pour les mini-applications et posts Jarvis

        function toggleAppPreviewFrame(btn, url) {

            const card = btn.closest('.p-3.5') || btn.parentElement.parentElement;

            const container = card.querySelector('.app-frame-container');

            if (!container) return;

            if (!container.classList.contains('hidden')) {

                container.classList.add('hidden');

                container.innerHTML = '';

                btn.innerHTML = '<span>Aperçu HUD</span>';

            } else {

                container.classList.remove('hidden');

                container.innerHTML = `<iframe src="${url}" class="w-full h-80 rounded-xl border border-white/20 bg-black"></iframe>`;

                btn.innerHTML = '<span>Fermer Aperçu</span>';

            }

        }



        async function publishPostDirectly(btn, postId) {

            btn.disabled = true;

            btn.innerHTML = `<span>⏳ Publication...</span>`;

            setTimeout(() => {

                btn.className = "tactile-btn py-1.5 px-3 rounded-lg bg-emerald-600/30 text-emerald-400 border border-emerald-500/40 font-bold text-xs";

                btn.innerHTML = `<span>✓ Publié sur LinkedIn !</span>`;

            }, 700);

        }



        function triggerVoiceInput() {

            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

            if (!SpeechRecognition) {

                alert("La reconnaissance vocale n'est pas supportée par ce navigateur (essaie Google Chrome ou Microsoft Edge).");

                return;

            }



            if (isAudioRecording) {

                if (speechRecognizer) speechRecognizer.stop();

                return;

            }



            speechRecognizer = new SpeechRecognition();

            speechRecognizer.lang = 'fr-FR';

            speechRecognizer.continuous = false;

            speechRecognizer.interimResults = true;



            const micBtn = document.getElementById('mic-btn');

            const input = document.getElementById('user-input');



            speechRecognizer.onstart = () => {

                isAudioRecording = true;

                if (micBtn) micBtn.classList.add('text-rose-500', 'animate-pulse');

                if (input) input.placeholder = "🎙️ Parle maintenant... j'écoute...";

            };



            speechRecognizer.onresult = (event) => {

                const transcript = Array.from(event.results).map(r => r[0].transcript).join('');

                if (input) input.value = transcript;

            };



            speechRecognizer.onend = () => {

                isAudioRecording = false;

                if (micBtn) micBtn.classList.remove('text-rose-500', 'animate-pulse');

                if (input) {

                    input.placeholder = "Écrire un message à HoL AI...";

                    if (input.value.trim().length > 0) {

                        handleChatSubmit(null);

                    }

                }

            };



            speechRecognizer.onerror = (e) => {

                console.warn(e);

                isAudioRecording = false;

                if (micBtn) micBtn.classList.remove('text-rose-500', 'animate-pulse');

            };



            speechRecognizer.start();

        }



        // --- PIÈCES JOINTES & TROMBONE ---

        function triggerAttachmentUpload() {

            document.getElementById('chat-file-input').click();

        }



        function handleChatFileUpload(event) {

            const file = event.target.files[0];

            if (!file) return;



            const reader = new FileReader();

            reader.onload = (e) => {

                pendingAttachmentData = e.target.result;

                const preview = document.getElementById('attachment-preview');

                preview.classList.remove('hidden');

                preview.innerHTML = `

                    <div class="inline-flex items-center space-x-2 p-1.5 rounded-xl bg-slate-200 dark:bg-[#18181e] text-xs">

                        <img src="${pendingAttachmentData}" class="w-7 h-7 rounded-lg object-cover" />

                        <span class="truncate max-w-[150px] text-slate-800 dark:text-slate-200 font-medium">${escapeHtml(file.name)}</span>

                        <button type="button" onclick="cancelAttachment()" class="text-slate-400 hover:text-rose-500 px-1 font-bold">✕</button>

                    </div>

                `;

            };

            reader.readAsDataURL(file);

        }



        function cancelAttachment() {

            pendingAttachmentData = null;

            document.getElementById('chat-file-input').value = '';

            const camInput = document.getElementById('camera-direct-input');

            if (camInput) camInput.value = '';

            const preview = document.getElementById('attachment-preview');

            preview.classList.add('hidden');

            preview.innerHTML = '';

        }



        function handleDirectCameraUpload(event) {

            const file = event.target.files[0];

            if (!file) return;



            const reader = new FileReader();

            reader.onload = (e) => {

                pendingAttachmentData = e.target.result;

                const preview = document.getElementById('attachment-preview');

                preview.classList.remove('hidden');

                preview.innerHTML = `

                    <div class="inline-flex items-center space-x-2 p-1.5 rounded-xl bg-emerald-500/20 border border-emerald-500/30 text-xs">

                        <img src="${pendingAttachmentData}" class="w-8 h-8 rounded-lg object-cover" />

                        <span class="truncate max-w-[150px] text-emerald-300 font-medium">Photo Caméra Prête</span>

                        <button type="button" onclick="cancelAttachment()" class="text-slate-400 hover:text-rose-500 px-1 font-bold">✕</button>

                    </div>

                `;

                const input = document.getElementById('user-input');

                if (!input.value.trim()) {

                    input.value = "Analyse cette photo de mon repas / ticket de caisse stp !";

                }

            };

            reader.readAsDataURL(file);

        }



        // --- HELPERS & MODALS ---


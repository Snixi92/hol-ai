                <button onclick="closeBackgroundModal()" class="tactile-btn p-1.5 rounded-xl text-neutral-400 hover:text-white hover:bg-white/10" title="Fermer"><i data-lucide="x" class="w-4 h-4"></i></button>

            </div>

            <div class="space-y-2 text-xs">

                <div class="p-3 rounded-xl bg-slate-100 dark:bg-[#08080a] border border-slate-200 dark:border-white/5 flex items-center justify-between">


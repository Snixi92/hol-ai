    <!-- ========================================================================= -->

    <div id="jarvis-hud-overlay" class="fixed inset-0 z-50 bg-[#08080a]/95 backdrop-blur-2xl hidden flex flex-col justify-between p-4 sm:p-8 text-white select-none overflow-y-auto">

        

        <!-- En-tête HUD -->

        <div class="flex items-center justify-between pb-4 border-b border-white/15">

            <div class="flex items-center space-x-3">

                <div class="relative w-10 h-10 rounded-xl bg-gradient-to-tr bg-white/20 p-[1.5px] shadow-lg shadow-black/40">

                    <div class="w-full h-full bg-[#090d1a] rounded-[10px] flex items-center justify-center font-mono font-bold text-neutral-200 text-sm">

                        ⚡

                    </div>

                </div>

                <div>

                    <div class="flex items-center space-x-2">

                        <span class="font-extrabold text-base tracking-wider bg-gradient-to-r from-white via-neutral-200 to-neutral-400 bg-clip-text text-transparent font-mono">JARVIS • HoL AI COCKPIT</span>

                        <span class="px-2 py-0.5 rounded-full bg-white/10 border border-white/15 text-[10px] font-mono text-neutral-300">AUDIO DUCKING ACTIF</span>

                    </div>

                    <div class="text-[11px] text-slate-400 flex items-center space-x-2">

                        <span id="jarvis-hud-clock" class="font-mono text-neutral-300">--:--:--</span>

                        <span>•</span>

                        <span class="text-neutral-300 flex items-center space-x-1"><i data-lucide="sparkles" class="w-3.5 h-3.5 text-neutral-400 inline"></i> <span>Synthèse Vocale & Double-Clap</span></span>

                    </div>

                </div>

            </div>



            <div class="flex items-center space-x-2">

                <button onclick="toggleClapListening()" id="hud-clap-toggle" class="tactile-btn px-3 py-1.5 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-bold flex items-center space-x-1.5">

                    <span id="hud-clap-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>

                    <span id="hud-clap-label"><i data-lucide="mic" class="w-3.5 h-3.5 inline mr-1 text-neutral-300"></i>Détecteur Clap : ACTIF</span>

                </button>

                <button onclick="closeJarvisHud()" class="tactile-btn p-2 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 hover:text-white text-xs font-mono" title="Fermer le plein écran">

                    <i data-lucide="x" class="w-3.5 h-3.5 inline mr-1"></i><span>Échap</span>

                </button>

            </div>

        </div>



        <!-- Centre Holographique : Réacteur Arc & Cartes de Briefing -->

        <div class="flex-1 my-4 flex flex-col items-center justify-center space-y-6 max-w-6xl w-full mx-auto">

            

            <!-- Réacteur Arc Central & Visualiseur Audio -->

            <div class="relative flex flex-col items-center justify-center my-2">

                <!-- Anneaux concentriques tournants en CSS -->

                <div class="relative w-36 h-36 sm:w-44 sm:h-44 flex items-center justify-center">

                    <div id="arc-ring-outer" class="absolute inset-0 rounded-full border-2 border-dashed border-white/20 animate-spin" style="animation-duration: 20s;"></div>

                    <div id="arc-ring-mid" class="absolute inset-2 rounded-full border border-white/25 animate-spin" style="animation-duration: 12s; animation-direction: reverse;"></div>

                    <div id="arc-core" class="w-24 h-24 sm:w-28 sm:h-28 rounded-full liquid-glass border-2 border-white/40 flex flex-col items-center justify-center shadow-[0_0_30px_rgba(255,255,255,0.2)] transition-transform duration-100">

                        <span class="flex items-center justify-center animate-pulse"><i data-lucide="mic" class="w-8 h-8 text-white"></i></span>

                        <span id="jarvis-status-badge" class="text-[9px] font-mono tracking-widest text-neutral-200 font-bold uppercase mt-1">Prêt</span>

                    </div>

                </div>



                <!-- Visualiseur d'ondes audio (Barres réactives) -->

                <div id="audio-wave-bars" class="flex items-center space-x-1.5 h-6 mt-3">

                    <span class="w-1.5 bg-white/70 rounded-full h-2 transition-all duration-75"></span>

                    <span class="w-1.5 bg-white/70 rounded-full h-4 transition-all duration-75"></span>

                    <span class="w-1.5 bg-white/70 rounded-full h-6 transition-all duration-75"></span>

                    <span class="w-1.5 bg-white/70 rounded-full h-3 transition-all duration-75"></span>

                    <span class="w-1.5 bg-white/70 rounded-full h-5 transition-all duration-75"></span>

                    <span class="w-1.5 bg-white/70 rounded-full h-2 transition-all duration-75"></span>

                </div>

            </div>



            <!-- Grille de Tuiles Holographiques du Briefing -->

            <div id="hud-tiles-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 w-full text-xs">

                <!-- Tuile 1 : Météo -->

                <div class="p-3.5 rounded-2xl liquid-glass-subtle p-3.5 rounded-2xl border border-white/15 backdrop-blur-md space-y-1.5 shadow-lg">

                    <div class="flex items-center justify-between text-slate-400 font-mono text-[10px]">

                        <span><i data-lucide="cloud-sun" class="w-3.5 h-3.5 inline mr-1 text-neutral-400"></i>CONDITIONS LOCALES</span>

                        <span id="tile-weather-temp" class="text-neutral-200 font-bold font-sans text-xs">19°C</span>

                    </div>

                    <div id="tile-weather-city" class="font-bold text-white text-sm">Paris & Région</div>

                    <div id="tile-weather-desc" class="text-slate-300 text-[11px]">Ciel printanier agréable 🌤️, vent 12 km/h</div>

                </div>



                <!-- Tuile 2 : Stripe / Métriques Cash -->

                <div class="p-3.5 rounded-2xl liquid-glass-subtle p-3.5 rounded-2xl border border-white/15 backdrop-blur-md space-y-1.5 shadow-lg">

                    <div class="flex items-center justify-between text-slate-400 font-mono text-[10px]">

                        <span><i data-lucide="credit-card" class="w-3.5 h-3.5 inline mr-1 text-neutral-400"></i>STRIPE CASH FLOW</span>

                        <span id="tile-stripe-trend" class="text-emerald-400 font-bold">+18% vs hier</span>

                    </div>

                    <div id="tile-stripe-rev" class="font-bold text-white text-sm">1 240,50 €</div>

                    <div id="tile-stripe-orders" class="text-slate-300 text-[11px]">14 commandes aujourd'hui</div>

                </div>



                <!-- Tuile 3 : E-mails d'Action -->

                <div class="p-3.5 rounded-2xl liquid-glass-subtle p-3.5 rounded-2xl border border-white/15 backdrop-blur-md space-y-1.5 shadow-lg">

                    <div class="flex items-center justify-between text-slate-400 font-mono text-[10px]">

                        <span class="flex items-center space-x-1"><i data-lucide="mail" class="w-3.5 h-3.5 inline text-neutral-400"></i><span>EMAILS URGENTS</span></span>

                        <span id="tile-emails-count" class="text-amber-400 font-bold">2 en attente</span>

                    </div>

                    <div id="tile-emails-summary" class="font-bold text-white text-sm">Stock Fournisseur & Client VIP</div>

                    <div class="text-slate-300 text-[11px]">Filtre anti-prompt injection actif</div>

                </div>



                <!-- Tuile 4 : Agenda du Jour -->

                <div class="p-3.5 rounded-2xl liquid-glass-subtle p-3.5 rounded-2xl border border-white/15 backdrop-blur-md space-y-1.5 shadow-lg">

                    <div class="flex items-center justify-between text-slate-400 font-mono text-[10px]">

                        <span class="flex items-center space-x-1"><i data-lucide="calendar" class="w-3.5 h-3.5 inline text-neutral-400"></i><span>AGENDA & RÉUNIONS</span></span>

                        <span class="text-neutral-300 font-bold font-mono">3 créneaux</span>

                    </div>

                    <div id="tile-schedule-next" class="font-bold text-white text-sm">10h30 • Sourcing & Offres Web</div>

                    <div class="text-slate-300 text-[11px]">14h00 Transporteurs • 17h00 Bilan</div>

                </div>



                <!-- Tuile 5 : Colis & Logistique -->

                <div class="p-3.5 rounded-2xl liquid-glass-subtle p-3.5 rounded-2xl border border-white/15 backdrop-blur-md space-y-1.5 shadow-lg">

                    <div class="flex items-center justify-between text-slate-400 font-mono text-[10px]">

                        <span class="flex items-center space-x-1"><i data-lucide="truck" class="w-3.5 h-3.5 inline text-neutral-400"></i><span>COLIS EN COURS</span></span>

                        <span class="text-neutral-300 font-bold font-mono">2 livraisons</span>

                    </div>

                    <div id="tile-package-ups" class="font-bold text-white text-sm">UPS Express • 14h30</div>

                    <div class="text-slate-300 text-[11px]">Mondial Relay au locker (Code 4829)</div>

                </div>



                <!-- Tuile 6 : Tâches Clés -->

                <div class="p-3.5 rounded-2xl bg-[#0e1322]/80 border border-rose-500/20 backdrop-blur-md space-y-1.5 shadow-lg">

                    <div class="flex items-center justify-between text-slate-400 font-mono text-[10px]">

                        <span class="flex items-center space-x-1"><i data-lucide="target" class="w-3.5 h-3.5 inline text-neutral-400"></i><span>PRIORITÉS DU JOUR</span></span>

                        <span class="text-rose-400 font-bold font-mono">Top 3</span>

                    </div>

                    <div id="tile-tasks-top" class="font-bold text-white text-sm">Valider nouvelle sélection produits</div>

                    <div class="text-slate-300 text-[11px]">Contrôle suivi colis UPS express</div>

                </div>

            </div>

        </div>



        <!-- Bas du HUD : Karaoké & Contrôles Audio -->

        <div class="border-t border-white/15 pt-4 space-y-3 max-w-4xl w-full mx-auto">

            <!-- Transcription Karaoké en Direct -->

            <div class="p-3.5 rounded-2xl bg-[#090d1a]/90 border border-white/15 shadow-inner">

                <div class="text-[10px] uppercase tracking-wider font-mono text-neutral-200 font-bold mb-1 flex items-center justify-between">

                    <span class="flex items-center space-x-1"><i data-lucide="message-square" class="w-3.5 h-3.5 inline text-neutral-400"></i><span>Synthèse Vocale Live (Big Sis Energy & Humour) :</span>

                    <span id="speech-state-badge" class="text-emerald-400 font-mono">🔊 Prête</span>

                </div>

                <div id="hud-live-transcript" class="text-sm sm:text-base font-medium text-slate-100 leading-relaxed min-h-[44px]">

                    Tapez deux fois des mains 👏 ou appuyez sur [Espace] pour déclencher le Jarvis Morning Briefing...

                </div>

            </div>



            <!-- Contrôles -->

            <div class="flex flex-wrap items-center justify-between gap-2 text-xs">

                <div class="flex items-center space-x-2">

                    <button onclick="triggerJarvisMode()" class="tactile-btn px-4 py-2 rounded-xl bg-gradient-to-r bg-white text-black hover:from-cyan-400 hover:to-indigo-500 text-white font-bold flex items-center space-x-1.5 shadow-md shadow-black/40 cursor-pointer">

                        <span>▶️</span>

                        <span>Relancer le Briefing</span>

                    </button>

                    <button onclick="stopJarvisAudio()" class="tactile-btn px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 border border-white/10 font-medium cursor-pointer">

                        ⏹️ Arrêter la Voix

                    </button>

                </div>



                <div class="flex items-center space-x-3 text-slate-400 font-mono text-[11px]">

                    <span>Raccourcis : <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-white font-bold">Espace</kbd> Lancer • <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-white font-bold">Échap</kbd> Fermer</span>

                </div>

            </div>

        </div>


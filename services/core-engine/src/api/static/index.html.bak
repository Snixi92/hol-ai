<!DOCTYPE html>
<html lang="fr" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover, interactive-widget=resizes-content">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#08080a">
    <title>HoL AI — Assistant Personnel & Sourcing Intelligent</title>
    
    <!-- PWA Manifest & Icons -->
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg">

    <!-- Fonts : Apple SF Pro + Plus Jakarta Sans + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Lucide Vector Icons (Apple SF Symbols style) -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['-apple-system', 'BlinkMacSystemFont', '"SF Pro Text"', '"SF Pro Display"', '"SF Pro"', '"Plus Jakarta Sans"', 'sans-serif'],
                        mono: ['"JetBrains Mono"', '"SF Mono"', 'Menlo', 'monospace'],
                    },
                    colors: {
                        obsidian: {
                            950: '#050507',
                            900: '#08080a',
                            850: '#101014',
                            800: '#18181e',
                            700: '#22222a',
                        },
                        titanium: {
                            50: '#f4f4f6',
                            100: '#e4e4e7',
                            200: '#d4d4d8',
                            300: '#a1a1aa',
                            400: '#71717a',
                            500: '#52525b',
                            600: '#3f3f46',
                            700: '#27272a',
                            800: '#18181b',
                            900: '#09090b',
                        },
                        space: {
                            950: '#050507',
                            900: '#08080a',
                            850: '#101014',
                            800: '#18181e',
                            700: '#22222a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
                :root {
            --glass-blur: 28px;
            --glass-saturate: 190%;
            --glass-contrast: 105%;
            --spring-standard: cubic-bezier(0.22, 1, 0.36, 1);
            --spring-bounce: cubic-bezier(0.16, 1, 0.3, 1);
            --spring-snappy: cubic-bezier(0.2, 0, 0, 1);
            --safe-top: env(safe-area-inset-top, 0px);
            --safe-bottom: env(safe-area-inset-bottom, 0px);
            --safe-left: env(safe-area-inset-left, 0px);
            --safe-right: env(safe-area-inset-right, 0px);
        }

        /* Mobile Safe-Area Insets for iOS 27 */
        header, #header-messaging, #header-perplexity, #header-chatgpt {
            padding-top: max(0.5rem, env(safe-area-inset-top, 0px)) !important;
        }
        .ios-dock-container {
            bottom: calc(0.75rem + env(safe-area-inset-bottom, 0px)) !important;
            padding-bottom: env(safe-area-inset-bottom, 0px);
        }
        .ios-chat-scroll {
            padding-bottom: calc(11.5rem + env(safe-area-inset-bottom, 0px)) !important;
        }

        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "SF Pro", "Plus Jakarta Sans", sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            -webkit-tap-highlight-color: transparent;
            transition: background-color 0.3s var(--spring-standard), color 0.3s var(--spring-standard);
        }

        /* Thème Sombre : Obsidian OLED profond avec lumière ambiante Apple */
        html.dark body {
            background-color: #08080a;
            color: #f4f4f6;
            background-image: 
                radial-gradient(at 15% 20%, rgba(255, 255, 255, 0.08) 0px, transparent 45%),
                radial-gradient(at 85% 75%, rgba(160, 180, 210, 0.05) 0px, transparent 50%),
                radial-gradient(at 50% 50%, rgba(255, 255, 255, 0.02) 0px, transparent 65%);
        }

        /* Thème Clair : Frosted Pure Slate avec brillance ambiante */
        html:not(.dark) body {
            background-color: #f5f5f7;
            color: #09090b;
            background-image: 
                radial-gradient(at 20% 20%, rgba(0, 0, 0, 0.035) 0px, transparent 60%),
                radial-gradient(at 80% 80%, rgba(0, 0, 0, 0.025) 0px, transparent 60%);
        }

        /* --- MOTEUR LIQUID GLASS APPLE iOS 27 (MASTER SPEC "REGULAR GLASS") --- */

        .liquid-glass, .liquid-glass-regular {
            position: relative;
            background: 
                linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.025) 35%, rgba(0, 0, 0, 0.06) 65%, rgba(255, 255, 255, 0.09) 100%),
                rgba(14, 14, 18, 0.52);
            backdrop-filter: blur(28px) saturate(220%) contrast(108%);
            -webkit-backdrop-filter: blur(28px) saturate(220%) contrast(108%);
            border: 1px solid rgba(255, 255, 255, 0.20);
            box-shadow: 
                /* Arête spéculaire supérieure ultra-fine rasoir */
                inset 0 1.6px 2px 0 rgba(255, 255, 255, 0.85),
                /* Réfraction d'ombre inférieure (effet d'épaisseur de lentille) */
                inset 0 -2px 3px 0 rgba(0, 0, 0, 0.50),
                /* Biseau latéral gauche */
                inset 2px 0 3px 0 rgba(255, 255, 255, 0.30),
                /* Biseau latéral droit */
                inset -2px 0 3px 0 rgba(255, 255, 255, 0.18),
                /* Micro-aberration chromatique périphérique */
                0 0 1px 0 rgba(255, 80, 80, 0.15),
                0 0 2px 0 rgba(80, 160, 255, 0.15),
                /* Ombre volumétrique douce et diffuse */
                0 28px 64px -10px rgba(0, 0, 0, 0.82);
            transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
                        box-shadow 0.35s cubic-bezier(0.22, 1, 0.36, 1);
        }

        /* Réfraction interactive au survol & toucher (Dynamisme optique de Fresnel) */
        .liquid-glass::before, .liquid-glass-regular::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: radial-gradient(
                circle 280px at var(--mouse-x, 50%) var(--mouse-y, 50%),
                rgba(255, 255, 255, 0.28) 0%,
                rgba(255, 255, 255, 0.05) 40%,
                transparent 70%
            );
            opacity: 0.92;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }

        /* Dock flottant : Master Capsule Fluide Apple Liquid Glass */
        .liquid-glass-dock {
            position: relative;
            background: 
                linear-gradient(135deg, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0.02) 35%, rgba(0, 0, 0, 0.05) 65%, rgba(255, 255, 255, 0.10) 100%),
                rgba(14, 14, 18, 0.52);
            backdrop-filter: blur(32px) saturate(220%) contrast(108%);
            -webkit-backdrop-filter: blur(32px) saturate(220%) contrast(108%);
            border: 1px solid rgba(255, 255, 255, 0.22);
            box-shadow: 
                inset 0 1.8px 2.5px 0 rgba(255, 255, 255, 0.88),
                inset 0 -2.2px 3.5px 0 rgba(0, 0, 0, 0.55),
                inset 2.2px 0 3.5px 0 rgba(255, 255, 255, 0.35),
                inset -2.2px 0 3.5px 0 rgba(255, 255, 255, 0.20),
                0 0 1px 0 rgba(255, 80, 80, 0.16),
                0 0 2px 0 rgba(80, 160, 255, 0.16),
                0 32px 72px -12px rgba(0, 0, 0, 0.85);
        }

        .liquid-glass-dock::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: radial-gradient(
                circle 320px at var(--mouse-x, 50%) var(--mouse-y, 50%),
                rgba(255, 255, 255, 0.30) 0%,
                rgba(255, 255, 255, 0.06) 40%,
                transparent 70%
            );
            opacity: 0.95;
            pointer-events: none;
            transition: opacity 0.25s ease;
        }

        /* Thème clair : Liquid Glass cristal pur poli */
        html:not(.dark) .liquid-glass, 
        html:not(.dark) .liquid-glass-regular,
        html:not(.dark) .liquid-glass-dock {
            background: 
                linear-gradient(135deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.36) 35%, rgba(240, 240, 248, 0.25) 65%, rgba(255, 255, 255, 0.55) 100%),
                rgba(255, 255, 255, 0.68);
            border: 1px solid rgba(255, 255, 255, 0.95);
            box-shadow: 
                inset 0 1.6px 2px 0 rgba(255, 255, 255, 0.98),
                inset 0 -1.6px 2px 0 rgba(0, 0, 0, 0.06),
                inset 1.6px 0 2px 0 rgba(255, 255, 255, 0.60),
                inset -1.6px 0 2px 0 rgba(255, 255, 255, 0.40),
                0 20px 48px -10px rgba(15, 23, 42, 0.14);
        }

        /* Contrôles et pills subtils en Liquid Glass */
        .liquid-glass-subtle {
            position: relative;
            background: 
                linear-gradient(135deg, rgba(255, 255, 255, 0.10) 0%, rgba(255, 255, 255, 0.02) 50%, rgba(255, 255, 255, 0.06) 100%),
                rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(20px) saturate(190%);
            -webkit-backdrop-filter: blur(20px) saturate(190%);
            border: 1px solid rgba(255, 255, 255, 0.14);
            box-shadow: 
                inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.45),
                inset 0 -1px 1px 0 rgba(0, 0, 0, 0.25),
                0 10px 28px -6px rgba(0, 0, 0, 0.40);
        }

        html:not(.dark) .liquid-glass-subtle {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(20px) saturate(190%);
            -webkit-backdrop-filter: blur(20px) saturate(190%);
            border: 1px solid rgba(255, 255, 255, 0.92);
            box-shadow: 
                inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.95),
                0 8px 24px -6px rgba(15, 23, 42, 0.06);
        }

        /* Apple HIG Calque de Contenu Standard : lisibilité absolue sans verre parasite */
        .bubble-assistant {
            background: #111115 !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35) !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }

        html:not(.dark) .bubble-assistant {
            background: #ffffff !important;
            border: 1px solid rgba(0, 0, 0, 0.08) !important;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.06) !important;
        }

        /* Boutons de suggestions rapides dans le calque de contenu */
        .suggestion-chip {
            background: #18181f;
            border: 1px solid rgba(255, 255, 255, 0.10);
            color: #e4e4e7;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
            transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .suggestion-chip:hover {
            background: #24242e;
            border-color: rgba(255, 255, 255, 0.22);
            color: #ffffff;
            transform: translateY(-1px) scale(1.02);
        }

        html:not(.dark) .suggestion-chip {
            background: #f0f0f4;
            border: 1px solid rgba(0, 0, 0, 0.08);
            color: #18181b;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
        }

        html:not(.dark) .suggestion-chip:hover {
            background: #e4e4e9;
            border-color: rgba(0, 0, 0, 0.16);
        }

        /* Bulle Utilisateur : High-End Obsidian / Titanium */
        .bubble-user-glass {
            background: #1c1c22;
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.18);
            box-shadow: 
                inset 0 1px 1px 0 rgba(255, 255, 255, 0.32),
                0 8px 22px -4px rgba(0, 0, 0, 0.45);
        }

        html:not(.dark) .bubble-user-glass {
            background: #18181b;
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.25);
            box-shadow: 
                inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.45),
                0 8px 20px -4px rgba(0, 0, 0, 0.18);
        }

        /* Avatar Apple Frosted Sphere */
        .apple-avatar {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.24), rgba(255, 255, 255, 0.08));
            border: 1px solid rgba(255, 255, 255, 0.30);
            box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.6), 0 4px 12px rgba(0, 0, 0, 0.30);
            color: #ffffff;
            font-weight: 700;
        }

        /* Apple HIG Scroll Edge Effect (Rule #6) */
        .ios-chat-scroll {
            mask-image: linear-gradient(to bottom, transparent 0%, black 20px, black calc(100% - 36px), transparent 100%);
            -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 20px, black calc(100% - 36px), transparent 100%);
        }

        /* Apple HIG Accessibilité (Rule #5) */
        @media (prefers-reduced-transparency: reduce) {
            .liquid-glass, .liquid-glass-regular, .liquid-glass-dock, .liquid-glass-subtle {
                backdrop-filter: none !important;
                -webkit-backdrop-filter: none !important;
                background: #121216 !important;
                border: 1px solid rgba(255, 255, 255, 0.25) !important;
            }
            html:not(.dark) .liquid-glass,
            html:not(.dark) .liquid-glass-regular,
            html:not(.dark) .liquid-glass-dock,
            html:not(.dark) .liquid-glass-subtle {
                background: #ffffff !important;
                border: 1px solid rgba(0, 0, 0, 0.15) !important;
            }
        }

        @media (prefers-contrast: more) {
            .liquid-glass, .liquid-glass-regular, .liquid-glass-dock {
                border: 2px solid rgba(255, 255, 255, 0.45) !important;
            }
            html:not(.dark) .liquid-glass,
            html:not(.dark) .liquid-glass-regular,
            html:not(.dark) .liquid-glass-dock {
                border: 2px solid rgba(0, 0, 0, 0.40) !important;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .msg-animate, .tactile-btn, .liquid-glass, .liquid-glass-regular, .liquid-glass-dock {
                animation: none !important;
                transition: none !important;
            }
            .liquid-glass::before, .liquid-glass-regular::before, .liquid-glass-dock::before {
                display: none !important;
            }
        }

        /* Animations à Ressort (Apple Spring Physics) */
        @keyframes appleMessageSpring {
            0% {
                opacity: 0;
                transform: translateY(14px) scale(0.975);
            }
            65% {
                opacity: 0.98;
                transform: translateY(-1.5px) scale(1.005);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .msg-animate {
            animation: appleMessageSpring 0.38s var(--spring-standard) forwards;
        }

        /* Tactile buttons avec rebond élastique iOS 27 */
        .tactile-btn {
            transition: transform 0.22s var(--spring-standard), 
                        background-color 0.15s ease, 
                        border-color 0.15s ease, 
                        box-shadow 0.22s var(--spring-standard),
                        opacity 0.15s ease;
        }

        .tactile-btn:hover {
            transform: translateY(-1px) scale(1.018);
        }

        .tactile-btn:active {
            transform: scale(0.94) !important;
        }

        /* Smooth scrollbar ultra discrète */
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.16); border-radius: 9999px; }
        html:not(.dark) ::-webkit-scrollbar-thumb { background: rgba(0, 0, 0, 0.16); }

        /* Styles spécifiques aux 3 modes */
        body.style-messaging #sidebar { display: none !important; }
        body.style-messaging #header-messaging { display: flex !important; }
        body.style-messaging #header-perplexity { display: none !important; }
        body.style-messaging #header-chatgpt { display: none !important; }
        body.style-messaging .bubble-user {
            background-color: #18181b;
            color: #ffffff;
            border-bottom-right-radius: 6px !important;
        }
        body.style-messaging .bubble-assistant {
            border-bottom-left-radius: 6px !important;
        }

        body.style-perplexity #sidebar { display: none !important; }
        body.style-perplexity #header-messaging { display: none !important; }
        body.style-perplexity #header-perplexity { display: flex !important; }
        body.style-perplexity #header-chatgpt { display: none !important; }
        body.style-perplexity .search-hub-banner { display: block !important; }

        body.style-chatgpt #sidebar { display: flex !important; }
        body.style-chatgpt #header-messaging { display: none !important; }
        body.style-chatgpt #header-perplexity { display: none !important; }
        body.style-chatgpt #header-chatgpt { display: flex !important; }

        /* Mode Sheet Mobile iOS 27 */
        @media (max-width: 640px) {
            .ios-sheet-modal {
                border-bottom-left-radius: 0 !important;
                border-bottom-right-radius: 0 !important;
                border-top-left-radius: 32px !important;
                border-top-right-radius: 32px !important;
                max-height: 90vh;
                margin-top: auto;
            }
        }
    </style>
</head>
<body class="flex flex-col lg:flex-row h-full w-full overflow-hidden antialiased style-messaging">
    <!-- SVG FILTRE OPTIQUE DE RÉFRACTION LIQUID GLASS (LOI DE SNELL & DISPLACEMENT MAP) -->
    <svg class="sr-only" aria-hidden="true" width="0" height="0" style="position: absolute; width: 0; height: 0; pointer-events: none;">
      <defs>
        <filter id="apple-liquid-glass-refract" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="2" result="noise" />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" xChannelSelector="R" yChannelSelector="G" result="refracted" />
          <feGaussianBlur in="refracted" stdDeviation="0.3" result="blurred" />
          <feSpecularLighting in="noise" surfaceScale="2.5" specularConstant="1.4" specularExponent="24" lighting-color="#ffffff" result="specular">
            <fePointLight x="250" y="-120" z="350" />
          </feSpecularLighting>
          <feComposite in="specular" in2="SourceGraphic" operator="in" result="specular-composite" />
          <feMerge>
            <feMergeNode in="blurred" />
            <feMergeNode in="specular-composite" />
          </feMerge>
        </filter>
      </defs>
    </svg>

    <!-- MOBILE SIDEBAR BACKDROP (Pour mode ChatGPT) -->
    <div id="sidebar-backdrop" onclick="toggleSidebar()" class="fixed inset-0 bg-black/60 z-30 hidden backdrop-blur-md transition-opacity"></div>

    <!-- SIDEBAR GAUCHE (Actif en mode ChatGPT) -->
    <aside id="sidebar" class="hidden fixed lg:static inset-y-0 left-0 w-64 liquid-glass border-r border-white/10 flex flex-col z-40 transform -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-out">
        <div class="p-3.5 border-b border-white/10 flex items-center justify-between">
            <button onclick="startNewChat()" class="tactile-btn flex-1 py-2 px-3 rounded-2xl bg-white dark:bg-white text-black hover:bg-neutral-200 flex items-center justify-center space-x-2 text-xs font-semibold shadow-md">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Nouvelle discussion</span>
            </button>
            <button onclick="toggleSidebar()" class="lg:hidden p-2 text-neutral-400 hover:text-white ml-1 rounded-xl hover:bg-white/10" title="Fermer"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>

        <div class="flex-1 overflow-y-auto p-2.5 space-y-1">
            <div class="text-[10px] uppercase font-bold tracking-wider text-neutral-400 px-2.5 py-1.5 flex items-center justify-between">
                <span>Discussions récentes</span>
                <span class="text-[9px] font-mono text-neutral-500">3 chats</span>
            </div>
            <button onclick="sendQuickPrompt('vas sur cdiscount et trouve moi le pc portable le moin chère avec une 5060')" class="w-full text-left p-2.5 rounded-xl hover:bg-white/10 text-xs font-medium text-neutral-300 truncate flex items-center space-x-2.5 transition tactile-btn">
                <i data-lucide="laptop" class="w-4 h-4 text-neutral-400 flex-shrink-0"></i>
                <span class="truncate">PC Gamer RTX 4060 Cdiscount</span>
            </button>
            <button onclick="sendQuickPrompt('trouve le macbook le moins cher actuellement')" class="w-full text-left p-2.5 rounded-xl hover:bg-white/10 text-xs font-medium text-neutral-300 truncate flex items-center space-x-2.5 transition tactile-btn">
                <i data-lucide="apple" class="w-4 h-4 text-neutral-400 flex-shrink-0"></i>
                <span class="truncate">Apple MacBook Air M2</span>
            </button>
            <button onclick="sendQuickPrompt('Surveille Amazon pour me choper une PS5 pas chère')" class="w-full text-left p-2.5 rounded-xl hover:bg-white/10 text-xs font-medium text-neutral-300 truncate flex items-center space-x-2.5 transition tactile-btn">
                <i data-lucide="gamepad-2" class="w-4 h-4 text-neutral-400 flex-shrink-0"></i>
                <span class="truncate">PS5 Slim Amazon</span>
            </button>
        </div>

        <div class="p-3 border-t border-white/10 flex items-center justify-between text-xs">
            <span class="text-neutral-400 font-mono text-[11px] flex items-center space-x-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>HoL AI</span>
            </span>
            <div class="flex items-center space-x-1">
                <button onclick="togglePhoneConnectModal()" class="tactile-btn p-1.5 rounded-xl text-neutral-400 hover:text-white hover:bg-white/10" title="Version mobile (QR Code & Accès réseau)">
                    <i data-lucide="smartphone" class="w-4 h-4"></i>
                </button>
                <button onclick="openSettingsModal()" class="tactile-btn p-1.5 rounded-xl text-neutral-400 hover:text-white hover:bg-white/10" title="Paramètres">
                    <i data-lucide="settings" class="w-4 h-4"></i>
                </button>
            </div>
        </div>
    </aside>

    <!-- ZONE PRINCIPALE DE DISCUSSION -->
    <main class="flex-1 flex flex-col h-full w-full min-w-0 max-w-full relative overflow-hidden">

        <!-- HEADER 1 : STYLE MESSAGERIE (DÉFAUT - Type Telegram / WhatsApp) -->
        <header id="header-messaging" class="h-14 sm:h-16 px-3 sm:px-4 flex items-center justify-between liquid-glass z-20 flex-shrink-0 w-full min-w-0">
            <div class="flex items-center space-x-2 sm:space-x-3 min-w-0 flex-1 mr-2">
                <div class="relative flex-shrink-0">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full apple-avatar flex items-center justify-center font-bold text-xs sm:text-sm">
                        H
                    </div>
                    <span class="absolute bottom-0 right-0 w-2.5 h-2.5 sm:w-3 sm:h-3 bg-emerald-400 border-2 border-[#08080a] rounded-full"></span>
                </div>
                <div class="min-w-0 truncate">
                    <div class="font-bold text-xs sm:text-sm text-neutral-900 dark:text-white flex items-center space-x-1.5">
                        <span class="truncate sm:hidden">HoL AI</span>
                        <span class="truncate hidden sm:inline">HoL AI Assistant</span>
                        <span class="text-[9px] sm:text-[10px] px-1.5 py-0.5 rounded-full bg-white/10 text-neutral-300 font-mono font-semibold border border-white/10 flex-shrink-0">Live</span>
                    </div>
                    <div class="text-[10px] sm:text-[11px] text-neutral-400 flex items-center space-x-1 truncate">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse flex-shrink-0"></span>
                        <span class="truncate sm:hidden">En ligne</span>
                        <span class="truncate hidden sm:inline">En ligne • Répond instantanément</span>
                    </div>
                </div>
            </div>

            <!-- Actions du Header -->
            <div class="flex items-center space-x-1 sm:space-x-1.5 flex-shrink-0">
                <!-- Bouton Computer-Use Live Stream -->
                <button onclick="openComputerUseModal('https://www.google.fr')" class="tactile-btn flex items-center space-x-1.5 px-2.5 sm:px-3 py-1.5 rounded-2xl liquid-glass-subtle hover:bg-white/15 text-neutral-200 text-xs font-semibold shadow-sm" title="Ouvrir le navigateur virtuel en direct (Mode Take Over)">
                    <i data-lucide="globe" class="w-3.5 h-3.5 text-neutral-300"></i>
                    <span class="font-semibold text-[11px] hidden xs:inline">Computer-Use</span>
                </button>

                <!-- Bouton Jarvis Fullscreen HUD -->
                <button onclick="triggerJarvisMode()" class="tactile-btn flex items-center space-x-1.5 px-2.5 sm:px-3 py-1.5 rounded-2xl liquid-glass-subtle hover:bg-white/15 text-neutral-200 text-xs font-semibold shadow-sm" title="Mode Jarvis Plein Écran (Double-Clap ou Espace)">
                    <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-400"></i>
                    <span class="font-semibold text-[11px] hidden xs:inline">Jarvis</span>
                    <span id="clap-badge-btn" class="hidden sm:inline text-[9px] px-1.5 py-0.5 rounded-full bg-white/10 text-neutral-300 font-mono"><i data-lucide="sparkles" class="w-2.5 h-2.5 inline mr-0.5"></i>Clap</span>
                </button>

                <button onclick="togglePhoneConnectModal()" class="hidden md:flex tactile-btn items-center space-x-1.5 px-3 py-1.5 rounded-2xl liquid-glass-subtle hover:bg-white/15 text-neutral-200 text-xs font-semibold shadow-sm" title="Ouvrir sur Téléphone (QR Code & Lien)">
                    <i data-lucide="smartphone" class="w-3.5 h-3.5 text-neutral-300"></i>
                    <span class="font-semibold hidden xs:inline">Version mobile</span>
                </button>

                <button onclick="toggleTheme()" class="tactile-btn p-2 rounded-2xl liquid-glass-subtle hover:bg-white/15 text-neutral-300 text-xs" title="Basculer Mode Clair / Sombre">
                    <span id="theme-icon-top"><i data-lucide="moon" class="w-4 h-4"></i></span>
                </button>

                <button onclick="openBackgroundModal()" class="hidden sm:flex tactile-btn items-center space-x-1.5 px-3 py-1.5 rounded-2xl liquid-glass-subtle hover:bg-white/15 text-neutral-200 text-xs" title="Missions 24/7">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span class="text-[11px] font-mono">Veilles 24/7</span>
                </button>

                <button onclick="openSettingsModal()" class="tactile-btn p-2 rounded-2xl liquid-glass-subtle hover:bg-white/15 text-neutral-300 text-xs flex items-center space-x-1" title="Paramètres & Styles">
                    <i data-lucide="settings" class="w-4 h-4"></i>
                    <span class="hidden md:inline text-xs font-medium">Réglages</span>
                </button>
            </div>
        </header>

        <!-- SOUS-BARRE DE NAVIGATION : LES 4 ESPACES META MUSE (FLUX, OBJECTIFS, IDÉES, ARTEFACTS) -->
        <div class="h-10 px-3 sm:px-4 liquid-glass border-b border-white/10 flex items-center justify-between text-xs overflow-x-auto z-10 flex-shrink-0">
            <div class="flex items-center space-x-1 p-0.5 rounded-xl bg-black/20 dark:bg-white/5 border border-white/10">
                <button onclick="switchMetaMuseSpace('feed')" id="space-feed-btn" class="space-tab-btn px-3 py-1 rounded-lg font-semibold text-xs bg-white text-black dark:bg-white dark:text-black flex items-center space-x-1.5 shadow-sm transition tactile-btn">
                    <i data-lucide="zap" class="w-3 h-3"></i><span>Flux</span>
                </button>
                <button onclick="switchMetaMuseSpace('goals')" id="space-goals-btn" class="space-tab-btn px-3 py-1 rounded-lg font-medium text-xs text-neutral-400 hover:text-white hover:bg-white/10 flex items-center space-x-1.5 transition tactile-btn">
                    <i data-lucide="target" class="w-3 h-3"></i><span>Objectifs</span>
                </button>
                <button onclick="switchMetaMuseSpace('ideas')" id="space-ideas-btn" class="space-tab-btn px-3 py-1 rounded-lg font-medium text-xs text-neutral-400 hover:text-white hover:bg-white/10 flex items-center space-x-1.5 transition tactile-btn">
                    <i data-lucide="lightbulb" class="w-3 h-3"></i><span>Idées</span>
                </button>
                <button onclick="switchMetaMuseSpace('artifacts')" id="space-artifacts-btn" class="space-tab-btn px-3 py-1 rounded-lg font-medium text-xs text-neutral-400 hover:text-white hover:bg-white/10 flex items-center space-x-1.5 transition tactile-btn">
                    <i data-lucide="package" class="w-3 h-3"></i><span>Artefacts</span>
                </button>
            </div>

        </div>

        <!-- HEADER 2 : STYLE PERPLEXITY -->
        <header id="header-perplexity" class="hidden h-14 px-4 items-center justify-between liquid-glass border-b border-white/10 z-20 flex-shrink-0">
            <div class="flex items-center space-x-2.5">
                <i data-lucide="sparkles" class="w-4 h-4 text-neutral-300"></i>
                <span class="text-neutral-900 dark:text-white font-bold text-sm">HoL AI Search & Deals</span>
                
            </div>
            <div class="flex items-center space-x-2">
                <button onclick="triggerJarvisMode()" class="tactile-btn px-3 py-1.5 rounded-xl liquid-glass-subtle text-neutral-200 text-xs font-mono font-semibold flex items-center space-x-1.5">
                    <i data-lucide="mic" class="w-3.5 h-3.5 text-amber-400"></i>
                    <span>Jarvis</span>
                </button>
                <button onclick="toggleTheme()" class="tactile-btn p-2 rounded-xl liquid-glass-subtle text-xs text-neutral-300">
                    <i data-lucide="moon" class="w-4 h-4"></i>
                </button>
                <button onclick="openSettingsModal()" class="tactile-btn px-3 py-1.5 rounded-xl liquid-glass-subtle text-neutral-300 text-xs font-mono">
                    <i data-lucide="settings" class="w-3.5 h-3.5 inline mr-1"></i><span>Réglages</span>
                </button>
            </div>
        </header>

        <!-- HEADER 3 : STYLE CHATGPT -->
        <header id="header-chatgpt" class="hidden h-14 px-4 items-center justify-between liquid-glass border-b border-white/10 z-20 flex-shrink-0">
            <div class="flex items-center space-x-2.5">
                <button onclick="toggleSidebar()" class="p-2 rounded-xl text-neutral-400 hover:text-white hover:bg-white/10 transition">
                    <i data-lucide="menu" class="w-4 h-4"></i>
                </button>
                <span class="font-bold text-sm text-neutral-900 dark:text-white">HoL AI Chat</span>
            </div>
            <div class="flex items-center space-x-2">
                <button onclick="triggerJarvisMode()" class="tactile-btn px-3 py-1.5 rounded-xl liquid-glass-subtle text-neutral-200 text-xs font-mono font-semibold flex items-center space-x-1.5">
                    <i data-lucide="mic" class="w-3.5 h-3.5 text-amber-400"></i>
                    <span>Jarvis</span>
                </button>
                <button onclick="toggleTheme()" class="tactile-btn p-2 rounded-xl liquid-glass-subtle text-xs text-neutral-300">
                    <i data-lucide="moon" class="w-4 h-4"></i>
                </button>
                <button onclick="openSettingsModal()" class="tactile-btn p-2 rounded-xl liquid-glass-subtle text-xs text-neutral-300">
                    <i data-lucide="settings" class="w-4 h-4"></i>
                </button>
            </div>
        </header>

        <!-- CONTENEUR DES MESSAGES -->
        <div id="chat-messages" class="flex-1 overflow-y-auto px-3 sm:px-6 pt-6 pb-44 space-y-5 max-w-3xl w-full mx-auto relative scroll-smooth ios-chat-scroll">
            
            <!-- Message de bienvenue -->
            <div class="flex items-start space-x-3 msg-animate">
                <div class="w-8 h-8 rounded-full apple-avatar flex-shrink-0 flex items-center justify-center text-xs font-bold text-white shadow-md">H</div>
                <div class="space-y-3 max-w-[90%] sm:max-w-[82%]">
                    <div class="bubble-assistant p-4 sm:p-5 rounded-2xl rounded-tl-sm text-sm text-neutral-800 dark:text-neutral-100 leading-relaxed shadow-sm">
                        <div class="font-semibold text-base mb-1.5 flex items-center space-x-2 text-neutral-900 dark:text-white">
                            <span>HoL AI</span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-white/10 text-neutral-400 font-mono">v2.0</span>
                        </div>
                        <p class="text-[13.5px] leading-relaxed text-neutral-700 dark:text-neutral-300">
                            Bonjour ! C'est <strong>HoL AI</strong>. Ton copilote personnel intelligent : dénicher les pépites et meilleures offres partout sur le web (neuf & occasion), suivre tes livraisons, planifier ta journée et exécuter tes tâches clés.
                        </p>
                        <div class="mt-3 pt-3 border-t border-white/10 text-xs text-neutral-500 dark:text-neutral-400 flex items-center space-x-1.5">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-neutral-400"></i>
                            <span>Dis-moi ce que tu recherches ou choisis une suggestion rapide :</span>
                        </div>
                    </div>

                    <!-- Suggestions de lancement rapide en 1 clic -->
                    <div class="flex flex-wrap gap-2 pt-1">
                        <button onclick="sendInteractiveAnswer('Fais-moi le briefing complet de ma journée')" class="tactile-btn px-3.5 py-2 rounded-2xl suggestion-chip text-xs font-medium transition cursor-pointer flex items-center space-x-2">
                            <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-400"></i>
                            <span>Briefing du jour</span>
                        </button>
                        <button onclick="sendInteractiveAnswer('trouve moi un iphone xr le moins cher sur tout internet')" class="tactile-btn px-3.5 py-2 rounded-2xl suggestion-chip text-xs font-medium transition cursor-pointer flex items-center space-x-2">
                            <i data-lucide="smartphone" class="w-3.5 h-3.5 text-neutral-300"></i>
                            <span>iPhone XR le moins cher</span>
                        </button>
                        <button onclick="sendInteractiveAnswer('trouve moi une crème visage hydratante')" class="tactile-btn px-3.5 py-2 rounded-2xl suggestion-chip text-xs font-medium transition cursor-pointer flex items-center space-x-2">
                            <i data-lucide="sparkles" class="w-3.5 h-3.5 text-neutral-300"></i>
                            <span>Cosmétiques & Soins</span>
                        </button>
                        <button onclick="sendInteractiveAnswer('où en sont mes colis et livraisons ?')" class="tactile-btn px-3.5 py-2 rounded-2xl suggestion-chip text-xs font-medium transition cursor-pointer flex items-center space-x-2">
                            <i data-lucide="package" class="w-3.5 h-3.5 text-neutral-300"></i>
                            <span>Suivi de mes colis</span>
                        </button>
                    </div>
                </div>
            </div>

        </div>

        <!-- ZONE DE SAISIE FLOTTANTE EN BAS (FLOATING LIQUID GLASS DOCK) -->
        <div class="fixed bottom-3 sm:bottom-5 inset-x-0 mx-auto max-w-3xl px-3 sm:px-4 z-30 pointer-events-none ios-dock-container">
            <div class="pointer-events-auto liquid-glass liquid-glass-dock rounded-[28px] sm:rounded-[32px] p-2 sm:p-2.5 shadow-2xl">
                <!-- Prévisualisation Pièce Jointe -->
                <div id="attachment-preview" class="hidden"></div>

                <!-- BARRE DU NIVEAU DE RÉFLEXION / REASONING MODE -->
                <div class="flex items-center justify-between mb-1.5 px-2 text-xs">
                    <div class="relative inline-block text-left">
                        <button type="button" onclick="toggleThinkingMenu(event)" id="thinking-mode-btn" class="tactile-btn flex items-center space-x-1.5 py-1 px-3 rounded-full bg-white/10 dark:bg-white/10 hover:bg-white/15 text-neutral-800 dark:text-neutral-200 border border-white/15 text-xs font-medium transition shadow-sm cursor-pointer" title="Changer le niveau de réflexion de l'IA">
                            <span id="thinking-mode-icon" class="flex items-center"><i data-lucide="brain" class="w-3.5 h-3.5 text-neutral-300"></i></span>
                            <span id="thinking-mode-label" class="font-medium text-[11.5px]">Mode Standard</span>
                            <svg class="w-3 h-3 text-neutral-400 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        
                        <!-- Menu popover déroulant pour choisir le niveau de réflexion -->
                        <div id="thinking-menu-dropdown" class="hidden absolute bottom-full mb-3 left-0 w-72 sm:w-80 liquid-glass rounded-2xl shadow-2xl p-2.5 z-50 space-y-1.5">
                            <div class="text-[10px] font-bold uppercase tracking-wider text-neutral-400 px-2.5 py-1 flex items-center justify-between">
                                <span>Niveau de réflexion</span>
                                
                            </div>
                            
                            <button type="button" onclick="selectThinkingLevel('fast')" class="thinking-opt-btn w-full text-left p-2.5 rounded-xl hover:bg-white/10 transition flex items-start space-x-2.5 cursor-pointer tactile-btn" data-level="fast">
                                <div class="p-1.5 rounded-lg bg-amber-500/15 text-amber-400 flex items-center justify-center flex-shrink-0"><i data-lucide="zap" class="w-4 h-4"></i></div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-bold text-xs text-neutral-900 dark:text-white flex items-center justify-between">
                                        <span>Flash (Rapide)</span>
                                        <span class="text-[9px] text-amber-400 font-mono font-normal">Ultra-Vitesse</span>
                                    </div>
                                    <div class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-snug">Réponses immédiates, concises et directes sans sur-réflexion.</div>
                                </div>
                            </button>

                            <button type="button" onclick="selectThinkingLevel('standard')" class="thinking-opt-btn w-full text-left p-2.5 rounded-xl hover:bg-white/10 transition flex items-start space-x-2.5 cursor-pointer tactile-btn" data-level="standard">
                                <div class="p-1.5 rounded-lg bg-white/10 text-neutral-300 flex items-center justify-center flex-shrink-0"><i data-lucide="brain" class="w-4 h-4"></i></div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-bold text-xs text-neutral-900 dark:text-white flex items-center justify-between">
                                        <span>Standard (Équilibré)</span>
                                        <span class="text-[9px] text-neutral-400 font-mono font-normal">Défaut</span>
                                    </div>
                                    <div class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-snug">Réflexion naturelle avec vérification factuelle et outils ciblés.</div>
                                </div>
                            </button>

                            <button type="button" onclick="selectThinkingLevel('deep')" class="thinking-opt-btn w-full text-left p-2.5 rounded-xl hover:bg-white/10 transition flex items-start space-x-2.5 cursor-pointer tactile-btn" data-level="deep">
                                <div class="p-1.5 rounded-lg bg-white/10 text-neutral-300 flex items-center justify-center flex-shrink-0"><i data-lucide="microscope" class="w-4 h-4"></i></div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-bold text-xs text-neutral-900 dark:text-white flex items-center justify-between">
                                        <span>Deep Thinking</span>
                                        <span class="text-[9px] text-neutral-300 font-mono font-normal">Raisonnement</span>
                                    </div>
                                    <div class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-snug">Raisonnement logique poussé, décomposition multi-étapes et auto-critique.</div>
                                </div>
                            </button>

                            <button type="button" onclick="selectThinkingLevel('ultra')" class="thinking-opt-btn w-full text-left p-2.5 rounded-xl hover:bg-white/10 transition flex items-start space-x-2.5 cursor-pointer tactile-btn" data-level="ultra">
                                <div class="p-1.5 rounded-lg bg-white/10 text-neutral-300 flex items-center justify-center flex-shrink-0"><i data-lucide="telescope" class="w-4 h-4"></i></div>
                                <div class="flex-1 min-w-0">
                                    <div class="font-bold text-xs text-neutral-900 dark:text-white flex items-center justify-between">
                                        <span>Ultra Research</span>
                                        <span class="text-[9px] text-neutral-300 font-mono font-normal">Multi-Sources</span>
                                    </div>
                                    <div class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-snug">Audit exhaustif, scan multi-sources web, lecture de pages et rapport complet.</div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <div id="thinking-badge-hint" class="text-[11px] text-neutral-400 font-medium hidden sm:flex items-center space-x-1">
                        <span>Mode actif :</span>
                        <span id="thinking-hint-text" class="text-neutral-200 font-semibold">Standard (Équilibré)</span>
                    </div>
                </div>

                <!-- Formulaire de saisie dynamique -->
                <form id="chat-form" onsubmit="handleChatSubmit(event)" class="relative flex items-center bg-black/10 dark:bg-white/5 rounded-[22px] sm:rounded-[26px] border border-white/10 focus-within:border-white/30 focus-within:bg-black/15 transition p-1">
                    
                    <!-- Bouton Trombone (Pièces Jointes) -->
                    <button type="button" onclick="triggerAttachmentUpload()" class="tactile-btn p-2 sm:p-2.5 text-neutral-400 hover:text-white transition rounded-full hover:bg-white/10 flex items-center justify-center" title="Joindre une photo, reçu ou document">
                        <i data-lucide="paperclip" class="w-4 h-4 sm:w-5 sm:h-5"></i>
                    </button>
                    <input type="file" id="chat-file-input" class="hidden" accept="image/*,.pdf,.txt" onchange="handleChatFileUpload(event)">

                    <!-- Bouton Caméra Directe -->
                    <button type="button" onclick="document.getElementById('camera-direct-input').click()" class="tactile-btn p-2 sm:p-2.5 text-neutral-400 hover:text-white transition rounded-full hover:bg-white/10 flex items-center justify-center" title="Prendre une photo caméra directe">
                        <i data-lucide="camera" class="w-4 h-4 sm:w-5 sm:h-5"></i>
                    </button>
                    <input type="file" id="camera-direct-input" class="hidden" accept="image/*" capture="environment" onchange="handleDirectCameraUpload(event)">

                    <!-- Champ Texte -->
                    <input 
                        type="text" 
                        id="user-input" 
                        placeholder="Poser une question, rechercher une offre..." 
                        autocomplete="off"
                        class="w-full bg-transparent py-2 sm:py-2.5 px-2 text-sm text-neutral-900 dark:text-white placeholder-neutral-400 dark:placeholder-neutral-500 focus:outline-none"
                    />

                    <!-- Bouton Micro Vocal -->
                    <button type="button" onclick="triggerVoiceInput()" id="mic-btn" class="tactile-btn p-2 sm:p-2.5 text-neutral-400 hover:text-white transition rounded-full hover:bg-white/10 flex items-center justify-center" title="Parler au micro (Web Speech)">
                        <i data-lucide="mic" class="w-4 h-4 sm:w-5 sm:h-5"></i>
                    </button>

                    <!-- Bouton Envoyer -->
                    <button type="submit" id="send-btn" class="tactile-btn p-2 sm:p-2.5 rounded-full bg-white dark:bg-white text-black hover:bg-neutral-200 shadow-md transition flex items-center justify-center flex-shrink-0" title="Envoyer">
                        <i data-lucide="arrow-up" class="w-4 h-4 sm:w-4.5 sm:h-4.5 stroke-[2.5]"></i>
                    </button>
                </form>


            </div>
        </div>

    </main>



    <!-- MODAL PARAMÈTRES (Sélection de Style, Thème, Clé API, Telegram) -->

    <div id="settings-modal" class="fixed inset-0 bg-black/75 z-50 hidden flex items-center justify-center p-4 backdrop-blur-sm">

        <div class="liquid-glass rounded-3xl ios-sheet-modal max-w-md w-full p-6 space-y-4 shadow-2xl text-slate-900 dark:text-white border border-white/15">
            <div class="w-10 h-1 bg-white/20 rounded-full mx-auto mb-2 sm:hidden"></div>

            

            <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-white/5">

                <div class="flex items-center space-x-2">

                    <i data-lucide="settings" class="w-4 h-4 text-neutral-200"></i>

                    <span class="font-bold text-sm">Paramètres du Chatbot</span>

                </div>

                <button onclick="closeSettingsModal()" class="tactile-btn p-1.5 rounded-xl text-neutral-400 hover:text-white hover:bg-white/10" title="Fermer"><i data-lucide="x" class="w-4 h-4"></i></button>

            </div>



            <!-- Sélecteur de Style d'Interface -->

            <div class="space-y-2">

                <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Style d'Interface :</label>

                <div class="grid grid-cols-3 gap-2 text-xs">

                    <button type="button" onclick="setChatStyle('messaging')" id="style-opt-messaging" class="p-2.5 rounded-xl border text-center font-semibold flex flex-col items-center justify-center gap-1 transition">
                        <i data-lucide="zap" class="w-5 h-5 text-amber-400"></i>

                        <span>Messagerie</span>

                        <span class="text-[9px] text-emerald-500 dark:text-emerald-400 font-mono">(Défaut)</span>

                    </button>

                    <button type="button" onclick="setChatStyle('perplexity')" id="style-opt-perplexity" class="p-2.5 rounded-xl border text-center font-semibold flex flex-col items-center justify-center gap-1 transition">
                        <i data-lucide="globe" class="w-5 h-5 text-neutral-200"></i>

                        <span>Perplexity</span>

                        <span class="text-[9px] text-slate-400 font-mono">Recherche</span>

                    </button>

                    <button type="button" onclick="setChatStyle('chatgpt')" id="style-opt-chatgpt" class="p-2.5 rounded-xl border text-center font-semibold flex flex-col items-center justify-center gap-1 transition">
                        <i data-lucide="message-square" class="w-5 h-5 text-neutral-200"></i>

                        <span>ChatGPT</span>

                        <span class="text-[9px] text-slate-400 font-mono">Sidebar</span>

                    </button>

                </div>

            </div>



            <!-- Sélecteur de Thème Visuel -->

            <div class="space-y-2 pt-2 border-t border-slate-200 dark:border-white/5">

                <label class="text-xs font-bold text-slate-700 dark:text-slate-300">Ambiance Visuelle :</label>

                <div class="grid grid-cols-2 gap-2 text-xs">

                    <button type="button" onclick="setTheme('dark')" id="theme-btn-dark" class="p-2 rounded-xl border text-center font-semibold flex items-center justify-center gap-2">

                        <i data-lucide="moon" class="w-4 h-4 inline mr-1"></i><span>Mode Sombre</span>

                    </button>

                    <button type="button" onclick="setTheme('light')" id="theme-btn-light" class="p-2 rounded-xl border text-center font-semibold flex items-center justify-center gap-2">

                        <i data-lucide="sun" class="w-4 h-4 inline mr-1"></i><span>Mode Clair</span>

                    </button>

                </div>

            </div>



            <!-- Configuration Clé API Gemini -->

            <div class="space-y-1.5 pt-2 border-t border-slate-200 dark:border-white/5">

                <label class="text-xs font-bold text-slate-700 dark:text-slate-300 flex items-center justify-between">

                    <span>Clé API Gemini :</span>

                    <span class="text-[10px] text-emerald-500 dark:text-emerald-400 font-mono">Connectée 200 OK</span>

                </label>

                <input 

                    id="api-key-input" 

                    type="password" 

                    placeholder="AQ.Ab8RN6J0nOhI5t..." 

                    class="w-full bg-slate-100 dark:bg-[#08080a] border border-slate-300 dark:border-white/10 rounded-xl px-3 py-2 text-xs focus:outline-none focus:border-white/40 font-mono"

                />

            </div>



            <div class="flex items-center space-x-2 pt-2">

                <button onclick="saveAllSettings()" class="tactile-btn flex-1 py-2.5 rounded-xl bg-white text-black hover:bg-neutral-200 font-bold text-xs shadow-md transition rounded-xl">

                    <i data-lucide="check" class="w-4 h-4 inline mr-1"></i>Enregistrer les Réglages

                </button>

                <button onclick="closeSettingsModal()" class="tactile-btn px-4 py-2.5 rounded-xl bg-slate-200 dark:bg-[#18181e] text-slate-600 dark:text-slate-400 text-xs">

                    Fermer

                </button>

            </div>

        </div>

    </div>



    <!-- MODAL MISSIONS 24/7 -->

    <div id="background-modal" class="fixed inset-0 bg-black/75 z-50 hidden flex items-center justify-center p-4 backdrop-blur-sm">

        <div class="liquid-glass rounded-3xl ios-sheet-modal max-w-md w-full p-6 space-y-4 shadow-2xl text-slate-900 dark:text-white border border-white/15">
            <div class="w-10 h-1 bg-white/20 rounded-full mx-auto mb-2 sm:hidden"></div>

            <div class="flex items-center justify-between pb-2 border-b border-slate-200 dark:border-white/5">


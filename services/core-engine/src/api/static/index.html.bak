                <div class="flex items-start space-x-3 msg-animate">

                    <div class="w-8 h-8 rounded-full bg-gradient-to-tr bg-neutral-800 flex-shrink-0 flex items-center justify-center text-xs font-bold text-white shadow-md">H</div>

                    <div class="bubble-assistant p-4 rounded-2xl bg-white dark:bg-[#121216] border border-slate-200 dark:border-white/5 text-sm text-slate-800 dark:text-slate-200 leading-relaxed shadow-sm">

                        Nouvelle discussion démarrée avec HoL AI ! Comment puis-je t'aider ?

                    </div>

                </div>

            `;


# ==========================================
# HoL AI - Configuration Environnementale
# ==========================================

# Application
APP_ENV=development
APP_NAME="HoL AI Core Engine"
DEBUG=true
LOG_LEVEL=INFO

# Redis / Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
USE_FAKEREDIS=true # Bascule automatique en mémoire si serveur Redis local indisponible

# Base de Données PostgreSQL + pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hol_ai_db
POSTGRES_USER=hol_ai_admin
POSTGRES_PASSWORD=change_this_in_production

# Moteur LLM & API Keys
GEMINI_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash

# Telegram Bot (Agent 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Limites & Budgets
DEFAULT_TOKEN_BUDGET=4096
DEFAULT_TIMEOUT_MS=15000
